// Loft v1.0 Context-Free Grammar (Lark / llguidance compatible)
start: _sep? (top_item (_sep top_item)* _sep?)?

top_item: use_decl
        | "pub"? ( space_decl | struct_decl | type_alias | const_decl | input_decl | param_decl
                 | kernel_decl | bake_tex_decl | camera_decl | target_decl | fn_decl | lobe_decl
                 | scan_decl | kind_decl | body_decl | state_decl
                 | law_decl | solver_decl | plan_decl | check_decl
                 | retarget_decl | world_decl | build_fn | build_blk | sched_decl )

use_decl: "use" mod_path ("::" ("*" | "{" import_names "}") | "as" LIDENT)?
import_names: IDENT ("," IDENT)* ","?
qualified: LIDENT "::" IDENT
name_ref: IDENT | qualified
kind_ref: UIDENT | qualified
mod_path: LIDENT ("::" LIDENT)*

space_decl:  "space" UIDENT+
struct_decl: "struct" UIDENT "{" (_NL? col (("," | _sep) col)* ("," | _sep)?)? "}"
type_alias:  "type" UIDENT "=" type_expr
const_decl:  "const" IDENT (":" type_expr)? "=" expr
input_decl:  "input" LIDENT ":" type_expr ("=" expr)?
param_decl:  "param" LIDENT ":" type_expr "=" expr ("in" expr ".." expr)?
kernel_decl: "kernel" LIDENT "(" params? ")" "nondet"? ("allow" "(" capability ("," capability)* ","? ")")? block
capability: "atomics" | "workgroup" | "subgroups" | "dynamic_loops"
bake_tex_decl: "bake_tex" UIDENT bake_tex_dim LIDENT "on" bake_tex_clock "mips" "(" ("true" | "false") ")" "(" LIDENT ":" type_expr ")" block
bake_tex_dim: GRID_DIM | TEX_DIM_3D | "cube" GRID_DIM
bake_tex_clock: "load" | "dirty" "(" ident_list ")"
TEX_DIM_3D: /[0-9]+x[0-9]+x[0-9]+/
camera_decl: "camera" UIDENT "{" field_inits "}"
target_decl: "target" UIDENT ":" LIDENT (INT "x" INT | "view" ("*" NUMBER)?)? ("msaa" INT)?

fn_decl:     "fn" LIDENT gen_params? "(" params? ")" ("->" type_expr)? fn_body
lobe_decl:   "lobe" LIDENT "(" params? ")" fn_body
fn_body:     "=" (expr | block) | block

scan_decl:   "scan" LIDENT LIDENT "in" expr ".." expr "by" INT "on" LIDENT "{" _NL? "init" "=" expr _sep "step" LIDENT "=" expr _sep? "}"

kind_decl:   "kind" UIDENT var_params? "@" kind_ref "(" col_list? ")" "{" (_NL? kind_item (_sep kind_item)* _sep?)? "}"
var_params:  "[" param ("," param)* ","? "]"
col_list:    col ("," col)* ","?
col:         LIDENT ":" type_expr range_ref? ("=" expr)?
range_ref:   "in" expr ".." expr | (">" | ">=") expr
kind_item:   map_decl | query_decl | fn_decl
map_decl:    "map" LIDENT "(" LIDENT ")" "=" expr
query_decl:  QUERY_NAME "(" params? ")" fn_body
           | "surface" "(" params? ")" "grid" GRID_DIM fn_body

body_decl:   "body" UIDENT "{" (_NL? body_item (_sep body_item)* _sep?)? "}"
body_item:   waive_stmt
           | "trunk" body_fields
           | "chain" LIDENT ("[" expr "]")? ":" LIDENT body_fields
           | "segment" LIDENT body_fields
           | "build" "for" body_bind ("," body_bind)* "{" _NL? body_loop_item (_sep body_loop_item)* _sep? "}"
body_loop_item: body_item | "let" LIDENT "=" expr
body_bind: LIDENT "in" expr ".." expr
body_fields: "{" (_NL? body_field (("," _NL? | _sep) body_field)* ("," _NL? | _sep)?)? "}"
body_field: LIDENT ":" (expr (".." expr)? | body_fields)

state_decl:  "state" UIDENT ("checkpoint" INT)? ("home" LIDENT)? "{" (_NL? col (("," | _sep) col)* ("," | _sep)?)? "}"

law_decl:    "law" LIDENT "(" params ")" "nondet"? "writes" write_set block
write_set:   LIDENT ("." "{" ident_list "}")?

solver_decl: "solver" UIDENT "over" path_ref (_NL? "writes" (LIDENT | UIDENT) ("." "{" ident_list "}")?)? _NL? "config" "{" field_inits "}" _NL? solver_block
solver_block: "{" (_NL? solver_step (_sep solver_step)* _sep?)? "}"
solver_step: stmt | "constrain" LIDENT "(" LIDENT "," LIDENT ")" "in" expr ".." expr block
path_ref:    IDENT ("." LIDENT)*

plan_decl:   "plan" UIDENT "(" params? ")" "->" type_expr "{" _NL? ("knots" ":" INT "," "duration" ":" expr _sep)? "minimize" expr _sep "subject_to" "{" (_NL? expr (_sep expr)* _sep?)? "}" _sep? "}"
check_decl:  "check" LIDENT "(" params ")" "->" type_expr block
retarget_decl: "retarget" UIDENT "from" UIDENT "to" UIDENT "{" field_inits "}"

world_decl:  "world" UIDENT "{" field_inits "}"
build_fn:    "build" "fn" LIDENT "(" params? ")" ("->" type_expr)? fn_body
build_blk:   "build" block
sched_decl:  "schedule" IDENT ("(" sched_callbacks? ")")? "{" (_NL? sched_stmt (_sep sched_stmt)* _sep?)? "}"
sched_callbacks: sched_callback ("," sched_callback)* ","?
sched_callback: LIDENT ":" "fn" "(" (type_expr ("," type_expr)* ","?)? ")" "->" type_expr
sched_stmt:  "pass" LIDENT ("reads" "[" resource_list "]")? ("writes" "[" resource_list "]")? block
           | "type" "Radiance" "=" type_expr
           | waive_stmt
           | expr block?
waive_stmt: "waive" UIDENT STRING
resource_list: IDENT ("," IDENT)* ","?

// --- Types (only after ':' or '->') ---
type_expr:   unit_expr
           | PRIM_TY ("@" name_ref)?
           | "xf" "@" name_ref ">" name_ref
           | ("attach" | "target" | "frame") "@" name_ref
           | "[" kind_ref "]"
           | "array" "[" type_expr "," INT "]"
           | kind_ref

gen_params:  "[" UIDENT ("," UIDENT)* ","? "]"
params:      param ("," param)* ","?
param:       LIDENT (":" type_expr)? ("=" expr)?
ident_list:  LIDENT ("," LIDENT)* ","?
field_inits: (_NL? field_init (("," | _sep) field_init)* ("," | _sep)?)?
field_init:  LIDENT ":" expr

// --- Statements & Blocks ---
block:       "{" (_NL? stmt (_sep stmt)* _sep?)? "}"
stmt:        "let" LIDENT (":" type_expr)? "=" expr
           | "var" LIDENT (":" type_expr)? "=" expr
           | "map" LIDENT "=" expr
           | build_for_stmt
           | "for" LIDENT "in" expr ".." expr block
           | "yield" expr
           | "return" expr
           | lhs "=" expr
           | expr

build_for_stmt: "build" "for" for_bind ("," for_bind)* block
for_bind:    LIDENT "in" (expr ".." expr | "[" expr_list "]")
lhs:         LIDENT ("." LIDENT | "[" expr "]")*

// --- Expressions (Pratt precedence encoded cleanly) ---
expr:        pipe_expr
pipe_expr:   or_expr ("|>" pipe_rhs)*
pipe_rhs:    LIDENT ("(" call_args? ")")?
or_expr:     and_expr ("||" and_expr)*
and_expr:    cmp_expr ("&&" cmp_expr)*
cmp_expr:    add_expr (("==" | "!=" | "<" | "<=" | ">" | ">=") add_expr)?
add_expr:    mul_expr (("+" | "-") mul_expr)*
mul_expr:    unary_expr (("*" | "/" | "%") unary_expr)*
unary_expr:  ("-" | "!") unary_expr | postfix_expr

postfix_expr: primary ( "." LIDENT | "(" call_args? ")" | "[" expr "]" | "'" )*

primary:     unit_number | NUMBER | STRING | "true" | "false" | name_ref
           | "(" expr ")"
           | "[" expr_list? "]" ("@" name_ref)?
           | "if" expr block ("else" "if" expr block)* ("else" block)?
           | "emit" kind_ref ("[" expr_list "]")? "(" named_args? ")"
           | "unproved" "(" ("step_scale" ":")? expr ")" block
           | "wgsl" "det"? "(" params? ")" "->" type_expr RAW_WGSL_BLOCK

// mix_bsdf(a, b, t) uses ordinary call syntax; its arguments are checked as Bsdf, Bsdf, f.
call_args:   arg ("," arg)* ","?
arg:         (LIDENT ":")? expr
named_args:  field_init ("," field_init)* ","?
expr_list:   expr ("," expr)* ","?

// --- Terminals ---
// An authored lipschitz query parses so the checker can diagnose it as E210.
QUERY_NAME:  "lipschitz" | "trace" | "visible" | "material" | "light" | "sky" | "medium" | "hit" | "bound" | "sigma" | "tau"
PRIM_TY:     "p3" | "v3" | "d3" | "n3" | "v2" | "v4" | "rgb" | "quat" | "f" | "u" | "i" | "bool" | "f32" | "u32" | "i32" | "vec2f" | "vec3f" | "vec4f"
GRID_DIM:    /[0-9]+x[0-9]+/
unit_expr: unit_atom (("*" | "/") unit_atom)*
unit_atom: (UNIT_SYM | "1") ("^" "-"? INT)?
UNIT_SYM: "mm" | "m" | "rad" | "deg" | "s" | "kg" | "N" | "J" | "Hz"
unit_number: NUM_UNIT ("^" "-"? INT)? (("*" | "/") unit_atom)*
NUM_UNIT: /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?(mm|m|rad|deg|s|kg|N|J|Hz)/
NUMBER:      /0x[0-9a-fA-F]+|[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
UIDENT:      /[A-Z][a-zA-Z0-9_]*/
LIDENT:      /[a-z_][a-zA-Z0-9_]*/
IDENT:       UIDENT | LIDENT
RAW_WGSL_BLOCK: /\{[^{}]*(\{[^{}]*\}[^{}]*)*\}/

_NL:         /(\r?\n)+/
_sep:        (_NL | ";")+
COMMENT:     /#[^\n]*/
%ignore /[ \t]+/
%ignore COMMENT


%import common.INT
%import common.ESCAPED_STRING -> STRING
