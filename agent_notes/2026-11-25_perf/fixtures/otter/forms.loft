  let ear_l0 = el(d, [-0.03670 + (0.0) * 0.79696 - (er * 0.010) * 0.06976, 0.01044 + (0.0) * 0.11336 + (er * 0.010) * 1.29506, -0.06600 + (0.0) * 1.00000], [0.01536, 0.02184, 0.01200])
  let ear_l = smax(ear_l0, 0.0 - el(d, [-0.03484 + (0.0) * 0.79696 - (er * 0.010) * 0.06976, 0.03550 + (0.0) * 0.11336 + (er * 0.010) * 1.29506, -0.06800 + (0.0) * 1.00000], [0.00680, 0.01105, 0.00850]), 0.00240)
  let skull_all = smin(smin(smin(cranium, cheek, 0.02400), muzzle, 0.00960), pad, 0.01280)
