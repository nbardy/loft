  let lids = smin(lid_r, lid_l, 0.00800)
  let corners = smin(corner_r, corner_l, 0.00800)
  let low = smin(smin(jaw, mouth, 0.00960), corners, 0.00640)
  smin(smin(smin(smin(nosed, brows, 0.00800), smin(lids, low, 0.00640), 0.00480), ear_r, 0.00640), ear_l, 0.00640)
}

# Head form 0: flat and sly: the base skull stretched taller and shorter, muzzle shortened.
pub kind Head0 @World (c: p3@World, nod: f in -0.8..0.8, turn: f in -0.8..0.8, tilt: f in -0.8..0.8, bl: f in -1.1..1.1, br: f in -1.1..1.1, tl: f in -1.1..1.1, tr: f in -1.1..1.1, ll: f in -0.05..1.1, lr: f in -0.05..1.1, kl: f in -1.1..1.1, kr: f in -1.1..1.1, jw: f in -0.05..1.1, pf: f in -0.05..1.1, er: f in -1.1..1.1, mode: f in -1.0..6.0) {
  trace(p) = skull_0(head_frame((p - c).xyz, nod, turn, tilt), bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  material(p, n) = head_surface(mode, head_frame((p - c).xyz, nod, turn, tilt) / [0.80000, 1.30000, 1.00000], (p - c).xyz, hturn([1.0, 0.0, 0.0], nod, turn, tilt), kl, kr, jw, 0.78)
}

fn head_cell_0(c: p3@World, k: u, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> frame@World {
  let th = 3.14159265 * (f32(k % 32u) + 0.5) / 32.0
  let ph = (f32(k / 32u) + 0.5) * 0.19634954
  let dir = [cos(th), sin(th) * cos(ph), sin(th) * sin(ph)]
  var lo = 0.0
  var hi = 0.22
  for j in 0..10 {
    let r = (lo + hi) * 0.5
    if skull_0(dir * r, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) > 0.0 { hi = r } else { lo = r }
  }
  let zero = [0, 0, 0]@World
  let d0 = dir * lo
  if lo < 0.0005 || d0.x > 0.09616 {
    return frame_axes(c, zero - zero, zero - zero, zero - zero)
  }
  let h = 0.0002
  let f0 = skull_0(d0, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  let g = normalize([skull_0(d0 + [h, 0.0, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_0(d0 + [0.0, h, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_0(d0 + [0.0, 0.0, h], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0] + rgb(1e-12))
  let eth = [0.0 - sin(th), cos(th) * cos(ph), cos(th) * sin(ph)]
  let eph = [0.0, 0.0 - sin(ph), cos(ph)]
  let den = max(dot(g, dir), 0.10)
  let tx = (eth - dir * (dot(g, eth) / den)) * (lo * 0.09817477)
  let tv = (eph - dir * (dot(g, eph) / den)) * (lo * sin(th) * 0.19634954)
  let rb = hturn(d0, nod, turn, tilt)
  let gb = hturn(g, nod, turn, tilt)
  let xb = hturn(tx, nod, turn, tilt)
  let vb = hturn(tv, nod, turn, tilt)
  return frame_axes(c + [rb.x, rb.y, rb.z], [xb.x, xb.y, xb.z]@World - zero, [gb.x, gb.y, gb.z]@World - zero, [vb.x, vb.y, vb.z]@World - zero)
}

# Dry soft strands over the whole head, combed back from the nose.
pub build fn head_fur0(c: p3@World, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f, density: f, wet: f) {
  let flow = hturn([-1.0, -0.2, 0.0], nod, turn, tilt)
  build for k in 0..1024 {
    let cell = head_cell_0(c, k, nod, turn, tilt, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
    let off = (cell.origin - c).xyz
    let local = head_frame(off, nod, turn, tilt)
    groom(cell, flow, density, wet, head_dye(local / [0.80000, 1.30000, 1.00000], off, flow, 0.78))
  }
}

fn skull_1(d: rgb, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> f {
  let qa = [d.x, d.y, abs(d.z)]
  let cranium = el(d, [0.00026 + (0) * 0.71726 - (0) * 0.06278, -0.00654 + (0) * 0.13952 + (0) * 1.59392, 0.00000 + (0) * 1.00000], [0.05688, 0.06608, 0.08930])
  let cheek = el(qa, [0.01050 + (0.004 * pf) * 0.71726 - (0.0) * 0.06278, -0.02446 + (0.004 * pf) * 0.13952 + (0.0) * 1.59392, 0.05100 + (0.009 * pf) * 1.00000], [0.04550, 0.06010, 0.05304])
  let muzzle = rbox(d, [0.06957, -0.01377, 0.00000], [0.02016, 0.04160, 0.04800], 0.01030)
  let pad = el(qa, [0.07579 + (0) * 0.71726 - (0) * 0.06278, -0.01754 + (0) * 0.13952 + (0) * 1.59392, 0.03740 + (0) * 1.00000], [0.01814, 0.03248, 0.02640])
  let lobe = el(qa, [0.08797 + (0) * 0.71726 - (0) * 0.06278, 0.00715 + (0) * 0.13952 + (0) * 1.59392, 0.01100 + (0) * 1.00000], [0.00403, 0.01600, 0.01300])
  let tip = el(d, [0.08765 + (0) * 0.71726 - (0) * 0.06278, -0.01058 + (0) * 0.13952 + (0) * 1.59392, 0.00000 + (0) * 1.00000], [0.00353, 0.01280, 0.00900])
  let nostril = el(qa, [0.09211 + (0) * 0.71726 - (0) * 0.06278, 0.00475 + (0) * 0.13952 + (0) * 1.59392, 0.01200 + (0) * 1.00000], [0.00227, 0.00512, 0.00420])
  let brow_ri = el(d, [0.05210 + (0.0) * 0.71726 - (br * 0.013 + tr * 0.010) * 0.06278, 0.03503 + (0.0) * 0.13952 + (br * 0.013 + tr * 0.010) * 1.59392, 0.03200 + (0.0) * 1.00000], [0.01008, 0.00952, 0.01120])
  let brow_ro = el(d, [0.04924 + (0.0) * 0.71726 - (br * 0.013 - tr * 0.010) * 0.06278, 0.03447 + (0.0) * 0.13952 + (br * 0.013 - tr * 0.010) * 1.59392, 0.05800 + (0.0) * 1.00000], [0.01008, 0.00952, 0.01120])
  let brow_li = el(d, [0.05210 + (0.0) * 0.71726 - (bl * 0.013 + tl * 0.010) * 0.06278, 0.03503 + (0.0) * 0.13952 + (bl * 0.013 + tl * 0.010) * 1.59392, -0.03200 + (0.0) * 1.00000], [0.01008, 0.00952, 0.01120])
  let brow_lo = el(d, [0.04924 + (0.0) * 0.71726 - (bl * 0.013 - tl * 0.010) * 0.06278, 0.03447 + (0.0) * 0.13952 + (bl * 0.013 - tl * 0.010) * 1.59392, -0.05800 + (0.0) * 1.00000], [0.01008, 0.00952, 0.01120])
  let lid_r = el(d, [0.05986 + (0.0) * 0.71726 - (0.0 - lr * 0.0165) * 0.06278, 0.03991 + (0.0) * 0.13952 + (0.0 - lr * 0.0165) * 1.59392, 0.04690 + (0.0) * 1.00000], [0.00850, 0.01152, 0.01120])
  let lid_l = el(d, [0.05986 + (0.0) * 0.71726 - (0.0 - ll * 0.0165) * 0.06278, 0.03991 + (0.0) * 0.13952 + (0.0 - ll * 0.0165) * 1.59392, -0.04690 + (0.0) * 1.00000], [0.00850, 0.01152, 0.01120])
  let corner_r = el(d, [0.06197 + (0.0) * 0.71726 - (kr * 0.014) * 0.06278, -0.01364 + (0.0) * 0.13952 + (kr * 0.014) * 1.59392, 0.04600 + (0.0) * 1.00000], [0.00655, 0.01600, 0.01000])
  let corner_l = el(d, [0.06197 + (0.0) * 0.71726 - (kl * 0.014) * 0.06278, -0.01364 + (0.0) * 0.13952 + (kl * 0.014) * 1.59392, -0.04600 + (0.0) * 1.00000], [0.00655, 0.01600, 0.01000])
  let jaw = el(d, [0.06075 + (0.0) * 0.71726 - (0.0 - jw * 0.034) * 0.06278, -0.04681 + (0.0) * 0.13952 + (0.0 - jw * 0.034) * 1.59392, 0.00000 + (0.0) * 1.00000], [0.01714, 0.02240, 0.03400])
  let mouth = el(d, [0.06210 + (0.0) * 0.71726 - (0.0 - jw * 0.017) * 0.06278, -0.04253 + (0.0) * 0.13952 + (0.0 - jw * 0.017) * 1.59392, 0.00000 + (0.0) * 1.00000], [0.01613, 0.01600, 0.03000])
  let ear_r = el(d, [-0.03303 + (0.0) * 0.71726 - (er * 0.010) * 0.06278, 0.01285 + (0.0) * 0.13952 + (er * 0.010) * 1.59392, 0.06600 + (0.0) * 1.00000], [0.01382, 0.02688, 0.01200])
  let ear_l0 = el(d, [-0.03303 + (0.0) * 0.71726 - (er * 0.010) * 0.06278, 0.01285 + (0.0) * 0.13952 + (er * 0.010) * 1.59392, -0.06600 + (0.0) * 1.00000], [0.01382, 0.02688, 0.01200])
  let ear_l = smax(ear_l0, 0.0 - el(d, [-0.03135 + (0.0) * 0.71726 - (er * 0.010) * 0.06278, 0.04369 + (0.0) * 0.13952 + (er * 0.010) * 1.59392, -0.06800 + (0.0) * 1.00000], [0.00612, 0.01360, 0.00850]), 0.00216)
  let skull_all = smin(smin(smin(cranium, cheek, 0.02160), muzzle, 0.00864), pad, 0.01152)
  let head = smax(skull_all, d.y * 0.9988 - d.x * 0.12733 - 0.05760, 0.01440)
  let nosed = smax(smin(smin(head, lobe, 0.00288), tip, 0.00432), 0.0 - nostril, 0.00144)
  let brows = smin(smin(brow_ri, brow_ro, 0.00576), smin(brow_li, brow_lo, 0.00576), 0.00576)
  let lids = smin(lid_r, lid_l, 0.00720)
  let corners = smin(corner_r, corner_l, 0.00720)
  let low = smin(smin(jaw, mouth, 0.00864), corners, 0.00576)
  smin(smin(smin(smin(nosed, brows, 0.00720), smin(lids, low, 0.00576), 0.00432), ear_r, 0.00576), ear_l, 0.00576)
}

# Head form 1: round and soft: a taller, shorter skull with big cheeks and small brows.
pub kind Head1 @World (c: p3@World, nod: f in -0.8..0.8, turn: f in -0.8..0.8, tilt: f in -0.8..0.8, bl: f in -1.1..1.1, br: f in -1.1..1.1, tl: f in -1.1..1.1, tr: f in -1.1..1.1, ll: f in -0.05..1.1, lr: f in -0.05..1.1, kl: f in -1.1..1.1, kr: f in -1.1..1.1, jw: f in -0.05..1.1, pf: f in -0.05..1.1, er: f in -1.1..1.1, mode: f in -1.0..6.0) {
  trace(p) = skull_1(head_frame((p - c).xyz, nod, turn, tilt), bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  material(p, n) = head_surface(mode, head_frame((p - c).xyz, nod, turn, tilt) / [0.72000, 1.60000, 1.00000], (p - c).xyz, hturn([1.0, 0.0, 0.0], nod, turn, tilt), kl, kr, jw, 0.7)
}

fn head_cell_1(c: p3@World, k: u, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> frame@World {
  let th = 3.14159265 * (f32(k % 32u) + 0.5) / 32.0
  let ph = (f32(k / 32u) + 0.5) * 0.19634954
  let dir = [cos(th), sin(th) * cos(ph), sin(th) * sin(ph)]
  var lo = 0.0
  var hi = 0.22
  for j in 0..10 {
    let r = (lo + hi) * 0.5
    if skull_1(dir * r, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) > 0.0 { hi = r } else { lo = r }
  }
  let zero = [0, 0, 0]@World
  let d0 = dir * lo
  if lo < 0.0005 || d0.x > 0.08136 {
    return frame_axes(c, zero - zero, zero - zero, zero - zero)
  }
  let h = 0.0002
  let f0 = skull_1(d0, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  let g = normalize([skull_1(d0 + [h, 0.0, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_1(d0 + [0.0, h, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_1(d0 + [0.0, 0.0, h], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0] + rgb(1e-12))
  let eth = [0.0 - sin(th), cos(th) * cos(ph), cos(th) * sin(ph)]
  let eph = [0.0, 0.0 - sin(ph), cos(ph)]
  let den = max(dot(g, dir), 0.10)
  let tx = (eth - dir * (dot(g, eth) / den)) * (lo * 0.09817477)
  let tv = (eph - dir * (dot(g, eph) / den)) * (lo * sin(th) * 0.19634954)
  let rb = hturn(d0, nod, turn, tilt)
  let gb = hturn(g, nod, turn, tilt)
  let xb = hturn(tx, nod, turn, tilt)
  let vb = hturn(tv, nod, turn, tilt)
  return frame_axes(c + [rb.x, rb.y, rb.z], [xb.x, xb.y, xb.z]@World - zero, [gb.x, gb.y, gb.z]@World - zero, [vb.x, vb.y, vb.z]@World - zero)
}

# Dry soft strands over the whole head, combed back from the nose.
pub build fn head_fur1(c: p3@World, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f, density: f, wet: f) {
  let flow = hturn([-1.0, -0.2, 0.0], nod, turn, tilt)
  build for k in 0..1024 {
    let cell = head_cell_1(c, k, nod, turn, tilt, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
    let off = (cell.origin - c).xyz
    let local = head_frame(off, nod, turn, tilt)
    groom(cell, flow, density, wet, head_dye(local / [0.72000, 1.60000, 1.00000], off, flow, 0.7))
  }
}

fn skull_2(d: rgb, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> f {
  let qa = [d.x, d.y, abs(d.z)]
  let cranium = el(d, [0.00032 + (0) * 0.89658 - (0) * 0.07848, -0.00449 + (0) * 0.09592 + (0) * 1.09582, 0.00000 + (0) * 1.00000], [0.07110, 0.04543, 0.08930])
  let cheek = el(qa, [0.01313 + (0.004 * pf) * 0.89658 - (0.0) * 0.07848, -0.01681 + (0.004 * pf) * 0.09592 + (0.0) * 1.09582, 0.05100 + (0.009 * pf) * 1.00000], [0.05688, 0.04476, 0.05746])
  let muzzle = rbox(d, [0.09570, -0.00853, 0.00000], [0.03060, 0.02860, 0.04800], 0.01287)
  let pad = el(qa, [0.10509 + (0) * 0.89658 - (0) * 0.07848, -0.01095 + (0) * 0.09592 + (0) * 1.09582, 0.03740 + (0) * 1.00000], [0.02754, 0.02233, 0.02640])
  let lobe = el(qa, [0.12381 + (0) * 0.89658 - (0) * 0.07848, 0.00640 + (0) * 0.09592 + (0) * 1.09582, 0.01100 + (0) * 1.00000], [0.00612, 0.01100, 0.01300])
  let tip = el(d, [0.12315 + (0) * 0.89658 - (0) * 0.07848, -0.00582 + (0) * 0.09592 + (0) * 1.09582, 0.00000 + (0) * 1.00000], [0.00535, 0.00880, 0.00900])
  let nostril = el(qa, [0.13006 + (0) * 0.89658 - (0) * 0.07848, 0.00486 + (0) * 0.09592 + (0) * 1.09582, 0.01200 + (0) * 1.00000], [0.00344, 0.00352, 0.00420])
  let brow_ri = el(d, [0.06513 + (0.0) * 0.89658 - (br * 0.013 + tr * 0.010) * 0.07848, 0.02408 + (0.0) * 0.09592 + (br * 0.013 + tr * 0.010) * 1.09582, 0.03200 + (0.0) * 1.00000], [0.03060, 0.01590, 0.02720])
  let brow_ro = el(d, [0.06154 + (0.0) * 0.89658 - (br * 0.013 - tr * 0.010) * 0.07848, 0.02370 + (0.0) * 0.09592 + (br * 0.013 - tr * 0.010) * 1.09582, 0.05800 + (0.0) * 1.00000], [0.03060, 0.01590, 0.02720])
  let brow_li = el(d, [0.06513 + (0.0) * 0.89658 - (bl * 0.013 + tl * 0.010) * 0.07848, 0.02408 + (0.0) * 0.09592 + (bl * 0.013 + tl * 0.010) * 1.09582, -0.03200 + (0.0) * 1.00000], [0.03060, 0.01590, 0.02720])
  let brow_lo = el(d, [0.06154 + (0.0) * 0.89658 - (bl * 0.013 - tl * 0.010) * 0.07848, 0.02370 + (0.0) * 0.09592 + (bl * 0.013 - tl * 0.010) * 1.09582, -0.05800 + (0.0) * 1.00000], [0.03060, 0.01590, 0.02720])
  let lid_r = el(d, [0.07483 + (0.0) * 0.89658 - (0.0 - lr * 0.0165) * 0.07848, 0.02744 + (0.0) * 0.09592 + (0.0 - lr * 0.0165) * 1.09582, 0.04690 + (0.0) * 1.00000], [0.01062, 0.00792, 0.01120])
  let lid_l = el(d, [0.07483 + (0.0) * 0.89658 - (0.0 - ll * 0.0165) * 0.07848, 0.02744 + (0.0) * 0.09592 + (0.0 - ll * 0.0165) * 1.09582, -0.04690 + (0.0) * 1.00000], [0.01062, 0.00792, 0.01120])
  let corner_r = el(d, [0.08419 + (0.0) * 0.89658 - (kr * 0.014) * 0.07848, -0.00866 + (0.0) * 0.09592 + (kr * 0.014) * 1.09582, 0.04600 + (0.0) * 1.00000], [0.00994, 0.01100, 0.01000])
  let corner_l = el(d, [0.08419 + (0.0) * 0.89658 - (kl * 0.014) * 0.07848, -0.00866 + (0.0) * 0.09592 + (kl * 0.014) * 1.09582, -0.04600 + (0.0) * 1.00000], [0.00994, 0.01100, 0.01000])
  let jaw = el(d, [0.08199 + (0.0) * 0.89658 - (0.0 - jw * 0.034) * 0.07848, -0.03153 + (0.0) * 0.09592 + (0.0 - jw * 0.034) * 1.09582, 0.00000 + (0.0) * 1.00000], [0.02601, 0.01540, 0.03400])
  let mouth = el(d, [0.08408 + (0.0) * 0.89658 - (0.0 - jw * 0.017) * 0.07848, -0.02855 + (0.0) * 0.09592 + (0.0 - jw * 0.017) * 1.09582, 0.00000 + (0.0) * 1.00000], [0.02448, 0.01100, 0.03000])
  let ear_r = el(d, [-0.04129 + (0.0) * 0.89658 - (er * 0.010) * 0.07848, 0.00883 + (0.0) * 0.09592 + (er * 0.010) * 1.09582, 0.06600 + (0.0) * 1.00000], [0.01728, 0.01848, 0.01200])
  let ear_l0 = el(d, [-0.04129 + (0.0) * 0.89658 - (er * 0.010) * 0.07848, 0.00883 + (0.0) * 0.09592 + (er * 0.010) * 1.09582, -0.06600 + (0.0) * 1.00000], [0.01728, 0.01848, 0.01200])
  let ear_l = smax(ear_l0, 0.0 - el(d, [-0.03919 + (0.0) * 0.89658 - (er * 0.010) * 0.07848, 0.03004 + (0.0) * 0.09592 + (er * 0.010) * 1.09582, -0.06800 + (0.0) * 1.00000], [0.00765, 0.00935, 0.00850]), 0.00270)
  let skull_all = smin(smin(smin(cranium, cheek, 0.02700), muzzle, 0.01080), pad, 0.01440)
  let head = smax(skull_all, d.y * 0.9988 - d.x * 0.07003 - 0.03960, 0.01800)
  let nosed = smax(smin(smin(head, lobe, 0.00360), tip, 0.00540), 0.0 - nostril, 0.00180)
  let brows = smin(smin(brow_ri, brow_ro, 0.00720), smin(brow_li, brow_lo, 0.00720), 0.00720)
  let lids = smin(lid_r, lid_l, 0.00900)
  let corners = smin(corner_r, corner_l, 0.00900)
  let low = smin(smin(jaw, mouth, 0.01080), corners, 0.00720)
  smin(smin(smin(smin(nosed, brows, 0.00900), smin(lids, low, 0.00720), 0.00540), ear_r, 0.00720), ear_l, 0.00720)
}

# Head form 2: wide and heavy-browed: low skull, big brow pads, wide cheeks.
pub kind Head2 @World (c: p3@World, nod: f in -0.8..0.8, turn: f in -0.8..0.8, tilt: f in -0.8..0.8, bl: f in -1.1..1.1, br: f in -1.1..1.1, tl: f in -1.1..1.1, tr: f in -1.1..1.1, ll: f in -0.05..1.1, lr: f in -0.05..1.1, kl: f in -1.1..1.1, kr: f in -1.1..1.1, jw: f in -0.05..1.1, pf: f in -0.05..1.1, er: f in -1.1..1.1, mode: f in -1.0..6.0) {
  trace(p) = skull_2(head_frame((p - c).xyz, nod, turn, tilt), bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  material(p, n) = head_surface(mode, head_frame((p - c).xyz, nod, turn, tilt) / [0.90000, 1.10000, 1.00000], (p - c).xyz, hturn([1.0, 0.0, 0.0], nod, turn, tilt), kl, kr, jw, 0.85)
}

fn head_cell_2(c: p3@World, k: u, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> frame@World {
  let th = 3.14159265 * (f32(k % 32u) + 0.5) / 32.0
  let ph = (f32(k / 32u) + 0.5) * 0.19634954
  let dir = [cos(th), sin(th) * cos(ph), sin(th) * sin(ph)]
  var lo = 0.0
  var hi = 0.22
  for j in 0..10 {
    let r = (lo + hi) * 0.5
    if skull_2(dir * r, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) > 0.0 { hi = r } else { lo = r }
  }
  let zero = [0, 0, 0]@World
  let d0 = dir * lo
  if lo < 0.0005 || d0.x > 0.11385 {
    return frame_axes(c, zero - zero, zero - zero, zero - zero)
  }
  let h = 0.0002
  let f0 = skull_2(d0, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  let g = normalize([skull_2(d0 + [h, 0.0, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_2(d0 + [0.0, h, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_2(d0 + [0.0, 0.0, h], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0] + rgb(1e-12))
  let eth = [0.0 - sin(th), cos(th) * cos(ph), cos(th) * sin(ph)]
  let eph = [0.0, 0.0 - sin(ph), cos(ph)]
  let den = max(dot(g, dir), 0.10)
  let tx = (eth - dir * (dot(g, eth) / den)) * (lo * 0.09817477)
  let tv = (eph - dir * (dot(g, eph) / den)) * (lo * sin(th) * 0.19634954)
  let rb = hturn(d0, nod, turn, tilt)
  let gb = hturn(g, nod, turn, tilt)
  let xb = hturn(tx, nod, turn, tilt)
  let vb = hturn(tv, nod, turn, tilt)
  return frame_axes(c + [rb.x, rb.y, rb.z], [xb.x, xb.y, xb.z]@World - zero, [gb.x, gb.y, gb.z]@World - zero, [vb.x, vb.y, vb.z]@World - zero)
}

# Dry soft strands over the whole head, combed back from the nose.
pub build fn head_fur2(c: p3@World, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f, density: f, wet: f) {
  let flow = hturn([-1.0, -0.2, 0.0], nod, turn, tilt)
  build for k in 0..1024 {
    let cell = head_cell_2(c, k, nod, turn, tilt, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
    let off = (cell.origin - c).xyz
    let local = head_frame(off, nod, turn, tilt)
    groom(cell, flow, density, wet, head_dye(local / [0.90000, 1.10000, 1.00000], off, flow, 0.85))
  }
}

fn skull_3(d: rgb, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> f {
  let qa = [d.x, d.y, abs(d.z)]
  let cranium = el(d, [0.00033 + (0) * 0.91650 - (0) * 0.08022, -0.00611 + (0) * 0.13036 + (0) * 1.48932, 0.00000 + (0) * 1.15000], [0.07268, 0.06174, 0.10269])
  let cheek = el(qa, [0.01342 + (0.004 * pf) * 0.91650 - (0.0) * 0.08022, -0.02285 + (0.004 * pf) * 0.13036 + (0.0) * 1.48932, 0.05865 + (0.009 * pf) * 1.15000], [0.05814, 0.04679, 0.05083])
  let muzzle = rbox(d, [0.09366, -0.01219, 0.00000], [0.02870, 0.03887, 0.05520], 0.01316)
  let pad = el(qa, [0.10248 + (0) * 0.91650 - (0) * 0.08022, -0.01559 + (0) * 0.13036 + (0) * 1.48932, 0.04301 + (0) * 1.15000], [0.02583, 0.03035, 0.03036])
  let lobe = el(qa, [0.11995 + (0) * 0.91650 - (0) * 0.08022, 0.00776 + (0) * 0.13036 + (0) * 1.48932, 0.01265 + (0) * 1.15000], [0.00574, 0.01495, 0.01495])
  let tip = el(d, [0.11941 + (0) * 0.91650 - (0) * 0.08022, -0.00883 + (0) * 0.13036 + (0) * 1.48932, 0.00000 + (0) * 1.15000], [0.00502, 0.01196, 0.01035])
  let nostril = el(qa, [0.12583 + (0) * 0.91650 - (0) * 0.08022, 0.00559 + (0) * 0.13036 + (0) * 1.48932, 0.01380 + (0) * 1.15000], [0.00323, 0.00478, 0.00483])
  let brow_ri = el(d, [0.06658 + (0.0) * 0.91650 - (br * 0.013 + tr * 0.010) * 0.08022, 0.03273 + (0.0) * 0.13036 + (br * 0.013 + tr * 0.010) * 1.48932, 0.03680 + (0.0) * 1.15000], [0.01840, 0.01271, 0.01840])
  let brow_ro = el(d, [0.06291 + (0.0) * 0.91650 - (br * 0.013 - tr * 0.010) * 0.08022, 0.03221 + (0.0) * 0.13036 + (br * 0.013 - tr * 0.010) * 1.48932, 0.06670 + (0.0) * 1.15000], [0.01840, 0.01271, 0.01840])
  let brow_li = el(d, [0.06658 + (0.0) * 0.91650 - (bl * 0.013 + tl * 0.010) * 0.08022, 0.03273 + (0.0) * 0.13036 + (bl * 0.013 + tl * 0.010) * 1.48932, -0.03680 + (0.0) * 1.15000], [0.01840, 0.01271, 0.01840])
  let brow_lo = el(d, [0.06291 + (0.0) * 0.91650 - (bl * 0.013 - tl * 0.010) * 0.08022, 0.03221 + (0.0) * 0.13036 + (bl * 0.013 - tl * 0.010) * 1.48932, -0.06670 + (0.0) * 1.15000], [0.01840, 0.01271, 0.01840])
  let lid_r = el(d, [0.07649 + (0.0) * 0.91650 - (0.0 - lr * 0.0165) * 0.08022, 0.03729 + (0.0) * 0.13036 + (0.0 - lr * 0.0165) * 1.48932, 0.05393 + (0.0) * 1.15000], [0.01086, 0.01076, 0.01288])
  let lid_l = el(d, [0.07649 + (0.0) * 0.91650 - (0.0 - ll * 0.0165) * 0.08022, 0.03729 + (0.0) * 0.13036 + (0.0 - ll * 0.0165) * 1.48932, -0.05393 + (0.0) * 1.15000], [0.01086, 0.01076, 0.01288])
  let corner_r = el(d, [0.08285 + (0.0) * 0.91650 - (kr * 0.014) * 0.08022, -0.01223 + (0.0) * 0.13036 + (kr * 0.014) * 1.48932, 0.05290 + (0.0) * 1.15000], [0.00933, 0.01495, 0.01150])
  let corner_l = el(d, [0.08285 + (0.0) * 0.91650 - (kl * 0.014) * 0.08022, -0.01223 + (0.0) * 0.13036 + (kl * 0.014) * 1.48932, -0.05290 + (0.0) * 1.15000], [0.00933, 0.01495, 0.01150])
  let jaw = el(d, [0.08092 + (0.0) * 0.91650 - (0.0 - jw * 0.034) * 0.08022, -0.04327 + (0.0) * 0.13036 + (0.0 - jw * 0.034) * 1.48932, 0.00000 + (0.0) * 1.15000], [0.02440, 0.02093, 0.03910])
  let mouth = el(d, [0.08287 + (0.0) * 0.91650 - (0.0 - jw * 0.017) * 0.08022, -0.03924 + (0.0) * 0.13036 + (0.0 - jw * 0.017) * 1.48932, 0.00000 + (0.0) * 1.15000], [0.02296, 0.01495, 0.03450])
  let ear_r = el(d, [-0.04221 + (0.0) * 0.91650 - (er * 0.010) * 0.08022, 0.01201 + (0.0) * 0.13036 + (er * 0.010) * 1.48932, 0.07590 + (0.0) * 1.15000], [0.01766, 0.02512, 0.01380])
  let ear_l0 = el(d, [-0.04221 + (0.0) * 0.91650 - (er * 0.010) * 0.08022, 0.01201 + (0.0) * 0.13036 + (er * 0.010) * 1.48932, -0.07590 + (0.0) * 1.15000], [0.01766, 0.02512, 0.01380])
  let ear_l = smax(ear_l0, 0.0 - el(d, [-0.04006 + (0.0) * 0.91650 - (er * 0.010) * 0.08022, 0.04082 + (0.0) * 0.13036 + (er * 0.010) * 1.48932, -0.07820 + (0.0) * 1.15000], [0.00782, 0.01271, 0.00978]), 0.00276)
  let skull_all = smin(smin(smin(cranium, cheek, 0.02760), muzzle, 0.01104), pad, 0.01472)
  let head = smax(skull_all, d.y * 0.9988 - d.x * 0.09311 - 0.05382, 0.01840)
  let nosed = smax(smin(smin(head, lobe, 0.00368), tip, 0.00552), 0.0 - nostril, 0.00184)
  let brows = smin(smin(brow_ri, brow_ro, 0.00736), smin(brow_li, brow_lo, 0.00736), 0.00736)
  let lids = smin(lid_r, lid_l, 0.00920)
  let corners = smin(corner_r, corner_l, 0.00920)
  let low = smin(smin(jaw, mouth, 0.01104), corners, 0.00736)
  smin(smin(smin(smin(nosed, brows, 0.00920), smin(lids, low, 0.00736), 0.00552), ear_r, 0.00736), ear_l, 0.00736)
}

# Head form 3: the flat form at 1.15 size.
pub kind Head3 @World (c: p3@World, nod: f in -0.8..0.8, turn: f in -0.8..0.8, tilt: f in -0.8..0.8, bl: f in -1.1..1.1, br: f in -1.1..1.1, tl: f in -1.1..1.1, tr: f in -1.1..1.1, ll: f in -0.05..1.1, lr: f in -0.05..1.1, kl: f in -1.1..1.1, kr: f in -1.1..1.1, jw: f in -0.05..1.1, pf: f in -0.05..1.1, er: f in -1.1..1.1, mode: f in -1.0..6.0) {
  trace(p) = skull_3(head_frame((p - c).xyz, nod, turn, tilt), bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  material(p, n) = head_surface(mode, head_frame((p - c).xyz, nod, turn, tilt) / [0.92000, 1.49500, 1.15000], (p - c).xyz, hturn([1.0, 0.0, 0.0], nod, turn, tilt), kl, kr, jw, 0.78)
}

fn head_cell_3(c: p3@World, k: u, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> frame@World {
  let th = 3.14159265 * (f32(k % 32u) + 0.5) / 32.0
  let ph = (f32(k / 32u) + 0.5) * 0.19634954
  let dir = [cos(th), sin(th) * cos(ph), sin(th) * sin(ph)]
  var lo = 0.0
  var hi = 0.22
  for j in 0..10 {
    let r = (lo + hi) * 0.5
    if skull_3(dir * r, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) > 0.0 { hi = r } else { lo = r }
  }
  let zero = [0, 0, 0]@World
  let d0 = dir * lo
  if lo < 0.0005 || d0.x > 0.11058 {
    return frame_axes(c, zero - zero, zero - zero, zero - zero)
  }
  let h = 0.0002
  let f0 = skull_3(d0, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  let g = normalize([skull_3(d0 + [h, 0.0, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_3(d0 + [0.0, h, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_3(d0 + [0.0, 0.0, h], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0] + rgb(1e-12))
  let eth = [0.0 - sin(th), cos(th) * cos(ph), cos(th) * sin(ph)]
  let eph = [0.0, 0.0 - sin(ph), cos(ph)]
  let den = max(dot(g, dir), 0.10)
  let tx = (eth - dir * (dot(g, eth) / den)) * (lo * 0.09817477)
  let tv = (eph - dir * (dot(g, eph) / den)) * (lo * sin(th) * 0.19634954)
  let rb = hturn(d0, nod, turn, tilt)
  let gb = hturn(g, nod, turn, tilt)
  let xb = hturn(tx, nod, turn, tilt)
  let vb = hturn(tv, nod, turn, tilt)
  return frame_axes(c + [rb.x, rb.y, rb.z], [xb.x, xb.y, xb.z]@World - zero, [gb.x, gb.y, gb.z]@World - zero, [vb.x, vb.y, vb.z]@World - zero)
}

# Dry soft strands over the whole head, combed back from the nose.
pub build fn head_fur3(c: p3@World, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f, density: f, wet: f) {
  let flow = hturn([-1.0, -0.2, 0.0], nod, turn, tilt)
  build for k in 0..1024 {
    let cell = head_cell_3(c, k, nod, turn, tilt, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
    let off = (cell.origin - c).xyz
    let local = head_frame(off, nod, turn, tilt)
    groom(cell, flow, density, wet, head_dye(local / [0.92000, 1.49500, 1.15000], off, flow, 0.78))
  }
}

fn skull_4(d: rgb, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> f {
  let qa = [d.x, d.y, abs(d.z)]
  let cranium = el(d, [-0.00181 + (0) * 0.79696 - (0) * 0.06976, 0.02072 + (0) * 0.06976 + (0) * 0.79696, 0.00000 + (0) * 0.80000], [0.06880, 0.07040, 0.06400])
  let cheek = el(qa, [0.01706 + (0.004 * pf) * 0.79696 - (0.0) * 0.06976, -0.01136 + (0.004 * pf) * 0.06976 + (0.0) * 0.79696, 0.03840 + (0.009 * pf) * 0.80000], [0.04640, 0.02400, 0.02880])
  let muzzle = rbox(d, [0.08507, -0.00621, 0.00000], [0.02720, 0.02080, 0.03840], 0.01144)
  let pad = el(qa, [0.09341 + (0) * 0.79696 - (0) * 0.06976, -0.00797 + (0) * 0.06976 + (0) * 0.79696, 0.02992 + (0) * 0.80000], [0.02448, 0.01624, 0.02112])
  let lobe = el(qa, [0.11005 + (0) * 0.79696 - (0) * 0.06976, 0.00465 + (0) * 0.06976 + (0) * 0.79696, 0.00880 + (0) * 0.80000], [0.00544, 0.00800, 0.01040])
  let tip = el(d, [0.10947 + (0) * 0.79696 - (0) * 0.06976, -0.00423 + (0) * 0.06976 + (0) * 0.79696, 0.00000 + (0) * 0.80000], [0.00476, 0.00640, 0.00720])
  let nostril = el(qa, [0.11561 + (0) * 0.79696 - (0) * 0.06976, 0.00353 + (0) * 0.06976 + (0) * 0.79696, 0.00960 + (0) * 0.80000], [0.00306, 0.00256, 0.00336])
  let brow_ri = el(d, [0.05763 + (0.0) * 0.79696 - (br * 0.013 + tr * 0.010) * 0.06976, 0.05724 + (0.0) * 0.06976 + (br * 0.013 + tr * 0.010) * 0.79696, 0.02400 + (0.0) * 0.80000], [0.01440, 0.00680, 0.01040])
  let brow_ro = el(d, [0.05444 + (0.0) * 0.79696 - (br * 0.013 - tr * 0.010) * 0.06976, 0.05696 + (0.0) * 0.06976 + (br * 0.013 - tr * 0.010) * 0.79696, 0.04400 + (0.0) * 0.80000], [0.01440, 0.00680, 0.01040])
  let brow_li = el(d, [0.05763 + (0.0) * 0.79696 - (bl * 0.013 + tl * 0.010) * 0.06976, 0.05724 + (0.0) * 0.06976 + (bl * 0.013 + tl * 0.010) * 0.79696, -0.02400 + (0.0) * 0.80000], [0.01440, 0.00680, 0.01040])
  let brow_lo = el(d, [0.05444 + (0.0) * 0.79696 - (bl * 0.013 - tl * 0.010) * 0.06976, 0.05696 + (0.0) * 0.06976 + (bl * 0.013 - tl * 0.010) * 0.79696, -0.04400 + (0.0) * 0.80000], [0.01440, 0.00680, 0.01040])
  let lid_r = el(d, [0.05541 + (0.0) * 0.79696 - (0.0 - lr * 0.02) * 0.06976, 0.05504 + (0.0) * 0.06976 + (0.0 - lr * 0.02) * 0.79696, 0.04000 + (0.0) * 0.80000], [0.01360, 0.00960, 0.01280])
  let lid_l = el(d, [0.05541 + (0.0) * 0.79696 - (0.0 - ll * 0.02) * 0.06976, 0.05504 + (0.0) * 0.06976 + (0.0 - ll * 0.02) * 0.79696, -0.04000 + (0.0) * 0.80000], [0.01360, 0.00960, 0.01280])
  let corner_r = el(d, [0.07483 + (0.0) * 0.79696 - (kr * 0.014) * 0.06976, -0.00630 + (0.0) * 0.06976 + (kr * 0.014) * 0.79696, 0.03680 + (0.0) * 0.80000], [0.00884, 0.00800, 0.00800])
  let corner_l = el(d, [0.07483 + (0.0) * 0.79696 - (kl * 0.014) * 0.06976, -0.00630 + (0.0) * 0.06976 + (kl * 0.014) * 0.79696, -0.03680 + (0.0) * 0.80000], [0.00884, 0.00800, 0.00800])
  let jaw = el(d, [0.07288 + (0.0) * 0.79696 - (0.0 - jw * 0.034) * 0.06976, -0.02293 + (0.0) * 0.06976 + (0.0 - jw * 0.034) * 0.79696, 0.00000 + (0.0) * 0.80000], [0.02312, 0.01120, 0.02720])
  let mouth = el(d, [0.07474 + (0.0) * 0.79696 - (0.0 - jw * 0.017) * 0.06976, -0.02076 + (0.0) * 0.06976 + (0.0 - jw * 0.017) * 0.79696, 0.00000 + (0.0) * 0.80000], [0.02176, 0.00800, 0.02400])
  let ear_r = el(d, [-0.02921 + (0.0) * 0.79696 - (er * 0.010) * 0.06976, 0.05848 + (0.0) * 0.06976 + (er * 0.010) * 0.79696, 0.04640 + (0.0) * 0.80000], [0.01760, 0.01600, 0.01120])
  let ear_l0 = el(d, [-0.02921 + (0.0) * 0.79696 - (er * 0.010) * 0.06976, 0.05848 + (0.0) * 0.06976 + (er * 0.010) * 0.79696, -0.04640 + (0.0) * 0.80000], [0.01760, 0.01600, 0.01120])
  let ear_l = smax(ear_l0, 0.0 - el(d, [-0.02735 + (0.0) * 0.79696 - (er * 0.010) * 0.06976, 0.07390 + (0.0) * 0.06976 + (er * 0.010) * 0.79696, -0.04800 + (0.0) * 0.80000], [0.00760, 0.00760, 0.00760]), 0.00240)
  let skull_all = smin(smin(smin(cranium, cheek, 0.02400), muzzle, 0.00960), pad, 0.01280)
  let head = skull_all
  let nosed = smax(smin(smin(head, lobe, 0.00320), tip, 0.00480), 0.0 - nostril, 0.00160)
  let brows = smin(smin(brow_ri, brow_ro, 0.00640), smin(brow_li, brow_lo, 0.00640), 0.00640)
  let lids = smin(lid_r, lid_l, 0.00800)
  let corners = smin(corner_r, corner_l, 0.00800)
  let low = smin(smin(jaw, mouth, 0.00960), corners, 0.00640)
  smin(smin(smin(smin(nosed, brows, 0.00800), smin(lids, low, 0.00640), 0.00480), ear_r, 0.00640), ear_l, 0.00640)
}

# Head form 4: otter face: a round cranium raised above the same muzzle, eyes forward on the face, mouse ears on top.
pub kind Head4 @World (c: p3@World, nod: f in -0.8..0.8, turn: f in -0.8..0.8, tilt: f in -0.8..0.8, bl: f in -1.1..1.1, br: f in -1.1..1.1, tl: f in -1.1..1.1, tr: f in -1.1..1.1, ll: f in -0.05..1.1, lr: f in -0.05..1.1, kl: f in -1.1..1.1, kr: f in -1.1..1.1, jw: f in -0.05..1.1, pf: f in -0.05..1.1, er: f in -1.1..1.1, mode: f in -1.0..6.0) {
  trace(p) = skull_4(head_frame((p - c).xyz, nod, turn, tilt), bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  material(p, n) = head_surface(mode, head_frame((p - c).xyz, nod, turn, tilt) / [0.80000, 0.80000, 0.80000], (p - c).xyz, hturn([1.0, 0.0, 0.0], nod, turn, tilt), kl, kr, jw, 0.85)
}

fn head_cell_4(c: p3@World, k: u, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f) -> frame@World {
  let th = 3.14159265 * (f32(k % 32u) + 0.5) / 32.0
  let ph = (f32(k / 32u) + 0.5) * 0.19634954
  let dir = [cos(th), sin(th) * cos(ph), sin(th) * sin(ph)]
  var lo = 0.0
  var hi = 0.22
  for j in 0..10 {
    let r = (lo + hi) * 0.5
    if skull_4(dir * r, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) > 0.0 { hi = r } else { lo = r }
  }
  let zero = [0, 0, 0]@World
  let d0 = dir * lo
  if lo < 0.0005 || d0.x > 0.10120 {
    return frame_axes(c, zero - zero, zero - zero, zero - zero)
  }
  let h = 0.0002
  let f0 = skull_4(d0, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
  let g = normalize([skull_4(d0 + [h, 0.0, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_4(d0 + [0.0, h, 0.0], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0, skull_4(d0 + [0.0, 0.0, h], bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er) - f0] + rgb(1e-12))
  let eth = [0.0 - sin(th), cos(th) * cos(ph), cos(th) * sin(ph)]
  let eph = [0.0, 0.0 - sin(ph), cos(ph)]
  let den = max(dot(g, dir), 0.10)
  let tx = (eth - dir * (dot(g, eth) / den)) * (lo * 0.09817477)
  let tv = (eph - dir * (dot(g, eph) / den)) * (lo * sin(th) * 0.19634954)
  let rb = hturn(d0, nod, turn, tilt)
  let gb = hturn(g, nod, turn, tilt)
  let xb = hturn(tx, nod, turn, tilt)
  let vb = hturn(tv, nod, turn, tilt)
  return frame_axes(c + [rb.x, rb.y, rb.z], [xb.x, xb.y, xb.z]@World - zero, [gb.x, gb.y, gb.z]@World - zero, [vb.x, vb.y, vb.z]@World - zero)
}

# Dry soft strands over the whole head, combed back from the nose.
pub build fn head_fur4(c: p3@World, nod: f, turn: f, tilt: f, bl: f, br: f, tl: f, tr: f, ll: f, lr: f, kl: f, kr: f, jw: f, pf: f, er: f, density: f, wet: f) {
  let flow = hturn([-1.0, -0.2, 0.0], nod, turn, tilt)
  build for k in 0..1024 {
    let cell = head_cell_4(c, k, nod, turn, tilt, bl, br, tl, tr, ll, lr, kl, kr, jw, pf, er)
    let off = (cell.origin - c).xyz
    let local = head_frame(off, nod, turn, tilt)
    groom(cell, flow, density, wet, head_dye(local / [0.80000, 0.80000, 0.80000], off, flow, 0.85))
  }
}
