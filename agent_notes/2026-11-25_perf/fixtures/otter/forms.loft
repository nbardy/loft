  let brow_lo = el(d, [0.05471 + (0.0) * 0.79696 - (bl * 0.013 - tl * 0.010) * 0.06976, 0.02801 + (0.0) * 0.11336 + (bl * 0.013 - tl * 0.010) * 1.29506, -0.05800 + (0.0) * 1.00000], [0.01600, 0.01105, 0.01600])
