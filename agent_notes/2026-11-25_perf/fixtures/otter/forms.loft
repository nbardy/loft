# Generated by mkforms.py: per-form constants (scale, muzzle factor, eye, head height).
pub fn form_s(form: f) -> rgb {
  [select(select(select(select(0.80000, 0.72000, form > 0.5), 0.90000, form > 1.5), 0.92000, form > 2.5), 0.80000, form > 3.5), select(select(select(select(1.30000, 1.60000, form > 0.5), 1.10000, form > 1.5), 1.49500, form > 2.5), 0.80000, form > 3.5), select(select(select(select(1.00000, 1.00000, form > 0.5), 1.00000, form > 1.5), 1.15000, form > 2.5), 0.80000, form > 3.5)]
}

pub fn form_ml(form: f) -> f {
  select(select(select(select(0.78000, 0.70000, form > 0.5), 0.85000, form > 1.5), 0.78000, form > 2.5), 0.85000, form > 3.5)
}

# the eye in the skull's q frame (base units), compressed with the muzzle for the base forms
pub fn form_eye(form: f) -> rgb {
  [select(select(select(select(0.07636, 0.07366, form > 0.5), 0.07873, form > 1.5), 0.07636, form > 2.5), 0.07000, form > 3.5), select(select(select(select(0.00110, 0.00110, form > 0.5), 0.00110, form > 1.5), 0.00110, form > 2.5), 0.04600, form > 3.5), select(select(select(select(0.04690, 0.04690, form > 0.5), 0.04690, form > 1.5), 0.04690, form > 2.5), 0.05000, form > 3.5)]
}

pub fn form_eye_r(form: f) -> f {
  select(select(select(select(0.01050, 0.01050, form > 0.5), 0.01050, form > 1.5), 0.01208, form > 2.5), 0.01050, form > 3.5)
}

pub fn form_up(form: f) -> f {
  select(select(select(select(0.00000, 0.00900, form > 0.5), -0.00600, form > 1.5), 0.01500, form > 2.5), -0.01700, form > 3.5)
}

