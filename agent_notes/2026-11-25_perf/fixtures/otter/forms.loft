  let lid_l = el(d, [0.06651 + (0.0) * 0.79696 - (0.0 - ll * 0.0165) * 0.06976, 0.03243 + (0.0) * 0.11336 + (0.0 - ll * 0.0165) * 1.29506, -0.04690 + (0.0) * 1.00000], [0.00944, 0.00936, 0.01120])
  let corner_r = el(d, [0.07205 + (0.0) * 0.79696 - (kr * 0.014) * 0.06976, -0.01063 + (0.0) * 0.11336 + (kr * 0.014) * 1.29506, 0.04600 + (0.0) * 1.00000], [0.00811, 0.01300, 0.01000])
