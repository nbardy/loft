fn mood_gap(a: Mood, b: Mood) -> f {
  let o = a.origin - b.origin
  let t = a.tangent - b.tangent
  let n = a.normal - b.normal
  let c = a.binormal - b.binormal
  dot(o, o) + 0.2 * dot(t, t) + dot(n, n) * 2.0 + dot(c, c)
}

# One stdlib Mood to the face it wears: jaunty smirks, alert is mock surprise, ferocious threatens, proud looks
# sly, exhausted and timid droop in defeat. The walk's mood and the face come from the same value.
pub fn face_of(m: Mood) -> f {
  var best = mood_gap(m, mood_jaunty())
  var e = 0.0
  let a = mood_gap(m, mood_alert())
  if a < best { best = a; e = 2.0 }
  let f = mood_gap(m, mood_ferocious())
  if f < best { best = f; e = 3.0 }
  let p = mood_gap(m, mood_proud())
  if p < best { best = p; e = 4.0 }
  let x = mood_gap(m, mood_exhausted())
  if x < best { best = x; e = 5.0 }
  let t = mood_gap(m, mood_timid())
  if t < best { best = t; e = 5.0 }
  e
}
