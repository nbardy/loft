# L1 three-quarter
# parent: r08/tq
use stdlib::integrators::direct::{sun_sky}
use stdlib::sky::environment::{sky_color}
use self::walrus_l1::{odd, desk, ground, night, Hide, Cap, Rod, Bead, Coat, Props, Pier, Water, Floe}
camera View { eye: [-0.8000, 0.3600, 0.9000]@World, at: [0.0000, 0.2200, 0.1600]@World, fov: 36.0deg }
build {
  odd([0.0, 0.0, 0.0]@World, 0.0000, 0.3400, 0.0900, 0.0000, 0.8000)
  desk([0.0, 0.0, 0.0]@World, 0.0000, 0.0000)
  ground()
}
schedule Main {
  use_camera(View)
  cull_indirect(Hide, Cap, Rod, Bead, Coat, Props, Pier, Water, Floe)
  render_bundle(Vis64) { draw_indirect(Hide, Cap, Rod, Bead, Coat, Props, Pier, Water, Floe) }
  find_shadow_map(Hide, Cap, Coat, Props, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: night, sun: [-0.6000, 0.3000, -0.7000])
  tonemap_aces(ColorHdr, sky: sky_color)
}
