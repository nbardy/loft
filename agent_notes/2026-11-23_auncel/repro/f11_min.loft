# F11: 1 / (1 + 8 min(x, 0.35)) with several non-negative x.
use stdlib::materials::bsdf::{lambert}
kind K @World (w: f in 0.0..1.0) {
  trace(p) {
    let q = coords(p)
    let a = 1.0 / (1.0 + 8.0 * min(length(q), 0.35))
    let b = 1.0 / (1.0 + 8.0 * min(q.x * q.x, 0.35))
    let c = 1.0 / (1.0 + 8.0 * min(dot(q, q), 0.35))
    let d = 1.0 / (1.0 + 8.0 * min(w, 0.35))
    length(q) - 1.0 + 0.01 * (a + b + c + d)
  }
  material(p, n) = lambert(rgb(0.5))
}
build { emit K(w: 0.5) }
