use stdlib::materials::bsdf::{emit_lobe}
use stdlib::noise::value::{hash3}
use stdlib::sdf::solid::{capsule, box_sdf}


space World Reed

build fn hash_u(i: u, seed: u) -> f = hash3(i32(i), i32(seed), 0)

fn gust(p, t, phase) = sin(1.8 * t + phase + 0.7 * p.x + 0.3 * p.z)

kind ReedStalk @Reed (pose: xf@Reed>World, height: m in 0.7m..1.8m, lean: f, stiff: f in 0.4..2, phase: rad) {
  trace(p) = {
    let h = clamp(p.y / height, 0, 1)
    let wind = gust(pose * [0, 0, 0]@Reed, time / 1s, phase)
    let dx = height * h * h * (lean + 0.25 * wind / stiff)
    let q = p - [dx, 0, 0]
    let axis = q - [0, clamp(q.y, 0m, height), 0]@Reed
    let stem = length(axis) - mix(0.019m, 0.009m, h)
    min(stem, capsule(q, [0, height - 0.12m, 0]@Reed, [0, height, 0]@Reed, 0.035m))
  }
  material(p, n) = emit_lobe(if dot(n, dir([1, 1, 0]@Reed)) > 0 { [0.92, 0.85, 0.72] } else { [0.12, 0.18, 0.22] })
}

kind Water @World (half: m) {
  trace(p) = box_sdf(p-[0,0,0]@World, [half, 0.02m, half])
  material(p, n) = emit_lobe([0.78, 0.79, 0.69])
}

build {
  emit Sky(zenith: [0.92, 0.85, 0.72], horizon: [0.78, 0.79, 0.69])
  emit Water(half: 8m)
  build for i in 0..200 {
    let x = (hash_u(i, 11) - 0.5) * 6m
    let z = (hash_u(i, 17) - 0.5) * 4m
    emit ReedStalk(pose: place([x, 0, z]@World), height: 0.8m + hash_u(i, 1) * 0.9m,
      lean: 0.12 * (hash_u(i, 2) - 0.5), stiff: 0.5 + hash_u(i, 3), phase: 6.28rad * hash_u(i, 4))
  }
}

schedule Main { orbit(at: [0, 0.6m, 0]@World, radius: 5m, fov: 40deg) }
