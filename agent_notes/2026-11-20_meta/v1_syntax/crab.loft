use std::geom::*
use std::light::*
space World Shell Claw Leg Face

fn spine(t) = {
  let r = 0.034m * exp(2.4 * t)
  [r*cos(16rad*t), r*sin(16rad*t), -1.5*r]@Shell
}
scan coil t in 0..1 by 192 on bake_lut {
  init = frame(spine(t), dir(spine'(t)), [0, 0, 1])
  step prev = transport(prev, spine(t), dir(spine'(t)))
}
fn wet(p,n) = ggx([0.70, 0.17, 0.07], 0.22 + 0.12*grad_noise3(coords(p)*80), 0) + sss([0.9, 0.3, 0.1], 0.06m) + coat(0.9, 0.08)
kind Coil @Shell (pose: xf@Shell>World) {
  surface(u,v) grid 96x32 = {
    let f = coil(u)
    let r = 0.027m * exp(2.4*u) * (1 + 0.06*cos(80rad*u))
    f.o + r*(cos(6.283rad*v)*f.n + sin(6.283rad*v)*f.b)
  }
  material(p,n) = ggx([0.53,0.33,0.18],0.37,0) + coat(0.5,0.1)
}
kind Pincer @Claw (pose: xf@Claw>World, scale: f > 0, opening: rad) {
  trace(p) = {
    let q = [p.x/scale,p.y/scale,p.z/scale]@Claw
    let palm = round_box(coords(q),[0.16m,0.1m,0.23m],0.07m)
    let fixed = capsule(q,[0,-0.06m,0]@Claw,[0,-0.06m,0.53m]@Claw,0.05m)
    map jaw = q |> move([0,-0.06m,-0.12m]) |> rot_x(-opening)
    let teeth = 0.008m*sin(150rad*jaw.p.z/1m)*smootherstep(0m,0.1m,jaw.p.z)
    scale*smin(min(palm,fixed),capsule(jaw.p,jaw.pt(0,0,0),jaw.pt(0,0,0.42m),0.05m)-teeth,0.03m)
  }
  material(p,n) = wet(p,n)
}
kind WalkingLeg @Leg (pose: xf@Leg>World, side: f, upper: m, lower: m) {
  trace(p) = {
    let knee = [side*upper,0.08m,0]@Leg
    let foot = [side*(upper+lower),-0.28m,0.06m]@Leg
    min(capsule(p,[0,0,0]@Leg,knee,0.035m),capsule(p,knee,foot,0.028m))
  }
  material(p,n) = wet(p,n)
}
kind Eyes @Face (pose: xf@Face>World) {
  map sym(p) = p |> mirror_x |> move([-0.15m,-0.25m,-0.04m])
  trace(p) = min(capsule(sym.p,sym.pt(0,-0.13m,0),sym.pt(0,0.12m,0),0.03m),sphere(sym.p-sym.pt(0,0.12m,0),0.07m))
  material(p,n) = {
    let c = sym.pt(0,0.12m,0)
    let origin = pose * sym.out(c)
    let target = [0.55m*sin(0.4rad/s*time),0.72m,1.4m]@World
    let ray = sym.in(inv(pose)*dir(target-origin))
    let pupil = dot(dir(sym.p-c),ray)>0.91 && dist(sym.p,c)<0.075m
    if pupil { ggx([0.015,0.012,0.01],0.08,0) } else { wet(p,n) }
  }
}
kind Sand @World (extent: m) {
  trace(p) = box(coords(p),[extent,0.01m,extent])
  material(p,n) = ggx([0.37,0.32,0.24],0.65,0) + coat(0.3,0.12)
}
build fn crab(x: m) {
  emit Coil(pose: place([x,0.56m,0]@World))
  emit Eyes(pose: place([x,0.26m,0.32m]@World))
  build for s in [-1,1] {
    emit Pincer(pose: place([x+s*0.34m,0.21m,0.28m]@World),scale: if s>0 { 1 } else { 0.65 },opening: if s>0 { 0.4rad } else { 0.2rad })
    build for j in 0..6 {
      emit WalkingLeg(pose: place([x+s*0.2m,0.29m,0.2m-0.09m*j]@World),side:s,upper:0.2m+0.012m*j,lower:0.13m+0.008m*j)
    }
  }
}
build { emit Sand(extent:8m); crab(0m) }
schedule Main { orbit(at:[0,0.38m,0]@World,radius:2.8m,fov:38deg) }
