space World
fn witness(v: rgb) -> rgb = wgsl(v: rgb) -> rgb {
  let x = v.x * v.y + v.z;
  return select(vec3<f32>(1,0,0), vec3<f32>(0,1,0), bitcast<u32>(x)==0xa8800000u);
}
kind Orb @World (factors: rgb) {
  trace(p) = sphere(p - [0,0,0]@World, 0.8)
  material(p,n) = ggx(witness(factors), 0.5, 0)
}
build {
  emit Orb(factors: [1.00000011920928955078125,0.99999988079071044921875,-1])
  emit Sun(dir: dir([0.5,1.0,1.0]@World), color: [2,2,2])
}
camera Main { at: [0,0,0]@World, radius: 3, height: 0.5, fov: 40deg }
