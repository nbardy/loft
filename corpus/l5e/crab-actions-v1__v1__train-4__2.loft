kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.609761775, 0.76538378, 0.205859736]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  # carapace
  emit Sweep14Motion(
    paint: [0.829999983, 0.280000001, 0.159999996],
    expo: -0.166666672,
    center_a: [0.465748161, 1.01999998, -0.827996731],
    side_a: [0, 0, 0],
    up_a: [0, 0, 0],
    center_b: [0.442115724, 1.02321362, -0.785983503],
    side_b: [-0.0845393166, -1.11022302e-15, -0.0475533679],
    up_b: [0.00585192023, 0.179045126, -0.0104034143],
    side_b_d1: [-0.00289984839, 0, -0.00163116481],
    up_b_d1: [0.000200731229, 0.00614156481, -0.000356855511],
    side_b_d2: [-0.00086999184, 0, -0.000489370432],
    up_b_d2: [0.0000602219516, 0.00184254849, -0.000107061249],
    side_b_d3: [0.00208565989, 0, 0.00117318367],
