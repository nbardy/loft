use stdlib::geometry::sampled_sweep::{sweep_span}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-actions-v1/r38retry-before/before-1/2
# Binary tables carry adjacent ring samples and linear keyframe deltas.
space World

camera Main { radius: 9.1787796m, height: 3.79999995m, period: 1e9s, at: [0, 0.699999988, 0]@World, fov: 0.620000005rad }

kind Sweep14 @World (
  paint: rgb = [0.829999983, 0.239999995, 0.100000001],
  expo: f = -0.182539687,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x14 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep12 @World (
  paint: rgb = [0.959999979, 0.430000007, 0.159999996],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep10 @World (
  paint: rgb = [0.660000026, 0.119999997, 0.0700000003],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb = [0.579999983, 0.109999999, 0.0549999997],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x8 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep6 @World (
  paint: rgb = [0.300000012, 0.0450000018, 0.0350000001],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x6 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.609761775, 0.76538378, 0.205859736]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..38 { import_table("samples/crab-actions-v1__r38retry-before__before-1__2/Sweep14.bin", Sweep14, i) }
  build for i in 0..96 { import_table("samples/crab-actions-v1__r38retry-before__before-1__2/Sweep12.bin", Sweep12, i) }
  build for i in 0..100 { import_table("samples/crab-actions-v1__r38retry-before__before-1__2/Sweep10.bin", Sweep10, i) }
  build for i in 0..120 { import_table("samples/crab-actions-v1__r38retry-before__before-1__2/Sweep8.bin", Sweep8, i) }
  build for i in 0..16 { import_table("samples/crab-actions-v1__r38retry-before__before-1__2/Sweep6.bin", Sweep6, i) }
}
