use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-actions-v1/smoke/round-0/group-0/2
# Ring centers and section axes sampled from the pinned legacy CPU twin.
# Each row spans adjacent rings, with linear keyframe deltas at the corpus sample times.
space World

camera Main { at: [0, 0.699999988, 0]@World, radius: 9.1787796m, height: 3.79999995m, period: 1e9s, fov: 0.620000005rad }

kind Sweep12 @World (
  paint: rgb, expo: f,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    let angle = TAU * (v + 0.25)
    # The double-angle identity gives interval derivation a nonnegative square.
    let square = 0.5 * cos(2 * angle)
    let x = cos(angle) * pow(0.5 + square + 1e-12, expo)
    let y = sin(angle) * pow(0.5 - square + 1e-12, expo)
    let left = center_a + side_a * x + up_a * y
    let right = center_b + side_b * x + up_b * y
    [left * (1 - u) + right * u]@World
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb, expo: f,
  center_a: v3,
  side_a: v3,
  up_a: v3,
