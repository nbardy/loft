kind Sweep10 @World (
  paint: rgb = [0.939999998, 0.460000008, 0.180000007],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.609761775, 0.76538378, 0.205859736]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..22 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep16.bin", Sweep16, i) }
  build for i in 0..12 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep8.bin", Sweep8, i) }
  build for i in 0..76 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep12.bin", Sweep12, i) }
  build for i in 0..120 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep8Motion.bin", Sweep8Motion, i) }
  build for i in 0..16 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep12Motion.bin", Sweep12Motion, i) }
  build for i in 0..32 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep10Motion.bin", Sweep10Motion, i) }
  build for i in 0..24 { import_table("samples/crab-actions-v1__r38retry-before__before-3__0/Sweep10.bin", Sweep10, i) }
}
