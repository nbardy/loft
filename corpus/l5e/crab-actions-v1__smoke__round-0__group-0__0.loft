kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.609761775, 0.76538378, 0.205859736]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  # Carapace
  emit Sweep16(
    paint: [0.839999974, 0.330000013, 0.159999996],
    expo: -0.115384616,
    center_a: [0.382403761, 0.720000029, -0.679828882],
