kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.609761775, 0.76538378, 0.205859736]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  # carapaceRim
  emit Sweep14Motion(
    paint: [0.550000012, 0.180000007, 0.0900000036],
    expo: -0.17741935,
    center_a: [-1.01865387, 1.01999998, -0.595939755],
    side_a: [0, 0, 0],
    up_a: [0, 0, 0],
    center_b: [-0.96356982, 1.01999998, -0.564954937],
    side_b: [-0.0299183298, -8.8817842e-16, 0.0531881414],
    up_b: [-2.22044605e-16, 0.11289677, 5.55111512e-16],
    center_b_d1: [-1.11022302e-16, 0, 0],
    side_b_d1: [-0.000684167782, 0, 0.00121629832],
    up_b_d1: [1.11022302e-16, 0.00258170604, 0],
    center_b_d2: [1.11022302e-16, 0, 0],
    side_b_d2: [-0.000205259144, 0, 0.000364905136],
    up_b_d2: [-1.11022302e-16, 0.000774545013, 0],
    side_b_d3: [0.000492074469, 0, -0.000874799036],
