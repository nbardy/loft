kind Sweep8Motion @World (
  paint: rgb, expo: f,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
  center_a_d1: v3 = [0, 0, 0],
  side_a_d1: v3 = [0, 0, 0],
  up_a_d1: v3 = [0, 0, 0],
  center_b_d1: v3 = [0, 0, 0],
  side_b_d1: v3 = [0, 0, 0],
  up_b_d1: v3 = [0, 0, 0],
  center_a_d2: v3 = [0, 0, 0],
