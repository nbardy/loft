use stdlib::geometry::sampled_sweep::{sweep_span}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-actions-v1/r38retry-before/before-2/3
# Binary tables carry adjacent ring samples and linear keyframe deltas.
space World

camera Main { radius: 9.1787796m, height: 3.79999995m, period: 1e9s, at: [0, 0.699999988, 0]@World, fov: 0.620000005rad }

kind Sweep10 @World (
  paint: rgb = [0.74000001, 0.939999998, 1],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep12 @World (
  paint: rgb = [0.879999995, 0.270000011, 0.119999997],
  expo: f = -0.222222224,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb = [0.720000029, 0.219999999, 0.0900000036],
  expo: f = -0.0652173907,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x8 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep7 @World (
  paint: rgb = [0.100000001, 0.519999981, 0.340000004],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x7 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep6 @World (
  paint: rgb = [0.230000004, 0.0450000018, 0.0350000001],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x6 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep11 @World (
  paint: rgb = [0.939999998, 0.430000007, 0.109999999],
  expo: f = -0.17741935,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x11 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep9 @World (
  paint: rgb = [0.720000029, 0.689999998, 0.610000014],
  expo: f = -0.0454545468,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x9 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.609761775, 0.76538378, 0.205859736]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..52 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep10.bin", Sweep10, i) }
  build for i in 0..34 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep12.bin", Sweep12, i) }
  build for i in 0..116 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep8.bin", Sweep8, i) }
  build for i in 0..62 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep7.bin", Sweep7, i) }
  build for i in 0..10 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep6.bin", Sweep6, i) }
  build for i in 0..12 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep11.bin", Sweep11, i) }
  build for i in 0..48 { import_table("samples/crab-actions-v1__r38retry-before__before-2__3/Sweep9.bin", Sweep9, i) }
}
