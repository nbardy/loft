  center_b_d1: v3 = [0, 0, 0],
  side_b_d1: v3 = [0, 0, 0],
  up_b_d1: v3 = [0, 0, 0],
  center_a_d2: v3 = [0, 0, 0],
  side_a_d2: v3 = [0, 0, 0],
  up_a_d2: v3 = [0, 0, 0],
  center_b_d2: v3 = [0, 0, 0],
