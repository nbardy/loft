use stdlib::geometry::analytic::{ray_sphere, ray_ground}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{sphere, box_sdf}
use stdlib::sky::environment::{sky_color}

# R0 source: examples/materials/spheres.ts. Camera: whole.
space World Local

const VIEW_YAW = -0rad
const VIEW_PIVOT = [0.6, 0.4, 0.3]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind Floor @World (radius: m = 80m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) = ggx([0.42, 0.39, 0.34], 0.9, 0)
}

kind CopperBall @Local (pose: xf@Local>World, rough: f, metal: f) {
  visible(ro, rd) = ray_sphere(ro, rd, [0, 0, 0]@Local, 0.5)
  trace(p) = sphere(p - [0, 0, 0]@Local, 0.5)
  material(p, n) = ggx([0.95, 0.64, 0.54], rough, metal)
}

kind HammeredBall @Local (pose: xf@Local>World) {
  visible(ro, rd) = ray_sphere(ro, rd, [0, 0, 0]@Local, 0.5)
  trace(p) = sphere(p - [0, 0, 0]@Local, 0.5)
  material(p, n) = ggx([0.95, 0.64, 0.54], 0.3, 1)
}

build {
  build for i in 0..5 {
    let x = (f32(i) - 2) * 1.2
    let r = 0.1 + 0.2 * f32(i)
    emit CopperBall(pose: placement([x, 0.5, 1]@World), rough: r, metal: 1)
    emit CopperBall(pose: placement([x, 0.5, -0.4]@World), rough: r, metal: 0)
  }
  emit HammeredBall(pose: placement([3.6, 0.5, 1]@World))
  emit Floor()

}

schedule Main {
  orbit(at: [0.6, 0.4, 0.3]@World, radius: 9.7m, height: 4.1m, period: 1000000000s, fov: 0.75rad)
  cull_indirect(CopperBall, HammeredBall, Floor)
  render_bundle(Vis64) { draw_indirect(CopperBall); draw_indirect(HammeredBall); draw_indirect(Floor) }
  find_shadow_map(CopperBall, HammeredBall, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.4, 0.8, 0.45])
  tonemap_aces(ColorHdr, sky: sky_color)
}
