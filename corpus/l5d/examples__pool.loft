# R0 source: examples/pool.ts. Camera: whole.
space World Local

const VIEW_YAW = -0.6947382762rad
const VIEW_PIVOT = [0, 0.8, 0]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind PoolFloor @Local (pose: xf@Local>World, radius: m = 80m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@Local, [radius, 0.05, radius])
  material(p, n) {
    let r = length([p.x, p.z])
    let ripple = 0.05 * cos(9 * r - 2 * time)
    let water = mix([0.05, 0.08, 0.1], [0.14, 0.24, 0.3], ripple + 0.5)
    ggx(select([0.42, 0.39, 0.34], water, r < 2), select(0.9, 0.08, r < 2), 0)
  }
}

kind Post @Local (pose: xf@Local>World, phase: f, height: f > 0) {
  surface(u, v) grid 96x24 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let a = TAU * (v + 0.25)
    let lean = 0.15 * sin(time + phase)
    let inv_len = 1 / sqrt(lean * lean + height * height)
    let r = (0.16 - 0.06 * m) * (1 - smootherstep(0.95, 1, m))
    let width = r * sin(a) * inv_len
    [m * lean + height * width, m * height - lean * width, r * cos(a)]@Local
  }
  material(p, n, uv) {
    let m = 0.4 * uv.x + 0.3 * (1 - cos(3.14159265 * uv.x))
    let stripe = sin(18 * (m + uv.y + 0.25)) < 0
    ggx(select([0.95, 0.88, 0.7], [0.9, 0.35, 0.25], stripe), 0.65, 0)
  }
}

kind Arch @Local (pose: xf@Local>World) {
  surface(u, v) grid 96x24 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let a = TAU * (v + 0.25)
    let c = cos(3.14159265 * m)
    let s = sin(3.14159265 * m)
    let inv_len = 1 / sqrt(4.84 + 0.92 * c * c)
    let r = 0.14 * smootherstep(0, 0.05, m) * (1 - smootherstep(0.95, 1, m))
    let riser = r * sin(a) * inv_len
    [2.2 * c + 2.4 * c * riser, 2.4 * s + 2.2 * s * riser, -0.6 + r * cos(a)]@Local
  }
  material(p, n, uv) = ggx([0.3, 0.55, 0.85], 0.68, 0)
}

fn orb_position() -> p3@Local = [0, 0.15 * sin(1.5 * time), 0]@Local

kind Orb @Local (pose: xf@Local>World) {
  visible(ro, rd) = ray_sphere(ro, rd, orb_position(), 0.35)
  trace(p) = sphere(p - orb_position(), 0.35)
  material(p, n) = ggx([0.95, 0.75, 0.2], 0.45, 0)
}

build {
  let origin = placement([0, 0, 0]@World)
  emit PoolFloor(pose: origin)
  emit Arch(pose: origin)
  emit Orb(pose: placement([-0.6, 0.9, -0.4]@World))
  build for k in 0..7 {
    let a = f32(k) * TAU / 7 + 0.3
    emit Post(pose: placement([2.5 * cos(a), 0, 2.5 * sin(a)]@World), phase: f32(k), height: 1.6 + f32(k % 3) * 0.5)
  }
}

schedule Main {
  orbit(at: [0, 0.8, 0]@World, radius: 7.810249676m, height: 2.2m, period: 1000000000s, fov: 0.6rad)
  cull_indirect(PoolFloor, Post, Arch, Orb)
  render_bundle(Vis64) { draw_indirect(PoolFloor); draw_indirect(Post); draw_indirect(Arch); draw_indirect(Orb) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.5953714917, 0.8, 0.08962581595])
  tonemap_aces(ColorHdr, sky: sky_color)
}
