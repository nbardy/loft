use stdlib::geometry::analytic::{ray_sphere, ray_ground}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{sphere, box_sdf}
use stdlib::sky::environment::{sky_color}

# R0 source: examples/ranged.ts. Camera: three.
space World Local

const VIEW_YAW = -0.1106572212rad
const VIEW_PIVOT = [1, 0.8, 0]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind Floor @World (radius: m = 80m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) = ggx([0.42, 0.39, 0.34], 0.9, 0)
}

param stone_speed: f = 5 in 4..6

fn sweep() -> f = -4 + 8 * smoothstep(0.408333333, 0.608333333, time)

kind Claw @Local (pose: xf@Local>World) {
  surface(u, v) grid 96x24 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let a = TAU * (v + 0.25)
    let r = (1.05 - m) * 0.12
    [sweep() + m - 1, 1 + r * sin(a), r * cos(a)]@Local
  }
  material(p, n, uv) = ggx([0.85, 0.3, 0.2], 0.6, 0)
}

kind Shell @Local (pose: xf@Local>World) {
  visible(ro, rd) = ray_sphere(ro, rd, [0, 0, 0]@Local, 0.35)
  trace(p) = sphere(p - [0, 0, 0]@Local, 0.35)
  material(p, n) = ggx([0.3, 0.5, 0.8], 0.6, 0)
}

fn stone_center() -> p3@Local {
  let s = stone_speed * 0.7071067812 * clamp(time, 0, 2)
  [s, 1 + s - 4.905 * pow(clamp(time, 0, 2), 2), 0]@Local
}

kind Stone @Local (pose: xf@Local>World) {
  visible(ro, rd) = ray_sphere(ro, rd, stone_center(), 0.1)
  trace(p) = sphere(p - stone_center(), 0.1)
  material(p, n) = ggx([0.5, 0.5, 0.52], 0.8, 0)
}

kind Pad @Local (pose: xf@Local>World) {
  trace(p) = box_sdf(p - [0, 0, 0]@Local, [1.1, 0.03, 0.6])
  material(p, n) = ggx([0.9, 0.8, 0.3], 0.7, 0)
}

build {
  emit Claw(pose: placement([0, 0, 0]@World))
  emit Shell(pose: placement([0, 1, 0]@World))
  emit Stone(pose: placement([0, 0, 0]@World))
  emit Pad(pose: placement([3.4, 0.01, 0]@World))
  emit Floor()

}

schedule Main {
  orbit(at: [1, 0.8, 0]@World, radius: 9.055385138m, height: 3.2m, period: 1000000000s, fov: 0.6rad)
  cull_indirect(Claw, Shell, Stone, Pad, Floor)
  render_bundle(Vis64) { draw_indirect(Claw); draw_indirect(Shell); draw_indirect(Stone); draw_indirect(Pad); draw_indirect(Floor) }
  find_shadow_map(Claw, Shell, Stone, Pad, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.5411144778, 0.8, 0.3423377308])
  tonemap_aces(ColorHdr, sky: sky_color)
}
