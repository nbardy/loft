# R0 source: examples/shatter.ts. Camera: whole.
space World Local

const VIEW_YAW = -0.6610431689rad
const VIEW_PIVOT = [0, 0.9, 0]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind Floor @World (radius: m = 80m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) = ggx([0.42, 0.39, 0.34], 0.9, 0)
}

fn shard_local(p: p3@Local, centre: v2, index: f) -> rgb {
  let loose = 0.4 + 0.15 * distance(centre, [0, 1.2])
  let s = clamp(time - loose, 0, sqrt((centre.y - 0.05) / 4.9))
  let q = p.xyz - [centre.x * s * 0.6, -4.9 * s * s, 1.2 * s]
  let a = [sin(index), 0.4, cos(index)] / sqrt(1.16)
  let c = cos(3 * s)
  let b = sin(3 * s)
  q * c - cross(a, q) * b + a * (dot(a, q) * (1 - c))
}

fn halfplane(p: v2, edge: rgb) -> f = dot(p, edge.xy) - edge.z

fn clip_plane(span: v2, origin: f, ray: f) -> v2 {
  if ray > 0.0000001 {
    return [span.x, min(span.y, -origin / ray)]
  }
  if ray < -0.0000001 {
    return [max(span.x, -origin / ray), span.y]
  }
  select(span, [1.0, 0.0], origin > 0)
}

fn clip_edge(span: v2, ro: v2, rd: v2, edge: rgb) -> v2 {
  clip_plane(span, halfplane(ro, edge), dot(rd, edge.xy))
}

fn prism_edge_distance(q: v2, a: rgb, b: rgb, c: rgb, d: rgb, e: rgb, f: rgb, g: rgb) -> f {
  let left = max(halfplane(q, a), max(halfplane(q, b), halfplane(q, c)))
  let right = max(max(halfplane(q, d), halfplane(q, e)), max(halfplane(q, f), halfplane(q, g)))
  max(left, right)
}

# Cells are clipped from the same rectangle and the same 36 seeds as R0.
# Duplicate the final edge in short rows so each shard uses one shared query.
kind Shard @Local (pose: xf@Local>World, centre: v2, index: f, edge1: rgb, edge2: rgb, edge3: rgb, edge4: rgb, edge5: rgb, edge6: rgb, edge7: rgb) {
  visible(ro, rd) {
    let p = shard_local(ro, centre, index)
    let r = shard_local(ro + rd, centre, index) - p
    var span = clip_plane([0.0, 1e8], p.z - 0.015, r.z)
    span = clip_plane(span, -p.z - 0.015, -r.z)
    span = clip_edge(span, p.xy, r.xy, edge1)
    span = clip_edge(span, p.xy, r.xy, edge2)
    span = clip_edge(span, p.xy, r.xy, edge3)
    span = clip_edge(span, p.xy, r.xy, edge4)
    span = clip_edge(span, p.xy, r.xy, edge5)
    span = clip_edge(span, p.xy, r.xy, edge6)
    span = clip_edge(span, p.xy, r.xy, edge7)
    select(-1.0, span.x, span.x <= span.y)
  }
  trace(p) {
    let q = shard_local(p, centre, index)
    let prism = max(prism_edge_distance(q.xy, edge1, edge2, edge3, edge4, edge5, edge6, edge7), abs(q.z) - 0.015)
    # The 2 by 1.95 m pane bounds every rest radius by 2.8 m.
    # At landing the translation is under 2.2 m, so clipping here preserves every prism.
    max(prism, sphere(p - [0, 0, 0]@Local, 5))
  }
  material(p, n) {
    let q = shard_local(p, centre, index)
    let rim = prism_edge_distance(q.xy, edge1, edge2, edge3, edge4, edge5, edge6, edge7) > abs(q.z) - 0.015
    ggx(select([0.55, 0.75, 0.8], [0.92, 0.97, 1], rim), 0.36, 0)
  }
}

