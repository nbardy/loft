# R0 source: examples/shell.ts. Camera: three.
space World Local

const VIEW_YAW = -0.6107259644rad
const VIEW_PIVOT = [0, 2.4, 0]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind Sea @Local (pose: xf@Local>World) {
  surface(u, v) grid 100x100 {
    let x = (u - 0.5) * 80
    let z = (v - 0.5) * 80
    let h = 0.12 * sin(TAU * ((x + 0.2 * z) / (9 * sqrt(1.04)) - 0.8 * time / 9))
    [x, h, z]@Local
  }
  material(p, n, uv) = ggx([0.035, 0.18, 0.23], 0.28, 0)
}


fn whorl_point(u: f, v: f, lift: f) -> p3@Local {
  let turn = TAU * 3.2 * u
  let ring = TAU * v
  let size = exp((u - 1) * 0.16 * TAU * 3.2)
  let r = 0.62 * size + lift / 1.5
  let q = 1.5 * (1.1 * size + r * cos(ring))
  [q * cos(turn), 2.15 + q * sin(turn), 1.5 * (r * sin(ring) + (1 - u) * 0.9)]@Local
}

fn shell_tile(u: f, v: f) -> rgb {
  let x = 28.8 * u
  let y = 7 * v + x
  let cell = floor([x + 0.5, y + 0.5])
  let q = [x, y] - cell
  let qx = q.x * cos(0.35) - q.y * sin(0.35)
  let qy = q.x * sin(0.35) + q.y * cos(0.35)
  let a = abs([qx, qy]) - [0.3, 0.3]
  let d = length(max(a, [0, 0])) + min(0, max(a.x, a.y)) - 0.09
  let hue = fract(sin(dot(cell, [127.1, 311.7])) * 43758.5453)
  let fill = mix([0.98, 0.51, 0.44], [0.98, 0.86, 0.44], hue)
  let glaze = mix([0.98, 0.9, 0.78], fill, 1 - smoothstep(-0.025, 0.025, d))
  mix(glaze, [0.16, 0.07, 0.1], 1 - smoothstep(0.005, 0.045, abs(d)))
}

kind Whorl @Local (pose: xf@Local>World) {
  surface(u, v) grid 220x40 = whorl_point(u, v, 0)
  material(p, n, uv) = ggx(shell_tile(uv.x, uv.y), 0.48, 0)
}

build {
  let pose = placement([0, 0, 0]@World)
  emit Sea(pose: pose)
  emit Whorl(pose: pose)
}

schedule Main {
  orbit(at: [0, 2.4, 0]@World, radius: 12.20655562m, height: 3.6m, period: 1000000000s, fov: 0.6rad)
  cull_indirect(Sea, Whorl)
  render_bundle(Vis64) { draw_indirect(Sea); draw_indirect(Whorl) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.5857508232, 0.8, 0.1392694265])
  tonemap_aces(ColorHdr, sky: sky_color)
}
