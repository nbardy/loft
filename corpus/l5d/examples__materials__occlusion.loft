# R0 source: examples/materials/occlusion.ts. Camera: front.
space World Local

const VIEW_YAW = -0rad
const VIEW_PIVOT = [0, 0, 0]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind Relief @Local (pose: xf@Local>World) {
  trace(p) {
    let slab = box_sdf(p - [0, 0, 0]@Local, [1.12, 0.7, 0.22]) - 0.08
    let a = box_sdf(p - [-0.46, 0, 0.26]@Local, [0.14, 0.45, 0.19]) - 0.025
    let b = box_sdf(p - [0.46, 0, 0.26]@Local, [0.14, 0.45, 0.19]) - 0.025
    max(slab, -min(a, b))
  }
  material(p, n) = ggx([0.89, 0.77, 0.64], 0.82, 0)
}

build { emit Relief(pose: placement([0, 0, 0]@World)) }

schedule Main {
  orbit(at: [0, 0, 0]@World, radius: 4m, height: 0m, period: 1000000000s, fov: 0.6733496388rad)
  cull_indirect(Relief)
  render_bundle(Vis64) { draw_indirect(Relief) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.2, 0.8, -0.5])
  tonemap_aces(ColorHdr, sky: sky_color)
}
