# R0 source: examples/mirror.ts. Camera: whole.
space World Local

const VIEW_YAW = 0.03997868712rad
const VIEW_PIVOT = [1.2, 1, 0]@World

build fn placement(p: p3@World) -> xf@Local>World {
  let d = p - VIEW_PIVOT
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  place(VIEW_PIVOT + [c * d.x + s * d.z, d.y, -s * d.x + c * d.z], VIEW_YAW)
}

kind Floor @World (radius: m = 80m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) = ggx([0.42, 0.39, 0.34], 0.9, 0)
}

kind Ring @Local (pose: xf@Local>World) {
  trace(p) = length([length([p.x, p.y]) - 0.9, p.z]) - 0.25
  material(p, n) = ggx([0.9, 0.45, 0.1], 0.55, 0)
}

fn ring_from_world(p: rgb, centre: rgb) -> f {
  let q = p - centre
  let c = cos(VIEW_YAW)
  let s = sin(VIEW_YAW)
  let x = c * q.x - s * q.z
  let z = s * q.x + c * q.z
  length([length([x, q.y]) - 0.9, z]) - 0.25
}

lobe mirror_reflection(point: rgb, centre: rgb, n: rgb, v: rgb, l: rgb) {
  if dot(l, l) > 0 {
    return v4(rgb(0), 1.0)
  }

  let ro = point + 0.01 * n
  let rd = 2 * dot(v, n) * n - v
  let floor_t = select(31.0, -ro.y / min(rd.y, -0.000001), rd.y < 0)
  var t = 0.0
  for step in 0..48 {
    let d = ring_from_world(ro + t * rd, centre)
    if d < 0.001 && t < min(30.0, floor_t) {
      return v4([0.9, 0.45, 0.1], 1.0)
    }
    t = t + max(d, 0.0001)
  }
  v4(select([0.75, 0.85, 0.95], [0.42, 0.39, 0.34], floor_t < 30), 1.0)
}

kind MirrorBall @Local (pose: xf@Local>World, ring_centre: rgb) {
  visible(ro, rd) = ray_sphere(ro, rd, [0, 0, 0]@Local, 1)
  trace(p) = sphere(p - [0, 0, 0]@Local, 1)
  material(p, n) = mirror_reflection((pose * p).xyz, ring_centre)
}

build {
  let ring = placement([2.4, 1.2, 0]@World)
  emit Ring(pose: ring)
  emit MirrorBall(pose: placement([0, 1, 0]@World), ring_centre: (ring * [0, 0, 0]@Local).xyz)
  emit Floor()

}

schedule Main {
  orbit(at: [1.2, 1, 0]@World, radius: 5.003998401m, height: 0.6m, period: 1000000000s, fov: 0.6rad)
  cull_indirect(Ring, MirrorBall, Floor)
  render_bundle(Vis64) { draw_indirect(Ring); draw_indirect(MirrorBall); draw_indirect(Floor) }
  find_shadow_map(Ring, MirrorBall, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.3816947662, 0.8, 0.4656276468])
  tonemap_aces(ColorHdr, sky: sky_color)
}
