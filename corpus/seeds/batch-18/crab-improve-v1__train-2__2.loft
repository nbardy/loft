use stdlib::geometry::sampled_sweep::{sweep_span}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-improve-v1/train-2/2
# Binary tables carry adjacent ring samples and linear keyframe deltas.
space World

camera Main { eye: [4.5, 4.5, 8]@World, at: [0, 0.699999988, 0]@World, fov: 0.620000005rad }

kind Sweep12 @World (
  paint: rgb = [0.930000007, 0.25, 0.140000001],
  expo: f = -0.282608688,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep10 @World (
  paint: rgb = [1, 0.939999998, 0.779999971],
  expo: f = -0.205882356,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb = [0.779999971, 0.170000002, 0.119999997],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x8 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep6 @World (
  paint: rgb = [1, 0.579999983, 0.340000004],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x6 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.430528373, 0.76538378, 0.478364885]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..30 { import_table("samples/crab-improve-v1__train-2__2/Sweep12.bin", Sweep12, i) }
  build for i in 0..60 { import_table("samples/crab-improve-v1__train-2__2/Sweep10.bin", Sweep10, i) }
  build for i in 0..166 { import_table("samples/crab-improve-v1__train-2__2/Sweep8.bin", Sweep8, i) }
  build for i in 0..20 { import_table("samples/crab-improve-v1__train-2__2/Sweep6.bin", Sweep6, i) }
}
