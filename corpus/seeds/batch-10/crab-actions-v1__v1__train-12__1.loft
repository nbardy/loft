use stdlib::geometry::sampled_sweep::{sweep_span}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-actions-v1/v1/train-12/1
# Binary tables carry adjacent ring samples and linear keyframe deltas.
space World

camera Main { eye: [4.5, 4.5, 8]@World, at: [0, 0.699999988, 0]@World, fov: 0.620000005rad }

kind Sweep14 @World (
  paint: rgb = [0.839999974, 0.230000004, 0.129999995],
  expo: f = -0.17741935,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x14 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep12 @World (
  paint: rgb = [0.779999971, 0.200000003, 0.119999997],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb = [0.579999983, 0.140000001, 0.100000001],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x8 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep10 @World (
  paint: rgb = [0.839999974, 0.230000004, 0.129999995],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep6 @World (
  paint: rgb = [0.680000007, 0.159999996, 0.100000001],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x6 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8Motion @World (
  paint: rgb = [0.600000024, 0.109999999, 0.0799999982],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
  center_a_d1: v3 = [0, 0, 0],
  side_a_d1: v3 = [0, 0, 0],
  up_a_d1: v3 = [0, 0, 0],
  center_b_d1: v3 = [0, 0, 0],
  side_b_d1: v3 = [0, 0, 0],
  up_b_d1: v3 = [0, 0, 0],
  center_a_d2: v3 = [0, 0, 0],
  side_a_d2: v3 = [0, 0, 0],
  up_a_d2: v3 = [0, 0, 0],
  center_b_d2: v3 = [0, 0, 0],
  side_b_d2: v3 = [0, 0, 0],
  up_b_d2: v3 = [0, 0, 0],
  center_a_d3: v3 = [0, 0, 0],
  side_a_d3: v3 = [0, 0, 0],
  up_a_d3: v3 = [0, 0, 0],
  center_b_d3: v3 = [0, 0, 0],
  side_b_d3: v3 = [0, 0, 0],
  up_b_d3: v3 = [0, 0, 0],
  center_a_d4: v3 = [0, 0, 0],
  side_a_d4: v3 = [0, 0, 0],
  up_a_d4: v3 = [0, 0, 0],
  center_b_d4: v3 = [0, 0, 0],
  side_b_d4: v3 = [0, 0, 0],
  up_b_d4: v3 = [0, 0, 0],
  center_a_d5: v3 = [0, 0, 0],
  side_a_d5: v3 = [0, 0, 0],
  up_a_d5: v3 = [0, 0, 0],
  center_b_d5: v3 = [0, 0, 0],
  side_b_d5: v3 = [0, 0, 0],
  up_b_d5: v3 = [0, 0, 0],
  center_a_d6: v3 = [0, 0, 0],
  side_a_d6: v3 = [0, 0, 0],
  up_a_d6: v3 = [0, 0, 0],
  center_b_d6: v3 = [0, 0, 0],
  side_b_d6: v3 = [0, 0, 0],
  up_b_d6: v3 = [0, 0, 0],
) {
  surface(u, v) grid 1x8 {
    let t1 = clamp((time - 0s) / 0.25s, 0, 1)
    let t2 = clamp((time - 0.25s) / 0.25s, 0, 1)
    let t3 = clamp((time - 0.5s) / 0.25s, 0, 1)
    let t4 = clamp((time - 0.75s) / 0.1875s, 0, 1)
    let t5 = clamp((time - 0.9375s) / 0.432500005s, 0, 1)
    let t6 = clamp((time - 1.37s) / 1.52999997s, 0, 1)
    let center_a_now = center_a + center_a_d1 * t1 + center_a_d2 * t2 + center_a_d3 * t3 + center_a_d4 * t4 + center_a_d5 * t5 + center_a_d6 * t6
    let side_a_now = side_a + side_a_d1 * t1 + side_a_d2 * t2 + side_a_d3 * t3 + side_a_d4 * t4 + side_a_d5 * t5 + side_a_d6 * t6
    let up_a_now = up_a + up_a_d1 * t1 + up_a_d2 * t2 + up_a_d3 * t3 + up_a_d4 * t4 + up_a_d5 * t5 + up_a_d6 * t6
    let center_b_now = center_b + center_b_d1 * t1 + center_b_d2 * t2 + center_b_d3 * t3 + center_b_d4 * t4 + center_b_d5 * t5 + center_b_d6 * t6
    let side_b_now = side_b + side_b_d1 * t1 + side_b_d2 * t2 + side_b_d3 * t3 + side_b_d4 * t4 + side_b_d5 * t5 + side_b_d6 * t6
    let up_b_now = up_b + up_b_d1 * t1 + up_b_d2 * t2 + up_b_d3 * t3 + up_b_d4 * t4 + up_b_d5 * t5 + up_b_d6 * t6
    sweep_span(u, v, expo, center_a_now, side_a_now, up_a_now, center_b_now, side_b_now, up_b_now)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.430528373, 0.76538378, 0.478364885]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..20 { import_table("samples/crab-actions-v1__v1__train-12__1/Sweep14.bin", Sweep14, i) }
  build for i in 0..54 { import_table("samples/crab-actions-v1__v1__train-12__1/Sweep12.bin", Sweep12, i) }
  build for i in 0..126 { import_table("samples/crab-actions-v1__v1__train-12__1/Sweep8.bin", Sweep8, i) }
  build for i in 0..36 { import_table("samples/crab-actions-v1__v1__train-12__1/Sweep10.bin", Sweep10, i) }
  build for i in 0..20 { import_table("samples/crab-actions-v1__v1__train-12__1/Sweep6.bin", Sweep6, i) }
  build for i in 0..20 { import_table("samples/crab-actions-v1__v1__train-12__1/Sweep8Motion.bin", Sweep8Motion, i) }
}
