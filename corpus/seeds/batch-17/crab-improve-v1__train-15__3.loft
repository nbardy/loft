kind Sweep12Motion @World (
  paint: rgb, expo: f,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
  center_a_d1: v3 = [0, 0, 0],
  side_a_d1: v3 = [0, 0, 0],
  up_a_d1: v3 = [0, 0, 0],
  center_b_d1: v3 = [0, 0, 0],
  side_b_d1: v3 = [0, 0, 0],
  up_b_d1: v3 = [0, 0, 0],
  center_a_d2: v3 = [0, 0, 0],
  side_a_d2: v3 = [0, 0, 0],
  up_a_d2: v3 = [0, 0, 0],
  center_b_d2: v3 = [0, 0, 0],
  side_b_d2: v3 = [0, 0, 0],
  up_b_d2: v3 = [0, 0, 0],
  center_a_d3: v3 = [0, 0, 0],
  side_a_d3: v3 = [0, 0, 0],
  up_a_d3: v3 = [0, 0, 0],
  center_b_d3: v3 = [0, 0, 0],
  side_b_d3: v3 = [0, 0, 0],
  up_b_d3: v3 = [0, 0, 0],
  center_a_d4: v3 = [0, 0, 0],
  side_a_d4: v3 = [0, 0, 0],
  up_a_d4: v3 = [0, 0, 0],
  center_b_d4: v3 = [0, 0, 0],
  side_b_d4: v3 = [0, 0, 0],
  up_b_d4: v3 = [0, 0, 0],
  center_a_d5: v3 = [0, 0, 0],
  side_a_d5: v3 = [0, 0, 0],
  up_a_d5: v3 = [0, 0, 0],
  center_b_d5: v3 = [0, 0, 0],
  side_b_d5: v3 = [0, 0, 0],
  up_b_d5: v3 = [0, 0, 0],
  center_a_d6: v3 = [0, 0, 0],
  side_a_d6: v3 = [0, 0, 0],
  up_a_d6: v3 = [0, 0, 0],
  center_b_d6: v3 = [0, 0, 0],
  side_b_d6: v3 = [0, 0, 0],
  up_b_d6: v3 = [0, 0, 0],
) {
  surface(u, v) grid 1x12 {
    let angle = TAU * (v + 0.25)
    # The double-angle identity gives interval derivation a nonnegative square.
    let square = 0.5 * cos(2 * angle)
    let x = cos(angle) * pow(0.5 + square + 1e-12, expo)
    let y = sin(angle) * pow(0.5 - square + 1e-12, expo)
    let t1 = clamp((time - 0s) / 0.25s, 0, 1)
    let t2 = clamp((time - 0.25s) / 0.25s, 0, 1)
    let t3 = clamp((time - 0.5s) / 0.25s, 0, 1)
    let t4 = clamp((time - 0.75s) / 0.1875s, 0, 1)
    let t5 = clamp((time - 0.9375s) / 0.432500005s, 0, 1)
    let t6 = clamp((time - 1.37s) / 1.52999997s, 0, 1)
    let center_a_now = center_a + center_a_d1 * t1 + center_a_d2 * t2 + center_a_d3 * t3 + center_a_d4 * t4 + center_a_d5 * t5 + center_a_d6 * t6
    let side_a_now = side_a + side_a_d1 * t1 + side_a_d2 * t2 + side_a_d3 * t3 + side_a_d4 * t4 + side_a_d5 * t5 + side_a_d6 * t6
    let up_a_now = up_a + up_a_d1 * t1 + up_a_d2 * t2 + up_a_d3 * t3 + up_a_d4 * t4 + up_a_d5 * t5 + up_a_d6 * t6
    let center_b_now = center_b + center_b_d1 * t1 + center_b_d2 * t2 + center_b_d3 * t3 + center_b_d4 * t4 + center_b_d5 * t5 + center_b_d6 * t6
    let side_b_now = side_b + side_b_d1 * t1 + side_b_d2 * t2 + side_b_d3 * t3 + side_b_d4 * t4 + side_b_d5 * t5 + side_b_d6 * t6
    let up_b_now = up_b + up_b_d1 * t1 + up_b_d2 * t2 + up_b_d3 * t3 + up_b_d4 * t4 + up_b_d5 * t5 + up_b_d6 * t6
    let left = center_a_now + side_a_now * x + up_a_now * y
    let right = center_b_now + side_b_now * x + up_b_now * y
    [left * (1 - u) + right * u]@World
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

