use stdlib::geometry::sampled_sweep::{sweep_span}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-improve-v1/train-5/0
# Binary tables carry adjacent ring samples and linear keyframe deltas.
space World

camera Main { eye: [4.5, 4.5, 8]@World, at: [0, 0.699999988, 0]@World, fov: 0.620000005rad }

kind Sweep12 @World (
  paint: rgb = [0.075000003, 0.104999997, 0.245000005],
  expo: f = -0.0744680837,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep14 @World (
  paint: rgb = [0.0549999997, 0.185000002, 0.224999994],
  expo: f = -0.201492533,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x14 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep10 @World (
  paint: rgb = [0.0649999976, 0.125, 0.165000007],
  expo: f = -0.13636364,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb = [0.159999996, 0.0850000009, 0.159999996],
  expo: f = 0.106060609,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x8 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep6 @World (
  paint: rgb = [0.180000007, 0.340000004, 0.360000014],
  expo: f = 0.125,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x6 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep9 @World (
  paint: rgb = [0.560000002, 0.219999999, 0.115000002],
  expo: f = 0.145161286,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x9 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep7 @World (
  paint: rgb = [0.129999995, 0.310000002, 0.340000004],
  expo: f = 0.166666672,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x7 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.430528373, 0.76538378, 0.478364885]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..53 { import_table("samples/crab-improve-v1__train-5__0/Sweep12.bin", Sweep12, i) }
  build for i in 0..22 { import_table("samples/crab-improve-v1__train-5__0/Sweep14.bin", Sweep14, i) }
  build for i in 0..14 { import_table("samples/crab-improve-v1__train-5__0/Sweep10.bin", Sweep10, i) }
  build for i in 0..159 { import_table("samples/crab-improve-v1__train-5__0/Sweep8.bin", Sweep8, i) }
  build for i in 0..112 { import_table("samples/crab-improve-v1__train-5__0/Sweep6.bin", Sweep6, i) }
  build for i in 0..39 { import_table("samples/crab-improve-v1__train-5__0/Sweep9.bin", Sweep9, i) }
  build for i in 0..52 { import_table("samples/crab-improve-v1__train-5__0/Sweep7.bin", Sweep7, i) }
}
