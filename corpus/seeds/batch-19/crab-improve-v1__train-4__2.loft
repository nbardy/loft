kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.430528373, 0.76538378, 0.478364885]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  # carapace
  emit Sweep14Motion(
    paint: [0.829999983, 0.280000001, 0.159999996],
    expo: -0.166666672,
    center_a: [0, 1.01999998, -0.949999988],
    side_a: [0, 0, 0],
    up_a: [0, 0, 0],
    center_b: [0, 1.02321362, -0.901796162],
    side_b: [-0.0969959795, -1.11022302e-15, 0],
    up_b: [-5.93929074e-16, 0.179045126, -0.0119363302],
    side_b_d1: [-0.00332713383, 0, 0],
    up_b_d1: [-2.03728182e-17, 0.00614156481, -0.000409437285],
    side_b_d2: [-0.000998182921, 0, 0],
    up_b_d2: [-6.11210786e-18, 0.00184254849, -0.000122836456],
    side_b_d3: [0.00239297654, 0, 0],
    up_b_d3: [1.46527551e-17, -0.0044172015, 0.000294479862],
