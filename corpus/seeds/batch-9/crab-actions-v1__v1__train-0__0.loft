    center_a_d6: [0, -0.0207384825, 0],
    center_b_d6: [0, -0.0207384825, 0],
  )
  emit Sweep12Motion(
    paint: [0.779999971, 0.100000001, 0.0700000003],
    expo: -0.17741935,
