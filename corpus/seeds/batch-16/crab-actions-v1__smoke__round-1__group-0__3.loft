use stdlib::geometry::sampled_sweep::{sweep_span}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

# R0 seed crab-actions-v1/smoke/round-1/group-0/3
# Binary tables carry adjacent ring samples and linear keyframe deltas.
space World

camera Main { eye: [4.5, 4.5, 8]@World, at: [0, 0.699999988, 0]@World, fov: 0.620000005rad }

kind Sweep14 @World (
  paint: rgb = [0.159999996, 0.479999989, 0.5],
  expo: f = -0.107843138,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x14 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep12 @World (
  paint: rgb = [0.879999995, 0.340000004, 0.180000007],
  expo: f = -0.0454545468,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x12 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep8 @World (
  paint: rgb = [0.419999987, 0.129999995, 0.0900000036],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x8 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep6 @World (
  paint: rgb = [1, 0.550000012, 0.319999993],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x6 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Sweep10 @World (
  paint: rgb = [1, 0.550000012, 0.319999993],
  expo: f = 0,
  center_a: v3,
  side_a: v3,
  up_a: v3,
  center_b: v3,
  side_b: v3,
  up_b: v3,
) {
  surface(u, v) grid 1x10 {
    sweep_span(u, v, expo, center_a, side_a, up_a, center_b, side_b, up_b)
  }

  material(p, n, uv) = ggx(paint, 0.55, 0)
}

kind Water @World (size: m > 0m) {
  visible(ro, rd) = ray_ground(ro, rd, size)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [size, 0.05, size])
  material(p, n) = ggx([0.055, 0.17, 0.19], 0.38, 0)
}

build {
  emit Sun(dir: dir([-0.430528373, 0.76538378, 0.478364885]@World), color: [2.8, 2.6, 2.3])
  emit Sky(zenith: [0.35, 0.56, 0.88], horizon: [0.82, 0.86, 0.9])
  emit Water(size: 100m)
  build for i in 0..32 { import_table("samples/crab-actions-v1__smoke__round-1__group-0__3/Sweep14.bin", Sweep14, i) }
  build for i in 0..28 { import_table("samples/crab-actions-v1__smoke__round-1__group-0__3/Sweep12.bin", Sweep12, i) }
  build for i in 0..232 { import_table("samples/crab-actions-v1__smoke__round-1__group-0__3/Sweep8.bin", Sweep8, i) }
  build for i in 0..48 { import_table("samples/crab-actions-v1__smoke__round-1__group-0__3/Sweep6.bin", Sweep6, i) }
  build for i in 0..60 { import_table("samples/crab-actions-v1__smoke__round-1__group-0__3/Sweep10.bin", Sweep10, i) }
}
