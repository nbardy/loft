# Source: examples/compute_frame.ts at corpus/manifest.json's examples_rev.
# The second pass samples the two load-time entries to fill the frame texture.
space World
param speed: f = 2.0
target Pattern: rgba8unorm 64 x 64

fn spokes(p: v2) -> rgb {
  let a = atan2(p.y, p.x)
  let r = length(p)
  let spoke = 0.5 + 0.5 * cos(10.0 * a - 20.0 * r + time * speed)
  mix([0.13, 0.53, 0.58], [0.98, 0.55, 0.20], smoothstep(0.15, 0.95, spoke))
}

kernel fill(pixel: v2) {
  let color = spokes(pixel * (2.0 / 63.0) - v2(1.0))
  texture_store(Pattern, pixel, color)
}

kind Tile @World () {
  surface(u, v) grid 2x2 = [3 * u - 1.5, 3 * v, 0]@World
  material(p, n, uv) = ggx(sample_tex2d(Pattern, uv), 0.7, 0)
}

build {
  emit Tile()
  emit Sun(dir: dir([0, 1, 2]@World), color: [2.2, 2, 1.7])
}

camera Main {
  at: [0, 1.5, 0]@World,
  radius: 5.7m,
  height: 0m,
  period: 1e20s,
  fov: 37deg
}

schedule Main {
  pass pattern writes [Pattern] {
    compute(extent: [64, 64, 1], entry: fill)
  }
}
