# R0 source: crab-actions-v1/v1/train-11/1
# Animated strand bead_L keeps the legacy spine and section in a reduced scan reproduction.
# Part names: carapace, horn_L, horn_R, stalk_L, bead_L, stalk_R, bead_R, big_arm, big_palm, big_fixed_finger, big_movable_finger, small_arm, small_palm, small_fixed_finger, small_movable_finger, leg_L_0, leg_L_1, leg_L_2, leg_R_0, leg_R_1, leg_R_2, hat_brim, hat_band, hat_crown, barnacle_0, barnacle_1, barnacle_2, antenna_L, antenna_R, mouth
space World Local

fn spine_xyz(u: f) -> rgb {
  let x1 = [-0.44, 1.68, 0.68]
  let x2 = [1.0, 0.0, 0.0]
  let x3 = time * 3.0
  let x4 = sin(x3)
  let x5 = x4 * 0.07
  let x6 = x2 * x5
  let x7 = x1 + x6
  let x8 = clamp(u, 0.0, 1.0)
  let x9 = x8 * 1.0
  let x10 = x9 - 0.0
  let x11 = abs(x10)
  let x12 = x11 < 1.0
  let x13 = x11 * x11
  let x14 = x13 * x11
  let x15 = x14 * 1.5
  let x16 = x13 * 2.5
  let x17 = x15 - x16
  let x18 = x17 + 1.0
  let x19 = x11 < 2.0
  let x20 = x14 * -0.5
  let x21 = x20 + x16
  let x22 = x11 * 4.0
  let x23 = x21 - x22
  let x24 = x23 + 2.0
  let x25 = select(0.0, x24, x19)
  let x26 = select(x25, x18, x12)
  let x27 = x9 + 1.0
  let x28 = abs(x27)
  let x29 = x28 < 1.0
  let x30 = x28 * x28
  let x31 = x30 * x28
  let x32 = x31 * 1.5
  let x33 = x30 * 2.5
  let x34 = x32 - x33
  let x35 = x34 + 1.0
  let x36 = x28 < 2.0
  let x37 = x31 * -0.5
  let x38 = x37 + x33
  let x39 = x28 * 4.0
  let x40 = x38 - x39
  let x41 = x40 + 2.0
  let x42 = select(0.0, x41, x36)
  let x43 = select(x42, x35, x29)
  let x44 = x43 * 2.0
  let x45 = x26 + x44
  let x46 = x9 - 2.0
  let x47 = abs(x46)
  let x48 = x47 < 1.0
  let x49 = x47 * x47
  let x50 = x49 * x47
  let x51 = x50 * 1.5
  let x52 = x49 * 2.5
  let x53 = x51 - x52
  let x54 = x53 + 1.0
  let x55 = x47 < 2.0
  let x56 = x50 * -0.5
  let x57 = x56 + x52
  let x58 = x47 * 4.0
  let x59 = x57 - x58
  let x60 = x59 + 2.0
  let x61 = select(0.0, x60, x55)
  let x62 = select(x61, x54, x48)
  let x63 = x45 - x62
  let x64 = x7 * x63
  let x65 = [0.0, 0.15, 0.0]
  let x66 = x7 + x65
  let x67 = x9 - 1.0
  let x68 = abs(x67)
  let x69 = x68 < 1.0
  let x70 = x68 * x68
  let x71 = x70 * x68
  let x72 = x71 * 1.5
  let x73 = x70 * 2.5
  let x74 = x72 - x73
  let x75 = x74 + 1.0
  let x76 = x68 < 2.0
  let x77 = x71 * -0.5
  let x78 = x77 + x73
  let x79 = x68 * 4.0
  let x80 = x78 - x79
  let x81 = x80 + 2.0
  let x82 = select(0.0, x81, x76)
  let x83 = select(x82, x75, x69)
  let x84 = x83 - x43
  let x85 = x62 * 2.0
  let x86 = x84 + x85
  let x87 = x66 * x86
  let x88 = x64 + x87
  x88
}

fn width(u: f) -> f {
  0.115
}

fn aspect_ratio(u: f) -> f {
  1.0
}

fn strand_color(u: f) -> rgb {
  let x1 = [0.12, 0.09, 0.08]
  x1
}

fn spine(u: f) -> p3@Local = [spine_xyz(u)]@Local
fn heading(u: f) -> d3@Local = dir(spine(u + 0.001) - spine(u - 0.001))

scan frames u in 0.0..1.0 by 5 on bake_lut {
  init = frame(spine(u), heading(u), dir([0.0, 1.0, 0.0]@Local))
  step prev = transport(prev, spine(u), heading(u))
}

fn tip_closure(u: f) -> f = sqrt(max(1.0 - pow(clamp(1.0 - (u) / 0.05, 0.0, 1.0), 2.0), 0.0)) * sqrt(max(1.0 - pow(clamp(1.0 - (1.0 - u) / 0.05, 0.0, 1.0), 2.0), 0.0))
fn section_axis(x: f) -> f = x * pow(max(x * x, 0.000000000001), 0.0)

kind Strand @Local (pose: xf@Local>World) {
  surface(u, v) grid 8x10 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let f = frames(m)
    let a = TAU * (v + 0.25)
    let r = width(m) * tip_closure(m)
    f.o + f.b * (r * section_axis(cos(a))) + f.n * (r * aspect_ratio(m) * section_axis(sin(a)))
  }
  material(p, n, uv) = ggx(strand_color(uv.x), 0.5, 0)
}

build { emit Strand(pose: place([0, 0, 0]@World)) }

camera Main { at: [0, 0.7, 0]@World, radius: 9.178779875m, height: 3.8m, period: 1000000000s, fov: 0.62rad }
