# R0 source: crab-actions-v1/v1/train-14/2
# Animated strand palml keeps the legacy spine and section in a reduced scan reproduction.
# Part names: carapace, brow, spike0, spike1, spike2, stalkl, eyeballl, pupill, stalkr, eyeballr, pupilr, arml, palml, fingerUpl, fingerOutl, armr, palmr, fingerUpr, fingerOutr, legl0, legl1, legl2, legr0, legr1, legr2, mandiblel, mandibler
space World Local

fn spine_xyz(u: f) -> rgb {
  let x1 = [-1.42, 1.4, 0.98]
  let x2 = [-1.54, 1.68, 1.4]
  let x3 = mix(x1, x2, u)
  x3
}

fn width(u: f) -> f {
  let x1 = u * 3.14159265359
  let x2 = sin(x1)
  let x3 = x2 * 0.11
  let x4 = 0.2 + x3
  let x5 = time * 2.1
  let x6 = x5 + 0.0
  let x7 = x6 * 6.28318530718
  let x8 = sin(x7)
  let x9 = x8 * 0.4
  let x10 = x7 + x9
  let x11 = cos(x10)
  let x12 = 1.0 - x11
  let x13 = x12 * 0.5
  let x14 = 0.06 * x13
  let x15 = 1.0 + x14
  let x16 = x4 * x15
  x16
}

fn aspect_ratio(u: f) -> f {
  1.15
}

fn strand_color(u: f) -> rgb {
  let x1 = [0.93, 0.38, 0.17]
  x1
}

fn spine(u: f) -> p3@Local = [spine_xyz(u)]@Local
fn heading(u: f) -> d3@Local = dir(spine(u + 0.001) - spine(u - 0.001))

scan frames u in 0.0..1.0 by 6 on bake_lut {
  init = frame(spine(u), heading(u), dir([0.0, 1.0, 0.0]@Local))
  step prev = transport(prev, spine(u), heading(u))
}

fn tip_closure(u: f) -> f = sqrt(max(1.0 - pow(clamp(1.0 - (u) / 0.05, 0.0, 1.0), 2.0), 0.0)) * sqrt(max(1.0 - pow(clamp(1.0 - (1.0 - u) / 0.05, 0.0, 1.0), 2.0), 0.0))
fn section_axis(x: f) -> f = x * pow(max(x * x, 0.000000000001), -0.0238095238095)

kind Strand @Local (pose: xf@Local>World) {
  surface(u, v) grid 10x10 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let f = frames(m)
    let a = TAU * (v + 0.25)
    let r = width(m) * tip_closure(m)
    f.o + f.b * (r * section_axis(cos(a))) + f.n * (r * aspect_ratio(m) * section_axis(sin(a)))
  }
  material(p, n, uv) = ggx(strand_color(uv.x), 0.5, 0)
}

build { emit Strand(pose: place([0, 0, 0]@World)) }

camera Main { at: [0, 0.7, 0]@World, radius: 9.178779875m, height: 3.8m, period: 1000000000s, fov: 0.62rad }
