kind Floor @World (radius: m = 80m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) = ggx([0.42, 0.39, 0.34], 0.9, 0)
}

build {
  let pose: xf@Local>World = place([0.07585384526, 0.0, -0.2787210504]@World, -0.5314287335rad)
  emit Part1Boot(pose: pose)
  emit Floor()
}

schedule Main {
  orbit(at: [0.55, 1.3, 0.0]@World, radius: 8.583851117m, height: 1.75m, period: 1000000000s, fov: 0.47rad)
  cull_indirect(Part1Boot, Floor)
  render_bundle(Vis64) {
    draw_indirect(Part1Boot)
    draw_indirect(Floor)
  }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.5728780629, 0.8, 0.1852315445])
  tonemap_aces(ColorHdr, sky: sky_color)
}
