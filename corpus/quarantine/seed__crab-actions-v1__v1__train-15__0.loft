# R0 source: crab-actions-v1/v1/train-15/0
# Animated strand palmDot keeps the legacy spine and section in a reduced scan reproduction.
# Part names: carapace, crest, seamL, seamR, spikeL, spikeC, spikeR, stalkL, stalkR, eyeL, eyeR, antL, antR, mouth, crusArm, crusPalm, crusUp, crusLow, cutArm, cutPalm, cutUp, cutLow, legBL, legBR, legML, legMR, legFL, legFR, dot1L, dot1R, dot2L, dot2R, palmDot
space World Local

fn spine_xyz(u: f) -> rgb {
  let x1 = time + 0.9
  let x2 = sin(x1)
  let x3 = x2 * 0.05
  let x4 = 1.46 + x3
  let x5 = [-1.88, x4, 1.1]
  let x6 = clamp(u, 0.0, 1.0)
  let x7 = x6 * 1.0
  let x8 = x7 - 0.0
  let x9 = abs(x8)
  let x10 = x9 < 1.0
  let x11 = x9 * x9
  let x12 = x11 * x9
  let x13 = x12 * 1.5
  let x14 = x11 * 2.5
  let x15 = x13 - x14
  let x16 = x15 + 1.0
  let x17 = x9 < 2.0
  let x18 = x12 * -0.5
  let x19 = x18 + x14
  let x20 = x9 * 4.0
  let x21 = x19 - x20
  let x22 = x21 + 2.0
  let x23 = select(0.0, x22, x17)
  let x24 = select(x23, x16, x10)
  let x25 = x7 + 1.0
  let x26 = abs(x25)
  let x27 = x26 < 1.0
  let x28 = x26 * x26
  let x29 = x28 * x26
  let x30 = x29 * 1.5
  let x31 = x28 * 2.5
  let x32 = x30 - x31
  let x33 = x32 + 1.0
  let x34 = x26 < 2.0
  let x35 = x29 * -0.5
  let x36 = x35 + x31
  let x37 = x26 * 4.0
  let x38 = x36 - x37
  let x39 = x38 + 2.0
  let x40 = select(0.0, x39, x34)
  let x41 = select(x40, x33, x27)
  let x42 = x41 * 2.0
  let x43 = x24 + x42
  let x44 = x7 - 2.0
  let x45 = abs(x44)
  let x46 = x45 < 1.0
  let x47 = x45 * x45
  let x48 = x47 * x45
  let x49 = x48 * 1.5
  let x50 = x47 * 2.5
  let x51 = x49 - x50
  let x52 = x51 + 1.0
  let x53 = x45 < 2.0
  let x54 = x48 * -0.5
  let x55 = x54 + x50
  let x56 = x45 * 4.0
  let x57 = x55 - x56
  let x58 = x57 + 2.0
  let x59 = select(0.0, x58, x53)
  let x60 = select(x59, x52, x46)
  let x61 = x43 - x60
  let x62 = x5 * x61
  let x63 = 1.52 + x3
  let x64 = [-1.93, x63, 1.14]
  let x65 = x7 - 1.0
  let x66 = abs(x65)
  let x67 = x66 < 1.0
  let x68 = x66 * x66
  let x69 = x68 * x66
  let x70 = x69 * 1.5
  let x71 = x68 * 2.5
  let x72 = x70 - x71
  let x73 = x72 + 1.0
  let x74 = x66 < 2.0
  let x75 = x69 * -0.5
  let x76 = x75 + x71
  let x77 = x66 * 4.0
  let x78 = x76 - x77
  let x79 = x78 + 2.0
  let x80 = select(0.0, x79, x74)
  let x81 = select(x80, x73, x67)
  let x82 = x81 - x41
  let x83 = x60 * 2.0
  let x84 = x82 + x83
  let x85 = x64 * x84
  let x86 = x62 + x85
  x86
}

fn width(u: f) -> f {
  0.062
}

fn aspect_ratio(u: f) -> f {
  1.0
}

fn strand_color(u: f) -> rgb {
  let x1 = [1.0, 0.66, 0.16]
  x1
}

fn spine(u: f) -> p3@Local = [spine_xyz(u)]@Local
fn heading(u: f) -> d3@Local = dir(spine(u + 0.001) - spine(u - 0.001))

scan frames u in 0.0..1.0 by 5 on bake_lut {
  init = frame(spine(u), heading(u), dir([0.0, 1.0, 0.0]@Local))
  step prev = transport(prev, spine(u), heading(u))
}

fn tip_closure(u: f) -> f = sqrt(max(1.0 - pow(clamp(1.0 - (u) / 0.05, 0.0, 1.0), 2.0), 0.0)) * sqrt(max(1.0 - pow(clamp(1.0 - (1.0 - u) / 0.05, 0.0, 1.0), 2.0), 0.0))
fn section_axis(x: f) -> f = x * pow(max(x * x, 0.000000000001), 0.0)

kind Strand @Local (pose: xf@Local>World) {
  surface(u, v) grid 6x7 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let f = frames(m)
    let a = TAU * (v + 0.25)
    let r = width(m) * tip_closure(m)
    f.o + f.b * (r * section_axis(cos(a))) + f.n * (r * aspect_ratio(m) * section_axis(sin(a)))
  }
  material(p, n, uv) = ggx(strand_color(uv.x), 0.5, 0)
}

build { emit Strand(pose: place([0, 0, 0]@World)) }

camera Main { at: [0, 0.7, 0]@World, radius: 9.178779875m, height: 3.8m, period: 1000000000s, fov: 0.62rad }
