# Source: examples/compute_volume.ts at corpus/manifest.json's examples_rev.
space World

fn ring(p: rgb) -> f {
  let angle = atan2(p.z, p.x)
  let r = length(p.xz) - (0.51 + 0.07 * cos(5.0 * angle))
  length([r, p.y + 0.10 * sin(3.0 * angle)]) - 0.19
}

bake_tex RingField 48x48x48 r32float on load mips(false) (p: rgb) {
  ring(p * 2.0 - rgb(1.0))
}

kind Ring @World () {
  trace(p) = sample_tex3d(RingField, p.xyz * 0.5 + rgb(0.5))
  material(p, n) = ggx([0.9, 0.45, 0.12], 0.5, 0)
}

kind Ground @World (radius: m) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) = ggx([0.38, 0.33, 0.25], 0.9, 0)
}

build {
  emit Ring()
  emit Ground(radius: 256m)
  emit Sun(dir: dir([-1, 2, -1]@World), color: [2.2, 2, 1.7])
}

camera Main {
  at: [0, 0, 0]@World,
  radius: 5m,
  height: 2m,
  period: 1e20s,
  fov: 38deg
}
