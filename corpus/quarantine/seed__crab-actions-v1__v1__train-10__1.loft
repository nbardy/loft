# R0 source: crab-actions-v1/v1/train-10/1
# Animated strand carapace keeps the legacy spine and section in a reduced scan reproduction.
# Part names: carapace, belly, frontRim, frontSpike0, frontSpike1, frontSpike2, spikeRight, spikeLeft, stalkRight, eyeRight, pupilRight, stalkLeft, eyeLeft, pupilLeft, crusherUpper, crusherForearm, crusherPalm, crusherFixed, crusherMover, pincerUpper, pincerForearm, pincerPalm, pincerFixed, pincerMover, legUpR0, legLowR0, legUpR1, legLowR1, legUpR2, legLowR2, legUpL0, legLowL0, legUpL1, legLowL1, legUpL2, legLowL2, palpRight, palpLeft
space World Local

fn spine_xyz(u: f) -> rgb {
  let x1 = [0.0, 0.8, -0.98]
  let x2 = clamp(u, 0.0, 1.0)
  let x3 = x2 * 2.0
  let x4 = x3 - 0.0
  let x5 = abs(x4)
  let x6 = x5 < 1.0
  let x7 = x5 * x5
  let x8 = x7 * x5
  let x9 = x8 * 1.5
  let x10 = x7 * 2.5
  let x11 = x9 - x10
  let x12 = x11 + 1.0
  let x13 = x5 < 2.0
  let x14 = x8 * -0.5
  let x15 = x14 + x10
  let x16 = x5 * 4.0
  let x17 = x15 - x16
  let x18 = x17 + 2.0
  let x19 = select(0.0, x18, x13)
  let x20 = select(x19, x12, x6)
  let x21 = x3 + 1.0
  let x22 = abs(x21)
  let x23 = x22 < 1.0
  let x24 = x22 * x22
  let x25 = x24 * x22
  let x26 = x25 * 1.5
  let x27 = x24 * 2.5
  let x28 = x26 - x27
  let x29 = x28 + 1.0
  let x30 = x22 < 2.0
  let x31 = x25 * -0.5
  let x32 = x31 + x27
  let x33 = x22 * 4.0
  let x34 = x32 - x33
  let x35 = x34 + 2.0
  let x36 = select(0.0, x35, x30)
  let x37 = select(x36, x29, x23)
  let x38 = x37 * 2.0
  let x39 = x20 + x38
  let x40 = x1 * x39
  let x41 = [0.0, 0.94, -0.25]
  let x42 = x3 - 1.0
  let x43 = abs(x42)
  let x44 = x43 < 1.0
  let x45 = x43 * x43
  let x46 = x45 * x43
  let x47 = x46 * 1.5
  let x48 = x45 * 2.5
  let x49 = x47 - x48
  let x50 = x49 + 1.0
  let x51 = x43 < 2.0
  let x52 = x46 * -0.5
  let x53 = x52 + x48
  let x54 = x43 * 4.0
  let x55 = x53 - x54
  let x56 = x55 + 2.0
  let x57 = select(0.0, x56, x51)
  let x58 = select(x57, x50, x44)
  let x59 = x58 - x37
  let x60 = x3 - 3.0
  let x61 = abs(x60)
  let x62 = x61 < 1.0
  let x63 = x61 * x61
  let x64 = x63 * x61
  let x65 = x64 * 1.5
  let x66 = x63 * 2.5
  let x67 = x65 - x66
  let x68 = x67 + 1.0
  let x69 = x61 < 2.0
  let x70 = x64 * -0.5
  let x71 = x70 + x66
  let x72 = x61 * 4.0
  let x73 = x71 - x72
  let x74 = x73 + 2.0
  let x75 = select(0.0, x74, x69)
  let x76 = select(x75, x68, x62)
  let x77 = x59 - x76
  let x78 = x41 * x77
  let x79 = x40 + x78
  let x80 = [0.0, 0.84, 0.52]
  let x81 = x3 - 2.0
  let x82 = abs(x81)
  let x83 = x82 < 1.0
  let x84 = x82 * x82
  let x85 = x84 * x82
  let x86 = x85 * 1.5
  let x87 = x84 * 2.5
  let x88 = x86 - x87
  let x89 = x88 + 1.0
  let x90 = x82 < 2.0
  let x91 = x85 * -0.5
  let x92 = x91 + x87
  let x93 = x82 * 4.0
  let x94 = x92 - x93
  let x95 = x94 + 2.0
  let x96 = select(0.0, x95, x90)
  let x97 = select(x96, x89, x83)
  let x98 = x76 * 2.0
  let x99 = x97 + x98
  let x100 = x80 * x99
  let x101 = x79 + x100
  x101
}

fn width(u: f) -> f {
  let x1 = u * 3.14159265359
  let x2 = sin(x1)
  let x3 = x2 * 0.44
  let x4 = time * 1.15
  let x5 = x4 + 0.0
  let x6 = x5 * 6.28318530718
  let x7 = sin(x6)
  let x8 = x7 * 0.4
  let x9 = x6 + x8
  let x10 = cos(x9)
  let x11 = 1.0 - x10
  let x12 = x11 * 0.5
  let x13 = 0.055 * x12
  let x14 = 1.0 + x13
  let x15 = x3 * x14
  x15
}

fn aspect_ratio(u: f) -> f {
  2.05
}

fn strand_color(u: f) -> rgb {
  let x1 = [0.78, 0.15, 0.11]
  x1
}

fn spine(u: f) -> p3@Local = [spine_xyz(u)]@Local
fn heading(u: f) -> d3@Local = dir(spine(u + 0.001) - spine(u - 0.001))

scan frames u in 0.0..1.0 by 10 on bake_lut {
  init = frame(spine(u), heading(u), dir([0.0, 1.0, 0.0]@Local))
  step prev = transport(prev, spine(u), heading(u))
}

fn tip_closure(u: f) -> f = sqrt(max(1.0 - pow(clamp(1.0 - (u) / 0.05, 0.0, 1.0), 2.0), 0.0)) * sqrt(max(1.0 - pow(clamp(1.0 - (1.0 - u) / 0.05, 0.0, 1.0), 2.0), 0.0))
fn section_axis(x: f) -> f = x * pow(max(x * x, 0.000000000001), -0.205882352941)

kind Strand @Local (pose: xf@Local>World) {
  surface(u, v) grid 18x14 {
    let m = 0.4 * u + 0.3 * (1 - cos(3.14159265 * u))
    let f = frames(m)
    let a = TAU * (v + 0.25)
    let r = width(m) * tip_closure(m)
    f.o + f.b * (r * section_axis(cos(a))) + f.n * (r * aspect_ratio(m) * section_axis(sin(a)))
  }
  material(p, n, uv) = ggx(strand_color(uv.x), 0.5, 0)
}

build { emit Strand(pose: place([0, 0, 0]@World)) }

camera Main { at: [0, 0.7, 0]@World, radius: 9.178779875m, height: 3.8m, period: 1000000000s, fov: 0.62rad }
