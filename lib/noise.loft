// Value noise on an integer hash: the same bits on the CPU twin and the GPU (no sine hash).

fn hash3(x: i32, y: i32, z: i32) -> f32 {
  var h = u32(x) * 73856093u ^ u32(y) * 19349663u ^ u32(z) * 83492791u;
  h = (h ^ (h >> 13u)) * 1274126177u;
  h = h ^ (h >> 16u);
  return f32(h & 0xffffffu) / 16777216.0;
}

// Smooth (C1) value noise in [0, 1].
fn vnoise(p: vec3<f32>) -> f32 {
  let i = floor(p);
  let f = p - i;
  let u = f * f * (vec3(3.0) - 2.0 * f);
  let x = i32(i.x);
  let y = i32(i.y);
  let z = i32(i.z);
  let a = mix(mix(hash3(x, y, z), hash3(x + 1, y, z), u.x), mix(hash3(x, y + 1, z), hash3(x + 1, y + 1, z), u.x), u.y);
  let b = mix(mix(hash3(x, y, z + 1), hash3(x + 1, y, z + 1), u.x), mix(hash3(x, y + 1, z + 1), hash3(x + 1, y + 1, z + 1), u.x), u.y);
  return mix(a, b, u.z);
}

// Two octaves.
fn fbm2(p: vec3<f32>) -> f32 {
  return 0.667 * vnoise(p) + 0.333 * vnoise(p * 2.03 + vec3(1.7, 9.2, 3.1));
}
