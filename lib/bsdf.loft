// Lobes. A lobe is a plain fn marked `@lobe` whose last three parameters are the world normal, the direction to the
// viewer and the direction to the light; it returns (BSDF x cos, for that light) in rgb and, in a, the fraction of
// light it lets through to the lobes below it. A material is a sum of lobes, bottom first. `l = 0` asks for emitted
// radiance: scattering lobes return 0 there (their cosine is 0), `emission` returns its colour. Add a lobe here or in
// a scene; no other kind and no buffer layout changes.

fn pow5(x: f32) -> f32 {
  let x2 = x * x;
  return x2 * x2 * x;
}

// GGX normal distribution times the height-correlated Smith visibility, for the half vector of v and l.
fn ggx_dv(n: vec3<f32>, v: vec3<f32>, l: vec3<f32>, rough: f32) -> f32 {
  let h = normalize(v + l + vec3(0.0, 1e-6, 0.0));
  let a = max(rough * rough, 0.002);
  let a2 = a * a;
  let nh = max(dot(n, h), 0.0);
  let nl = max(dot(n, l), 0.0);
  let nv = max(dot(n, v), 0.0001);
  let q = nh * nh * (a2 - 1.0) + 1.0;
  let k = 0.5 * a;
  return a2 / (3.14159265 * q * q) / (4.0 * (nl * (1.0 - k) + k) * (nv * (1.0 - k) + k));
}

// The base: Lambert diffuse under a Schlick-Fresnel GGX specular; metal tints the specular and drops the diffuse.
@lobe
fn ggx(albedo: vec3<f32>, rough: f32, metal: f32, n: vec3<f32>, v: vec3<f32>, l: vec3<f32>) -> vec4<f32> {
  let nl = max(dot(n, l), 0.0);
  let h = normalize(v + l + vec3(0.0, 1e-6, 0.0));
  let f0 = mix(vec3(0.04), albedo, metal);
  let f = f0 + (vec3(1.0) - f0) * pow5(1.0 - max(dot(v, h), 0.0));
  let diffuse = albedo * (1.0 - metal) * (vec3(1.0) - f) * 0.31830988;
  return vec4((diffuse + f * ggx_dv(n, v, l, rough)) * nl, 1.0);
}

// A clear dielectric coat (F0 0.04): its own GGX reflection; the layers below lose what it reflects toward the viewer.
@lobe
fn clearcoat(weight: f32, rough: f32, n: vec3<f32>, v: vec3<f32>, l: vec3<f32>) -> vec4<f32> {
  let nl = max(dot(n, l), 0.0);
  let h = normalize(v + l + vec3(0.0, 1e-6, 0.0));
  let f = 0.04 + 0.96 * pow5(1.0 - max(dot(v, h), 0.0));
  let fv = 0.04 + 0.96 * pow5(1.0 - max(dot(n, v), 0.0));
  return vec4(vec3(weight * f * ggx_dv(n, v, l, rough) * nl), 1.0 - weight * fv);
}

// Interference in a thin film (air, film, air; Airy reflectance at 650, 532 and 450 nm) on a glossy lobe: nacre.
@lobe
fn thin_film(weight: f32, ior: f32, thickness_nm: f32, n: vec3<f32>, v: vec3<f32>, l: vec3<f32>) -> vec4<f32> {
  let nl = max(dot(n, l), 0.0);
  let h = normalize(v + l + vec3(0.0, 1e-6, 0.0));
  let vh = max(dot(v, h), 0.0);
  let cos_t = sqrt(max(1.0 - (1.0 - vh * vh) / (ior * ior), 0.0));
  let r0 = (ior - 1.0) * (ior - 1.0) / ((ior + 1.0) * (ior + 1.0));
  let phase = 12.566371 * ior * thickness_nm * cos_t;
  let c = vec3(cos(phase / 650.0), cos(phase / 532.0), cos(phase / 450.0));
  let r = 2.0 * r0 * (vec3(1.0) - c) / (vec3(1.0 + r0 * r0) - 2.0 * r0 * c);
  return vec4(r * (weight * ggx_dv(n, v, l, 0.3) * nl * 2.0), 1.0 - 0.15 * weight);
}

// Subsurface, approximated: wrapped diffuse (light reaches past the terminator by `radius` metres' worth of wrap),
// tinted by the scattering colour. A marked approximation, not a diffusion profile.
@lobe
fn sss(color: vec3<f32>, radius: f32, n: vec3<f32>, v: vec3<f32>, l: vec3<f32>) -> vec4<f32> {
  let w = clamp(radius * 4.0, 0.0, 1.0);
  let lit = min(dot(l, l), 1.0);
  let wrap = max(dot(n, l) + w, 0.0) / ((1.0 + w) * (1.0 + w));
  return vec4(color * (0.31830988 * wrap * lit * w), 1.0);
}

// Light the surface gives off, unchanged by what is above it except through the lobes over it.
@lobe
fn emission(color: vec3<f32>, n: vec3<f32>, v: vec3<f32>, l: vec3<f32>) -> vec4<f32> {
  return vec4(color * (1.0 - min(dot(l, l), 1.0)), 1.0);
}
