// Closed-form ray intersections (after iq). `rd` is unit length; a negative result is a miss. Each first moves the
// origin along the ray to the point nearest the shape, so f32 keeps its digits for a far camera (a 4.5 cm leg seen
// from 15 m missed its own surface by 2 mm when solved from the eye).

fn ray_sphere(ro: Pt['s], rd: Dir['s], c: Pt['s], r: f32) -> f32 {
  let oc = ro - c;
  let b = dot(oc, rd);
  let h = b * b - (dot(oc, oc) - r * r);
  if h < 0.0 {
    return -1.0;
  }
  return -b - sqrt(h);
}

fn ray_capsule(ro0: Pt['s], rd: Dir['s], a: Pt['s], b: Pt['s], r: f32) -> f32 {
  let t0 = dot(mix(a, b, 0.5) - ro0, rd);
  let ro = ro0 + rd * t0;
  let ba = b - a;
  let oa = ro - a;
  let baba = dot(ba, ba);
  var h = -1.0;
  var t = 0.0;
  var y = 0.0;
  if baba >= 1e-12 {
    let bard = dot(ba, rd);
    let baoa = dot(ba, oa);
    let qa = baba - bard * bard;
    let qb = baba * dot(rd, oa) - baoa * bard;
    let qc = baba * dot(oa, oa) - baoa * baoa - r * r * baba;
    h = qb * qb - qa * qc;
    if h >= 0.0 {
      t = (-qb - sqrt(h)) / qa;
      y = baoa + t * bard;
    }
  }
  // The cylinder body; outside its span (or for a point capsule) the hit is on a cap sphere.
  if h >= 0.0 && y > 0.0 && y < baba {
    return t0 + t;
  }
  var cap = b;
  if y <= 0.0 {
    cap = a;
  }
  let oc = ro - cap;
  let sb = dot(oc, rd);
  let sh = sb * sb - (dot(oc, oc) - r * r);
  if sh < 0.0 {
    return -1.0;
  }
  return t0 - sb - sqrt(sh);
}

// The nearer of two hits (a negative value is a miss).
fn hit_min(a: f32, b: f32) -> f32 {
  if a < 0.0 {
    return b;
  }
  if b < 0.0 {
    return a;
  }
  return min(a, b);
}
