# Exposure, display curves and paper sit after linear lighting.
fn paper_grain(c: rgb, px: v2, fibre: f, tooth: f) -> rgb =
  wgsl(c: rgb, px: v2, fibre: f, tooth: f) -> rgb {
    let p = vec2<u32>(px);
    var h = p.x * 0x9e3779b9u ^ p.y * 0x85ebca6bu;
    h = (h ^ (h >> 16u)) * 0x7feb352du;
    let grit = f32(h >> 8u) / 16777216.0 - 0.5;
    let fibres = cos(px.y * 2.3 + sin(px.x * 0.051));
    return c * (1.0 + fibres * fibre + grit * tooth);
  }

fn agx_display(c: rgb) -> rgb =
  wgsl(c: rgb) -> rgb {
    let inset = mat3x3<f32>(
      vec3<f32>(0.842479, 0.042328, 0.042375),
      vec3<f32>(0.078433, 0.878468, 0.078434),
      vec3<f32>(0.079223, 0.079166, 0.879142));
    let outset = mat3x3<f32>(
      vec3<f32>(1.196880, -0.052897, -0.052971),
      vec3<f32>(-0.098020, 1.151904, -0.098042),
      vec3<f32>(-0.099030, -0.098961, 1.151073));
    let x = clamp((log2(max(inset * c, vec3<f32>(1e-8))) + 12.47393) / 16.5, vec3<f32>(0.0), vec3<f32>(1.0));
    let y = (((((15.5*x - 40.14)*x + 31.96)*x - 6.868)*x + 0.4298)*x + 0.1191)*x - 0.00232;
    return clamp(pow(max(outset * y, vec3<f32>(0.0)), vec3<f32>(2.2)), vec3<f32>(0.0), vec3<f32>(1.0));
  }
