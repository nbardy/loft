// Phase 0 light: a sun, a sky dome and occlusion from the kind's own field. The schedule's shade pass names the light
// fn and the present pass names the sky fn; write another and name it instead.

fn shade_sun_sky(albedo: vec3<f32>, n: vec3<f32>, v: vec3<f32>, sun: vec3<f32>, ao: f32) -> vec3<f32> {
  let ndl = max(dot(n, sun), 0.0);
  let h = normalize(sun + v);
  let spec = pow(max(dot(n, h), 0.0), 64.0) * ndl * 0.5;
  let sky = mix(vec3(0.16, 0.13, 0.11), vec3(0.42, 0.55, 0.78), 0.5 + 0.5 * n.y);
  let rim = pow(1.0 - max(dot(n, v), 0.0), 4.0);
  return albedo * (ndl * vec3(2.4, 2.2, 1.9) + sky * ao) + vec3(spec) + sky * rim * 0.3 * ao;
}

fn sky_color(rd: vec3<f32>, sun: vec3<f32>) -> vec3<f32> {
  let up = clamp(rd.y, -1.0, 1.0);
  var c = mix(vec3(0.62, 0.68, 0.74), vec3(0.18, 0.33, 0.62), sqrt(max(up, 0.0)));
  if up < 0.0 {
    c = mix(vec3(0.40, 0.40, 0.42), vec3(0.16, 0.14, 0.12), sqrt(-up));
  }
  let s = max(dot(rd, sun), 0.0);
  return c + vec3(1.0, 0.85, 0.6) * (pow(s, 600.0) * 6.0 + pow(s, 8.0) * 0.2);
}
