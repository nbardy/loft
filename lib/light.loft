# Light: a sun with its shadow, a sky by quadrature, and whatever the surface emits. The schedule's shade pass names
# the light fn and the present pass names the sky fn; write others and name them instead.

const DEFAULT_SUN_COLOR = [2.2, 2.0, 1.7]
const DEFAULT_ZENITH = [0.16, 0.29, 0.55]
const DEFAULT_HORIZON = [0.48, 0.55, 0.64]

# Sky radiance by direction, without the sun's disc (the sun arrives separately, shadowed).
fn sky_dome(d: rgb) -> rgb {
  let up = clamp(d.y, -1.0, 1.0)
  let sky = mix(sky_horizon(), sky_zenith(), sqrt(max(up, 0.0)))
  let ground = mix([0.24, 0.21, 0.16], [0.12, 0.10, 0.08], sqrt(max(-up, 0.0)))
  select(ground, sky, up >= 0.0 || has_sky())
}

# The fixed Fibonacci sample directions in integration order.
fn sky_patch(i: u) -> rgb =
  wgsl(i: u) -> rgb {
    const directions = array(
      vec3f(0.3996526002883911, 0.9166666865348816, 0.0),
      vec3f(-0.48772361874580383, 0.75, 0.44679486751556396),
      vec3f(0.07100989669561386, 0.5833333730697632, -0.8091228604316711),
      vec3f(0.5531073808670044, 0.4166666865348816, 0.7214298248291016),
      vec3f(-0.9534448385238647, 0.25, -0.16865061223506927),
      vec3f(0.8408204317092896, 0.08333331346511841, -0.5348613262176514),
      vec3f(-0.25870034098625183, -0.08333337306976318, 0.9623563289642334),
      vec3f(-0.4462720453739166, -0.25, -0.8592678904533386),
      vec3f(0.8538990616798401, -0.4166666269302368, 0.3118418753147125),
      vec3f(-0.7507836222648621, -0.5833333730697632, 0.3099130690097809),
      vec3f(0.2803475260734558, -0.75, -0.5990869998931885),
      vec3f(0.11960970610380173, -0.9166666269302368, 0.38133421540260315)
    );
    return directions[i];
  }

# The Bsdf under the sun (radiance factor 2.2, 2.0, 1.7, times the shadow map), plus the sky integrated by a fixed
# 12-direction Fibonacci quadrature of the sphere (each 4 pi / 12 sr, times ambient occlusion, times an exposure of
# 0.85), plus emit_lobe (the Bsdf at l = 0). A quadrature, not image-based light: glossy lobes see the sky as twelve
# soft patches. One loop with one `eval_bsdf` site: each site is inlined, and Metal's compile time follows it.
fn sun_sky(b: Bsdf, n: rgb, v: rgb, sun: rgb, shadow: f, ao: f) -> rgb {
  var c = rgb(0.0)
  for i in 0..14 {
    var l = rgb(0.0)
    var e = rgb(1.0)
    if i == 1 {
      l = sun
      e = sun_color() * shadow
    }
    if i >= 2 {
      l = sky_patch(u32(i - 2))
      e = sky_dome(l) * (0.85 * 1.0471976 * ao)
    }
    c = c + eval_bsdf(b, n, v, l) * e
  }
  c
}

# Background: the dome plus the sun's disc and glow.
fn sky_color(rd: rgb, sun: rgb) -> rgb {
  let s = max(dot(rd, sun), 0.0)
  sky_dome(rd) + [1.0, 0.85, 0.6] * (pow(s, 600.0) * 6.0 + pow(s, 8.0) * 0.2)
}
