use self::lineup::cast::{cast, back, CastPart, CastSpiral}
use self::lineup::shots::{shot_at}
use self::lineup::score::{count_at, SLAM, GRIP, RELEASE, LAND}
use stdlib::geometry::analytic::{ray_ground}
use stdlib::lighting::emitters
use stdlib::sky::environment
use stdlib::materials::bsdf::{emit_lobe, ggx}
use stdlib::post::display::{paper_grain}
use stdlib::sdf::solid::{box_sdf}
use stdlib::styles::print_sea::{print_sea}
use stdlib::styles::woodblock::{woodblock_pigment}

space World

const DEEP: rgb = [0.026, 0.057, 0.145]
const SHALLOW: rgb = [0.086, 0.17, 0.33]
const FOAM: rgb = [0.43, 0.61, 0.75]

# Override shot_time to hold the lens while the dance keeps playing.
param shot_time: s = 0 in 0..32
param square: f = 0 in 0..1

camera Main {
  clock: shot_time,
  eye: shot_at(shot_time, square > 0.5).o,
  at: shot_at(shot_time, square > 0.5).o + shot_at(shot_time, square > 0.5).t,
  fov: shot_at(shot_time, square > 0.5).n.x
}

kind Sea @World (radius: f) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) {
    let surf = print_sea(p, time, DEEP, SHALLOW, FOAM)
    let c = count_at(time)
    var ring = 0.0
    if c >= SLAM && c <= SLAM + 3.0 {
      let age = c - SLAM
      for i in 0..5 {
        let k = f32(i) - 2.0
        let centre = [7.5 - 2.0 * k * k, 1.5 - 13.0 * k]
        let ripple = length(p.xz - centre) - 1.25 - 3.4 * age
        let crest = 1.0 - smoothstep(0.09, 0.36, abs(ripple))
        ring = max(ring, crest * (1.0 - smoothstep(0.7, 3.0, age)))
      }
    }
    emit_lobe(mix(surf, [0.88, 0.72, 0.47], ring))
  }
}

# Each boat has one hull and two double-sided sails. Its world trajectory is shared by the
# three rows, and each lane supplies its own starting and landing sites.
kind DanceBoat @World (home: v2, fan: v2, peak: f, sail: f) {
  surface(u, v) grid 16x12 {
    let c = count_at(time)
    let shown = smoothstep(15.999, 16.0, c) * (1.0 - smoothstep(32.999, 33.0, c))
    let lift = smoothstep(GRIP, RELEASE, c)
    let flight = smoothstep(RELEASE, LAND, c)
    let plan = mix(home + [9.2 - 8.5 * lift, -2.4], home + fan, flight)
    let rise = 3.5 * lift * (1.0 - flight) + peak * 4.0 * flight * (1.0 - flight)
    let pos = mix([home.x + 150.0, -2.5, home.y], [plan.x, 0.23 + rise, plan.y], shown)
    let spin = TAU * flight
    let a = TAU * u
    let b = 0.5 * TAU * (v - 0.5)
    var hull = [1.7 * cos(a) * cos(b), 0.32 * sin(b), -0.59 * sin(a) * cos(b)]
    if sail != 0.0 {
      let orient = sail * (7.0 - sail * sail) / 6.0
      let ident = sail * orient
      let width = (u - 0.5) * orient + 0.5
      let sheet = 1.0 - v
      hull = [(width - 0.57) * (1.25 + 0.15 * ident) * sheet + 0.66 * (ident - 1.5),
        0.15 + v * (2.0 - 0.36 * ident), 0.34 * sin(0.5 * TAU * width) * sheet]
    }
    [pos + [hull.x * cos(spin) - hull.y * sin(spin), hull.y * cos(spin) + hull.x * sin(spin), hull.z]]@World
  }

  material(p, n, uv) {
    let seams = 1.0 - smoothstep(0.014, 0.065, abs(fract(5.0 * uv.y) - 0.5))
    let cloth = mix([0.81, 0.69, 0.47], [0.48, 0.34, 0.18], seams * 0.22)
    ggx(select([0.23, 0.081, 0.034], cloth, sail != 0.0), 0.78, 0)
  }
}

# Use the same world-space ink when the sea is beyond the depth buffer.
fn sunset(rd: rgb, sun: rgb) -> rgb {
  if rd.y < 0.0 {
    let p = wgsl(rd: rgb) -> p3@World {
      let distance = -frame.eye.y / min(rd.y, -0.00001);
      return frame.eye.xyz + distance * rd;
    }
    return print_sea(p, time, DEEP, SHALLOW, FOAM)
  }
  let h = rd.y
  let gold = mix([1.2, 0.50, 0.12], [0.90, 0.16, 0.063], smoothstep(0.015, 0.085, h))
  let violet = mix([0.31, 0.086, 0.18], [0.060, 0.050, 0.162], smoothstep(0.085, 0.28, h))
  let sky = mix(gold, violet, smoothstep(0.045, 0.14, h))
  let disc = (1.0 - smoothstep(0.065, 0.068, length(rd - [-1.0, 0.05, 0.0]))) * smoothstep(0.012, 0.014, h)
  let clouds = (1.0 - smoothstep(0.003, 0.006, abs(h - 0.118 - 0.004 * cos(44.0 * rd.z)))) *
    (1.0 - smoothstep(0.04, 0.09, abs(abs(rd.z) - 0.25)))
  mix(mix(sky, [0.88, 0.056, 0.023], disc), [1.0, 0.72, 0.46], clouds)
}

# Fiddler, mask, islander, bruiser, stilt. Geometry and pigments are columns
# in the cast. Every member is generated by the same two build functions.
build {
  var member = 0.0
  build for dims in [[3.0, 1.9, 3.55, 4.0], [3.1, 2.05, 3.30, 3.75], [3.35, 2.19, 4.0, 4.10],
    [3.1, 2.15, 4.1, 4.0], [2.72, 4.25, 2.82, 4.75]] {
    let wing = member - 2.0
    let home = [-8.0 * abs(wing), -13.5 * wing + 1.5 * abs(wing)]
    var k = 0.0
    build for ink in [[0.55, 0.072, 0.043, 1.18], [0.26, 0.055, 0.043, 0.79], [0.57, 0.081, 0.042, 0.98],
      [0.65, 0.093, 0.049, 1.17], [0.32, 0.27, 0.105, 0.84]] {
      if k == member {
        cast(member, home, dims, ink.xyz, ink.w, true, u32(select(4.0, 3.0, member == 2.0)))
        back(member, home, dims, ink.xyz, member, true)
      }
      k = k + 1.0
    }
    member = member + 1.0
  }
  var lane = 0.0
  build for flight in [[-16, 3, 19], [-16, 1.5, 18], [-16, 0, 18.5], [-20, -1.5, 17.5], [-16, -3, 22]] {
    let wing = lane - 2.0
    build for sail in [0.0, 1.0, -1.0, 2.0, -2.0] {
      emit DanceBoat(home: [-2.0 * wing * wing, -13.0 * wing], fan: flight.xy, peak: flight.z, sail: sail)
    }
    lane = lane + 1.0
  }
  emit Sea(radius: 700)
}

schedule Main {
  use_camera(Main)
  cull_indirect(CastPart, CastSpiral, DanceBoat, Sea)
  render_bundle(Vis64) { draw_indirect(CastPart, CastSpiral, DanceBoat, Sea) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: woodblock_pigment, sun: [0.28, 0.8, -0.46])
  outline_and_paper(ColorHdr)
  tonemap_aces(ColorHdr, sky: sunset)
}
