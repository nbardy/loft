use stdlib::integrators::direct::{sun_sky}
use stdlib::motion::body::{Walker, walker_plan, planted}
use stdlib::motion::gait::{step, present}
use stdlib::motion::audit::{audit, margin_held, upright, no_slide, cadence}
use self::stage::{SandDeck, stage_sky}

# A heron-like biped: hips at 0.85 m on 1.1 m legs, joints bending backward, an 8 cm sole.
# Gait test: the stdlib Walker plan with the data of this body only. Stick program: forward 0.2-1.7 s, back
# 1.7-3.2 s, then stand. Checks fold the whole run (stdlib::motion::audit).

camera Main { eye: [3.0, 1.9, 2.6]@World, at: [0.15, 0.55, 0.0]@World, fov: 0.63 }
build {
  walker_plan([0, 0, 0]@World, 0.0, 0.35, 0.0, [0.62, 0.64, 0.66], 0.85m, 0.55m, 0.55m, [-1.0, 0.3, 0.0], 0.08m, 2,
    v4(0.0), v4(0.0), [-0.09, 0.09, 0.0, 0.0], v4(0.0),
    [0.02, 0.02, 0.0, 0.0], v4(0.0), [-0.12, 0.12, 0.0, 0.0], v4(0.0))
  emit SandDeck(radius: 30)
}
schedule Main {
  run_laws(step, present, audit)
  check(planted, margin_held, upright, no_slide, cadence)
  use_camera(Main)
  cull_indirect(Walker, SandDeck)
  render_bundle(Vis64) { draw_indirect(Walker, SandDeck) }
  find_shadow_map(Walker, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [-0.45, 0.82, -0.35])
  tonemap_aces(ColorHdr, sky: stage_sky)
}
