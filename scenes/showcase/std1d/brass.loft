use stdlib::lighting::surface::{SurfaceHit, LightSummary}
use stdlib::lighting::gloss::{gloss_sky}

pub fn shade_style(hit: SurfaceHit, light: LightSummary) -> rgb {
  let facing = max(dot(hit.n, light.key_dir), 0.0) * light.key_vis
  let key = facing * light.key_radiance * [0.51, 0.39, 0.15]
  let fill = light.indirect_irradiance * [0.12, 0.07, 0.017] * light.ao
  let reflected = gloss_sky(hit, key + fill, 0.9, 0.8)
  reflected + hit.emitted
}
