use stdlib::engines::reference_primary
use stdlib::lighting::area::{SphereLamp}
use stdlib::lighting::surface::{SurfaceHit}
use stdlib::materials::bsdf::{lambert}
use stdlib::sdf::solid::{box_sdf}

fn material(hit: SurfaceHit) -> Bsdf {
  lambert([1, 1, 1])
}

kind Receiver @World () {
  trace(p) = box_sdf(p - [0, -0.15, 0]@World, [1.5, 0.15, 1.5])
  material(hit: SurfaceHit) = material(hit)
}

camera View { eye: [0, 3, 4], at: [0, 0, 0], fov: 26deg }
build {
  emit Receiver()
  emit SphereLamp(center: [0, 2, 0]@World, radius: 0.5m, color: [1, 1, 1])
  emit Sun(dir: dir([0, 1, 0]@World), color: [0, 0, 0])
  emit Sky(zenith: [0, 0, 0], horizon: [0, 0, 0])
}
