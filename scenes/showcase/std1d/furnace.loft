use stdlib::sdf::solid::{sphere}
use stdlib::geometry::analytic::{ray_sphere}
use stdlib::materials::bsdf::{ggx}

kind Sample @World (center: p3@World, radius: m > 0) {
  trace(p) = sphere(p - center, radius)
  visible(ro,rd) = ray_sphere(ro, rd, center, radius)
  material(p,n) = ggx([1, 1, 1], 1.0, 1.0)
}

param buoy_count: u = 1 in 1..20
camera View { eye: [0, 0.3, 4], at: [0, 0, 0], fov: 29deg }
build {
  if buoy_count == 1 {
    emit Sample(center: [0]@World, radius: 0.94m)
  } else {
    for i in 0..buoy_count {
      let x = (f32(i % 5) - 2.0) * 0.37
      let y = (f32(i / 5) - 1.5) * 0.36
      emit Sample(center: [x, y, 0]@World, radius: 0.16m)
    }
  }
  emit Sun(dir: dir([0, 1, 0]@World), color: [0, 0, 0])
  emit Sky(zenith: [0.5, 0.5, 0.5], horizon: [0.5, 0.5, 0.5])
}
