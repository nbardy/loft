use stdlib::engines::luminous
use self::buoys::{Water}
use stdlib::lighting::area::{SphereLamp}

param BuoyCount: u = 1 in 1..20
camera View { eye: [0, 1.5, 5.8], at: [0, -0.02, 0], fov: 35deg }
build {
  for i in 0..BuoyCount {
    let x = (f32(i % 5) - 2.0) * 0.57
    let z = f32(i / 5) * -0.49
    emit SphereLamp(center: [x, 0.18, z]@World, radius: 0.135m, color: [4.2, 0.36 + 0.44 * f32(i % 5), 0.8])
  }
  emit Water(pose: place([0, -0.29, 0]@World))
  emit Sun(dir: dir([0.5, 0.75, 0.35]@World), color: [0.55, 0.48, 0.45])
  emit Sky(zenith: [0.012, 0.035, 0.12], horizon: [0.065, 0.072, 0.13])
}
