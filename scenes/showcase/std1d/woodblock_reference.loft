use stdlib::engines::woodblock_reference
use self::buoys::{Buoy, Water}
use stdlib::geometry::layout::{grid_spot}

param BuoyCount: u = 1 in 1..20
camera View { eye: [0, 1.7, 5.8], at: [0, -0.1, 0], fov: 39deg }
build {
  for i in 0..BuoyCount {
    let spot = grid_spot(i, 5, 0.64)
    let pigment = [0.75, 0.19 + 0.035 * f32(i), 0.09]
    emit Buoy(pose: place([spot]@World), radius: 0.31m, pigment: pigment)
  }
  emit Water(pose: place([0, -0.36, 0]@World))
  emit Sun(dir: dir([0.5, 0.75, 0.35]@World), color: [2.2, 1.9, 1.5])
  emit Sky(zenith: [0.18, 0.32, 0.53], horizon: [0.73, 0.57, 0.37])
}
