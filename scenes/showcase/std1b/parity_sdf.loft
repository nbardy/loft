use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{sphere}

# SDF half of the fixed-camera sphere control.
kind Control @World () {
  trace(p) = sphere(p - [0, 0.84, 0]@World, 0.83)
  material(p, n) = ggx([0.29, 0.48, 0.49], 0.61, 0)
}
build {
  emit Control()
  emit Sun(dir: dir([-0.38, 0.72, 0.6]@World), color: [2.3, 2.1, 1.9])
}
camera Main { at: [0, 0.84, 0]@World, radius: 3.25, height: 0.32, period: 24s, fov: 36deg }
