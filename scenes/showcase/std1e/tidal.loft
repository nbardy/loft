use stdlib::motion::body::{walker, planted}
use stdlib::motion::gait::{step, present}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{box_sdf}

param actors: u = 1 in 1..1000
param link: m = 0.62m in 0.1m..1.2m

kind Sand @World () {
  trace(p) = box_sdf(p - [0.0, -0.108, 0.0]@World, [8.0, 0.06, 6.0])
  material(p, n) {
    let ripples = sin(p.x * 17.0 + 0.72 * sin(p.z * 8.0))
    ggx(mix([0.35, 0.23, 0.14], [0.47, 0.35, 0.22], 0.5 + 0.5 * ripples), 0.88, 0.0)
  }
}

camera Main { at: [0.07, 0.27, 0.0]@World, radius: 3.65m, height: 1.62m, period: 36s, fov: 40deg }

build {
  build for actor in 0..actors {
    walker([2.5 * f32(actor % 32), 0.0, 2.1 * f32(actor / 32)]@World,
      0.0, 1.0, 0.0, [0.88, 0.20, 0.068], 0.45m, 0.58m, link)
  }
  emit Sand()
  emit Sun(dir: dir([0.55, 0.79, 0.21]@World), color: [2.7, 2.45, 2.05])
  emit Sky(zenith: [0.25, 0.43, 0.68], horizon: [0.78, 0.73, 0.58])
}

schedule Main {
  run_laws(step, present)
  check(planted)
}
