# Harbour-master Odd Brasstusk: hero view (the module's own scene)
# parent: none
use stdlib::integrators::direct::{sun_sky}
use stdlib::sky::environment::{sky_color}
use self::walrus::{odd, desk, ground, night, Harbour, HarbourShadow}
camera View { eye: [0.1200, 0.2200, 1.0500]@World, at: [0.0000, 0.2400, 0.1600]@World, fov: 34.0deg }
build {
  odd([0.0, 0.0, 0.0]@World, whistle: 0.8)
  desk([0.0, 0.0, 0.0]@World)
  ground()
}
schedule Main {
  use_camera(View)
  cull_indirect(Harbour)
  render_bundle(Vis64) { draw_indirect(Harbour) }
  find_shadow_map(HarbourShadow, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: night, sun: [-0.6000, 0.3000, -0.7000])
  tonemap_aces(ColorHdr, sky: sky_color)
}
