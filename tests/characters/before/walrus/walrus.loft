# Harbour-master Odd Brasstusk (module, variant final): the character. A scene is a camera plus
#   use self::walrus::{odd, ground, Harbour}
#   build { odd(at, yaw, tip, roll, stamp, whistle); ground() }
use stdlib::integrators::direct::{sun_sky}
use stdlib::sky::environment::{sky_color, sky_patch, sky_dome}
use stdlib::sdf::solid::{smin, box_sdf, round_box, capsule}
use stdlib::geometry::analytic::{ray_ground, ray_sphere, ray_capsule}
use stdlib::materials::bsdf::{ggx, coat, sheen, sss, emit_lobe}
use stdlib::noise::value::{vnoise}

const Pivot = [0.0000, 0.3150, 0.1400]

# Ellipsoid, proven L = 1 when `ir` (1 / radii) and `s` (smallest radius) are literals at the call site.
fn el(q: rgb, c: rgb, ir: rgb, s: f) -> f {
  (length((q - c) * ir) - 1.0) * s
}

fn smax(a: f, b: f, k: f) -> f {
  0.0 - smin(0.0 - a, 0.0 - b, k)
}

# World to the figure's local frame (+x his right, +z forward) and back.
fn loc(p: p3@World, at: p3@World, yaw: f) -> rgb {
  let d = (p - at).xyz
  [0.0 - d.x * cos(yaw) + d.z * sin(yaw), d.y, d.x * sin(yaw) + d.z * cos(yaw)]
}

fn wld(at: p3@World, yaw: f, q: rgb) -> p3@World {
  [at.x - q.x * cos(yaw) + q.z * sin(yaw), at.y + q.y, at.z + q.x * sin(yaw) + q.z * cos(yaw)]@World
}

# Local frame to the head frame (tip pitches the face up, roll tilts it) and back.
fn hf(q: rgb, tip: f, roll: f) -> rgb {
  let hd = q - Pivot
  let h1 = [hd.x, hd.y * cos(tip) + hd.z * sin(tip), 0.0 - hd.y * sin(tip) + hd.z * cos(tip)]
  [h1.x * cos(roll) + h1.y * sin(roll), 0.0 - h1.x * sin(roll) + h1.y * cos(roll), h1.z]
}

fn hq(h: rgb, tip: f, roll: f) -> rgb {
  let h1 = [h.x * cos(roll) - h.y * sin(roll), h.x * sin(roll) + h.y * cos(roll), h.z]
  Pivot + [h1.x, h1.y * cos(tip) - h1.z * sin(tip), h1.y * sin(tip) + h1.z * cos(tip)]
}

# Material ids, shown flat by the "mask" channel render: 0 hide, 1 moustache pad, 2 nose, 3 ivory, 4 brass, 5 tarnished
# brass, 6 bristle, 7 iron, 8 cord, 9 lantern glass, 10 felt, 11 leather, 12 oilskin, 13 wood, 14 paper, 15 ink, 16 plank,
# 17 ice, 18 water, 19 eye.
pub fn idcol(id: f) -> rgb {
  let k = floor(id + 0.5)
  var c = [0.55, 0.30, 0.15]
  c = select(c, [0.95, 0.85, 0.40], k > 0.5)
  c = select(c, [0.20, 0.10, 0.10], k > 1.5)
  c = select(c, [1.00, 1.00, 0.90], k > 2.5)
  c = select(c, [1.00, 0.55, 0.05], k > 3.5)
  c = select(c, [0.60, 0.35, 0.15], k > 4.5)
  c = select(c, [0.80, 0.90, 0.20], k > 5.5)
  c = select(c, [0.15, 0.25, 0.90], k > 6.5)
  c = select(c, [0.40, 0.40, 0.40], k > 7.5)
  c = select(c, [1.00, 0.95, 0.60], k > 8.5)
  c = select(c, [0.50, 0.15, 0.70], k > 9.5)
  c = select(c, [0.35, 0.20, 0.10], k > 10.5)
  c = select(c, [0.10, 0.55, 0.35], k > 11.5)
  c = select(c, [0.45, 0.30, 0.15], k > 12.5)
  c = select(c, [0.90, 0.90, 0.80], k > 13.5)
  c = select(c, [0.10, 0.10, 0.50], k > 14.5)
  c = select(c, [0.30, 0.25, 0.20], k > 15.5)
  c = select(c, [0.60, 0.80, 0.95], k > 16.5)
  c = select(c, [0.05, 0.15, 0.30], k > 17.5)
  select(c, [1.0, 1.0, 1.0], k > 18.5)
}

pub kind Hide @World (at: p3@World, yaw: f, tip: f, roll: f, stamp: f, whistle: f) {
  trace(p) {
    let q = loc(p, at, yaw)
    let pw = [q.x, q.y, q.z]@World
    let h = hf(q, tip, roll)
    let ha = [abs(h.x), h.y, h.z]
    let hpw = [ha.x, ha.y, ha.z]@World
    let b0 = el(q, [0.0000, 0.1000, -0.0100], [5.0000, 10.0000, 5.2632], 0.1000)
    let b1 = el(q, [0.0000, 0.2000, -0.0400], [6.2500, 7.1429, 6.6667], 0.1400)
    let b2 = el(q, [0.0000, 0.2900, -0.0350], [8.6957, 12.5000, 10.0000], 0.0800)
    let b3 = el(q, [0.0000, 0.0950, 0.0450], [7.1429, 10.5263, 9.5238], 0.0950)
    let b4 = el(q, [0.0750, 0.0500, -0.2400], [14.2857, 23.8095, 8.3333], 0.0420)
    let b5 = el(q, [-0.0750, 0.0500, -0.2400], [14.2857, 23.8095, 8.3333], 0.0420)
    let b6 = el(q, [0.0000, 0.0700, -0.1600], [9.0909, 16.6667, 12.5000], 0.0600)
    # throat rolls: three flattened ellipsoids stacked down the chest in front of the shoulders
    let rl1 = el(q, [0.0000, 0.2620, 0.0480], [10.0000, 66.6667, 14.2857], 0.0150)
    let rl2 = el(q, [0.0000, 0.2360, 0.0510], [9.5238, 62.5000, 13.3333], 0.0160)
    let rl3 = el(q, [0.0000, 0.2080, 0.0500], [9.0909, 62.5000, 12.5000], 0.0160)
    let rolls = smin(smin(rl1, rl2, 0.012), rl3, 0.012)
    let sack = smax(smin(smin(smin(smin(smin(smin(smin(b0, b1, 0.0700), b2, 0.0700), b3, 0.0700), b4, 0.0700), b5, 0.0700), b6, 0.0700), rolls, 0.02), 0.0 - q.y, 0.01)
    let skull = el(h, [0.0000, 0.0468, -0.0065], [10.6838, 13.2626, 10.1215], 0.0754)
    let ledge = capsule(hpw, [0.0052, 0.0754, 0.0741]@World, [0.0598, 0.0858, 0.0676]@World, 0.0123)
    let snout = el(h, [0.0000, 0.0130, 0.1066], [21.3675, 25.6410, 19.2308], 0.0390)
    let slab = round_box(h - [0.0000, -0.0390, 0.1196], [0.1196, 0.0442, 0.0442], 0.0390)
    let groove = round_box(h - [0.0000, -0.0390, 0.1638], [0.0039, 0.0442, 0.0130], 0.0026)
    let chin = el(h, [0.0000, -0.0806, 0.0806], [12.8205, 27.4725, 16.0256], 0.0364)
    let nose = el(h, [0.0000, 0.0338, 0.1560], [36.6300, 64.1026, 59.1716], 0.0156)
    let sock = el(ha, [0.0286, 0.0520, 0.0910], [76.9231, 85.4701, 76.9231], 0.0117)
    let lid = el(ha, [0.0286, 0.0637, 0.0936], [64.1026, 128.2051, 76.9231], 0.0078)
    let ridge1 = el(h, [0.0000, 0.1040, 0.0494], [14.7929, 153.8462, 19.2308], 0.0065)
    let ridge2 = el(h, [0.0000, 0.0936, 0.0650], [13.9860, 153.8462, 22.6244], 0.0065)
    let face0 = smin(smin(smin(smin(smin(skull, ledge, 0.0130), snout, 0.0195), slab, 0.0156), chin, 0.0260), nose, 0.0130)
    let face = smin(smin(face0, ridge1, 0.0078), ridge2, 0.0078)
    let hh = smin(smax(smax(face, 0.0 - sock, 0.0078), 0.0 - groove, 0.0052), lid, 0.0052)
    let ra = [0.15, 0.14 + 0.13 * stamp, 0.36 - 0.05 * stamp]
    let re = [0.20, 0.11 + 0.06 * stamp, 0.17]
    let la = [0.0 - 0.17 + 0.07 * whistle, 0.05 + 0.14 * whistle, 0.28 - 0.07 * whistle]
    let le = [0.0 - 0.20, 0.09 + 0.06 * whistle, 0.13]
    let armr = smin(smin(capsule(pw, [0.17, 0.15, 0.04]@World, [re.x, re.y, re.z]@World, 0.054), capsule(pw, [re.x, re.y, re.z]@World, [ra.x, ra.y, ra.z]@World, 0.040), 0.03), (length(([q.x - ra.x, q.y - ra.y + 0.004, q.z - ra.z - 0.02]) * [20.0, 41.6667, 15.3846]) - 1.0) * 0.024, 0.02)
    let arml = smin(smin(capsule(pw, [0.0 - 0.17, 0.15, 0.04]@World, [le.x, le.y, le.z]@World, 0.054), capsule(pw, [le.x, le.y, le.z]@World, [la.x, la.y, la.z]@World, 0.040), 0.03), (length(([q.x - la.x, q.y - la.y, q.z - la.z]) * [22.2222, 33.3333, 20.0]) - 1.0) * 0.030, 0.02)
    let toer = smin(smin(el(q, [ra.x - 0.034, ra.y - 0.012, ra.z + 0.064], [90.9091, 90.9091, 50.0], 0.011), el(q, [ra.x - 0.011, ra.y - 0.012, ra.z + 0.072], [90.9091, 90.9091, 50.0], 0.011), 0.006),
      smin(el(q, [ra.x + 0.011, ra.y - 0.012, ra.z + 0.072], [90.9091, 90.9091, 50.0], 0.011), el(q, [ra.x + 0.034, ra.y - 0.012, ra.z + 0.064], [90.9091, 90.9091, 50.0], 0.011), 0.006), 0.006)
    let toel = smin(smin(el(q, [la.x - 0.034, la.y - 0.012, la.z + 0.064], [90.9091, 90.9091, 50.0], 0.011), el(q, [la.x - 0.011, la.y - 0.012, la.z + 0.072], [90.9091, 90.9091, 50.0], 0.011), 0.006),
      smin(el(q, [la.x + 0.011, la.y - 0.012, la.z + 0.072], [90.9091, 90.9091, 50.0], 0.011), el(q, [la.x + 0.034, la.y - 0.012, la.z + 0.064], [90.9091, 90.9091, 50.0], 0.011), 0.006), 0.006)
    smin(sack, smin(hh, smin(smin(armr, toer, 0.01), smin(arml, toel, 0.01), 0.01), 0.03), 0.03)
  }
  material(p, n) {
    let q = loc(p, at, yaw)
    let h = hf(q, tip, roll)
    let ha = [abs(h.x), h.y, h.z]
    let cush = round_box(h - [0.0000, -0.0390, 0.1196], [0.1196, 0.0442, 0.0442], 0.0390)
    let nose = el(h, [0.0000, 0.0338, 0.1560], [36.6300, 64.1026, 59.1716], 0.0156)
    let padm = 1.0 - smoothstep(0.0, 0.012, cush)
    let nosem = 1.0 - smoothstep(0.0, 0.003, nose)
    let belly = smoothstep(0.02, 0.14, q.z) * (1.0 - smoothstep(0.17, 0.27, q.y)) * (1.0 - smoothstep(0.10, 0.15, abs(q.x)))
    let g = vnoise([p.x * 40.0, p.y * 40.0, p.z * 40.0])
    let big = vnoise([p.x * 9.0, p.y * 9.0, p.z * 9.0])
    # folds: rings round the throat, creases across the brow, radial creases at the flipper roots: cosine troughs darken the hide.
    let neck = smoothstep(0.19, 0.26, q.y) * (1.0 - smoothstep(0.30, 0.34, q.y)) * smoothstep(0.0 - 0.02, 0.07, q.z) * (1.0 - smoothstep(0.10, 0.17, abs(q.x))) * (1.0 - padm)
    let ring = cos(q.y * 85.0 + 2.5 * big)
    let brow = smoothstep(0.05, 0.075, h.y) * (1.0 - smoothstep(0.095, 0.12, h.y)) * smoothstep(0.02, 0.06, h.z)
    let wr = cos(h.y * 230.0 + 3.0 * big)
    let root = (1.0 - smoothstep(0.0, 0.07, abs(abs(q.x) - 0.17) + abs(q.y - 0.18) * 0.6)) * (1.0 - padm)
    let rc = cos((q.y - 0.18) * 120.0 + q.z * 40.0)
    let crease = neck * smoothstep(0.35, 1.0, 0.0 - ring) + brow * smoothstep(0.4, 1.0, 0.0 - wr) + root * smoothstep(0.4, 1.0, 0.0 - rc)
    let skin_c = mix([0.20, 0.095, 0.050], [0.30, 0.15, 0.11], belly) * (0.65 + 0.2 * g + 0.5 * big) * (1.0 - 0.45 * min(crease, 1.0))
    let alb = mix(mix(skin_c, [0.34, 0.25, 0.11], padm), [0.05, 0.034, 0.030], nosem)
    let rough = mix(mix(mix(0.92 - 0.22 * g, 0.62, belly), 0.90, padm), 0.32, nosem)
    let mid = padm * 1.0 + nosem * 2.0
    # FINAL
    ggx(alb, rough, 0.0) + sheen(alb * 0.35, 0.55) + sss(alb, 0.06)
  }
}

# The harbour cap, far too small, perched on the skull. Felt crown, leather band, short peak, in the head frame.
pub kind Cap @World (at: p3@World, yaw: f, tip: f, roll: f) {
  trace(p) {
    let q = loc(p, at, yaw)
    let h = hf(q, tip, roll)
    let dome = el(h, [0.0000, 0.1417, -0.0234], [12.4069, 25.6410, 12.8205], 0.0390)
    let band = el(h, [0.0000, 0.1222, -0.0234], [11.6550, 48.0769, 12.0192], 0.0208)
    let peak = round_box([h.x, h.y + 0.25 * (h.z - 0.0624), h.z] - [0.0000, 0.1196, 0.0624], [0.0598, 0.0000, 0.0338], 0.0052)
    smin(smin(dome, band, 0.004), peak, 0.004)
  }
  material(p, n) {
    let q = loc(p, at, yaw)
    let h = hf(q, tip, roll)
    let g = vnoise([p.x * 120.0, p.y * 120.0, p.z * 120.0])
    let leather = smoothstep(0.1326 + 0.006, 0.1326 + 0.002, h.y)
    let felt = [0.030, 0.048, 0.044] * (0.8 + 0.4 * g)
    let alb = mix(felt, [0.020, 0.016, 0.012], leather)
    let rough = mix(0.92, 0.6, leather)
    let mid = mix(10.0, 11.0, leather)
    # FINAL
    ggx(alb, rough, 0.0) + sheen(alb * 0.6, 0.5)
  }
}

# Rods: tusks (0), brass ferrules (1), tarnished brass (2), moustache bristles (3).
pub kind Rod @World (a: p3@World, b: p3@World, r: m, mat: f) {
  visible(ro, rd) = ray_capsule(ro, rd, a, b, r)
  trace(p) = capsule(p, a, b, r)
  material(p, n) {
    let k = floor(mat + 0.5)
    # 0 ivory, 1 brass, 2 tarnished brass, 3 bristle, 4 iron, 5 cord, 6 lantern glass
    let alb = select(select(select(select(select(select(select([0.60, 0.52, 0.36], [0.75, 0.50, 0.20], k > 0.5), [0.38, 0.26, 0.12], k > 1.5),
      [0.80, 0.64, 0.32], k > 2.5), [0.07, 0.07, 0.08], k > 3.5), [0.03, 0.025, 0.02], k > 4.5), [0.5, 0.4, 0.2], k > 5.5), [0.10, 0.08, 0.06], k > 9.5)
    let rough = select(select(select(0.36, 0.42, k > 0.5), 0.7, k > 2.5), 0.9, k > 4.5)
    let metal = select(0.0, 1.0, (k > 0.5 && k < 2.5) || (k > 3.5 && k < 4.5))
    # rod ids -> material ids: ivory 3, brass 4, tarnished 5, bristle 6, iron 7, cord 8, glass 9
    let mid = select(k + 3.0, 11.0, k > 9.5)
    # FINAL
    ggx(alb, rough, metal) + sheen(alb * 0.3, 0.5) + sss(alb * select(0.0, 0.7, k > 2.5 && k < 3.5), 0.2) + emit_lobe([0.45, 0.25, 0.09] * select(0.0, 1.0, k > 5.5 && k < 6.5))
  }
}

pub kind Bead @World (c: p3@World, r: m) {
  visible(ro, rd) = ray_sphere(ro, rd, c, r)
  trace(p) = length(p - c) - r
  material(p, n) {
    let catch = pow(max(dot(n, normalize([-0.35, 0.55, 0.75])), 0.0), 60.0)
    let alb = [0.012, 0.010, 0.009]
    let rough = 0.75
    let mid = 19.0
    # FINAL
    ggx(alb, rough, 0.0) + emit_lobe(rgb(3.2 * catch))
  }
}

pub kind Floor @World () {
  visible(ro, rd) = ray_ground(ro, rd, 40m)
  trace(p) = box_sdf(p - [0, -0.5, 0]@World, [40, 0.5, 40])
  material(p, n) {
    let alb = [0.10, 0.11, 0.12]
    let rough = 0.8
    let mid = 16.0
    # FINAL
    ggx(alb, rough, 0.0)
  }
}

# Greatcoat: an oilskin shell 11 mm proud of the hide, too small to close over the belly, collar turned up
# behind the head, sleeves over the flipper roots. Dark green-black, matte, a few big folds, wet at the hem.
pub kind Coat @World (at: p3@World, yaw: f, tip: f, roll: f, stamp: f, whistle: f) {
  trace(p) {
    let q = loc(p, at, yaw)
    let pw = [q.x, q.y, q.z]@World
    let h = hf(q, tip, roll)
    let ra = [0.15, 0.14 + 0.13 * stamp, 0.36 - 0.05 * stamp]
    let re = [0.20, 0.11 + 0.06 * stamp, 0.17]
    let la = [0.0 - 0.17 + 0.07 * whistle, 0.05 + 0.14 * whistle, 0.28 - 0.07 * whistle]
    let le = [0.0 - 0.20, 0.09 + 0.06 * whistle, 0.13]
    let c0 = el(q, [0.0000, 0.1000, -0.0100], [4.7393, 9.0090, 4.9751], 0.1110)
    let c1 = el(q, [0.0000, 0.2000, -0.0400], [5.8480, 6.6225, 6.2112], 0.1510)
    let c2 = el(q, [0.0000, 0.2900, -0.0350], [7.9365, 10.9890, 9.0090], 0.0910)
    let c3 = el(q, [0.0000, 0.0950, 0.0450], [6.6225, 9.4340, 8.6207], 0.1060)
    let c4 = el(q, [0.0750, 0.0500, -0.2400], [12.3457, 18.8679, 7.6336], 0.0530)
    let c5 = el(q, [-0.0750, 0.0500, -0.2400], [12.3457, 18.8679, 7.6336], 0.0530)
    let c6 = el(q, [0.0000, 0.0700, -0.1600], [8.2645, 14.0845, 10.9890], 0.0710)
    # a few big folds: two long sines in the shell, amplitude 4 mm so the bound stays near 1
    let outer = smin(smin(smin(smin(smin(smin(c0, c1, 0.0700), c2, 0.0700), c3, 0.0700), c4, 0.0700), c5, 0.0700), c6, 0.0700) + 0.004 * sin(q.x * 21.0 + q.y * 8.0) + 0.003 * sin(q.y * 17.0 - q.z * 11.0 + 1.3)
    let hem = 0.1050 + 0.005 * sin(q.x * 34.0) + 0.004 * sin(q.z * 27.0 + 1.0)
    let cut = el(h, [0.0000, 0.0000, 0.0390], [8.3612, 7.6923, 6.9930], 0.1196)
    let opening = el(q, [0.0000, 0.1400, 0.1900], [11.7647, 5.0000, 7.1429], 0.0850)
    let vent = round_box(q - [0.0, 0.09, 0.0 - 0.20], [0.010, 0.085, 0.15], 0.004)
    let shell = smax(smax(smax(smax(outer, hem - q.y, 0.012), 0.0 - opening, 0.012), 0.0 - cut, 0.012), 0.0 - vent, 0.006)
    let col_o = el(q, [0.0000, 0.3056, -0.0200], [8.0000, 13.3333, 10.0000], 0.0750)
    let col_i = el(q, [0.0000, 0.3180, 0.0000], [10.6383, 13.1579, 11.9048], 0.0760)
    let collar = smax(smax(col_o, 0.0 - col_i, 0.006), q.z - 0.035, 0.012)
    let wr = [re.x + (ra.x - re.x) * 0.6, re.y + (ra.y - re.y) * 0.6, re.z + (ra.z - re.z) * 0.6]
    let wl = [le.x + (la.x - le.x) * 0.6, le.y + (la.y - le.y) * 0.6, le.z + (la.z - le.z) * 0.6]
    let ndr = normalize([wr.x - re.x, wr.y - re.y, wr.z - re.z])
    let ndl = normalize([wl.x - le.x, wl.y - le.y, wl.z - le.z])
    let slr = smax(smin(capsule(pw, [0.17, 0.15, 0.04]@World, [re.x, re.y, re.z]@World, 0.064), capsule(pw, [re.x, re.y, re.z]@World, [wr.x, wr.y, wr.z]@World, 0.050), 0.03), dot([q.x - wr.x, q.y - wr.y, q.z - wr.z], ndr), 0.004)
    let sll = smax(smin(capsule(pw, [0.0 - 0.17, 0.15, 0.04]@World, [le.x, le.y, le.z]@World, 0.064), capsule(pw, [le.x, le.y, le.z]@World, [wl.x, wl.y, wl.z]@World, 0.050), 0.03), dot([q.x - wl.x, q.y - wl.y, q.z - wl.z], ndl), 0.004)
    smin(smin(smin(shell, collar, 0.012), slr, 0.014), sll, 0.014)
  }
  material(p, n) {
    let q = loc(p, at, yaw)
    let g = vnoise([p.x * 90.0, p.y * 90.0, p.z * 90.0])
    # cracks along the folds: thin dark lines where a low-frequency noise crosses 0.5
    let fold = vnoise([q.x * 5.0, q.y * 26.0, q.z * 5.0])
    let crack = 0.5 * (1.0 - smoothstep(0.0, 0.02, abs(fold - 0.5)))
    let low = 1.0 - smoothstep(0.075, 0.125, q.y)
    let base = [0.022, 0.038, 0.034] * (0.75 + 0.5 * g) * (1.0 - 0.5 * crack)
    let seam = (1.0 - smoothstep(0.0, 0.004, abs(q.x))) * select(0.0, 1.0, q.z < 0.0)
    let belt = (1.0 - smoothstep(0.0, 0.006, abs(q.y - 0.165))) * select(0.0, 1.0, q.z < 0.04)
    let alb = mix(mix(base, [0.012, 0.022, 0.022], low), [0.006, 0.010, 0.010], max(seam, belt))
    let rough = mix(0.82, 0.32, low)
    let wet = low
    let mid = 12.0
    # FINAL
    ggx(alb, rough, 0.0) + coat(0.4 * wet, 0.4) + sheen(alb * 0.5, 0.45)
  }
}

# Crate, open ledger, ink pad and the stamp, all in the figure's local frame.
pub kind Props @World (at: p3@World, yaw: f, stamp: f) {
  trace(p) {
    let q = loc(p, at, yaw)
    let crate = round_box(q - [0.03, 0.03, 0.44], [0.15, 0.03, 0.10], 0.006)
    let cov = round_box(q - [0.03, 0.0625, 0.44], [0.128, 0.0045, 0.088], 0.002)
    let pages = round_box(q - [0.03, 0.0695, 0.44], [0.118, 0.0035, 0.079], 0.001)
    let pad = round_box(q - [-0.085, 0.0765, 0.49], [0.030, 0.006, 0.022], 0.003)
    let sb = round_box(q - [0.15, 0.0815, 0.36], [0.028, 0.006, 0.022], 0.002)
    let sh = round_box(q - [0.15, 0.1035, 0.36], [0.018, 0.022, 0.018], 0.005)
    min(min(min(crate, cov), min(pages, pad)), min(sb, sh))
  }
  material(p, n) {
    let q = loc(p, at, yaw)
    let g = vnoise([p.x * 70.0, p.y * 20.0, p.z * 70.0])
    let crate = round_box(q - [0.03, 0.03, 0.44], [0.15, 0.03, 0.10], 0.006)
    let cov = round_box(q - [0.03, 0.0625, 0.44], [0.128, 0.0045, 0.088], 0.002)
    let pad = round_box(q - [-0.085, 0.0765, 0.49], [0.030, 0.006, 0.022], 0.003)
    let sb = round_box(q - [0.15, 0.0815, 0.36], [0.028, 0.006, 0.022], 0.002)
    let wood = [0.085, 0.058, 0.036] * (0.7 + 0.6 * g) * (0.75 + 0.25 * sin(q.x * 150.0 + 3.0 * g))
    let leather = [0.030, 0.020, 0.014]
    let paper = [0.36, 0.32, 0.24] * (0.9 + 0.2 * g) * (0.8 + 0.2 * smoothstep(0.0, 0.01, abs(q.x - 0.03)))
    let inkpad = [0.012, 0.012, 0.030]
    let rubber = [0.020, 0.018, 0.018]
    var c = paper
    c = select(c, leather, abs(cov) < 0.0015 && n.y < 0.5)
    c = select(c, wood, crate < 0.0015)
    c = select(c, inkpad, pad < 0.0015)
    c = select(c, wood * 0.8, q.y > 0.087 && abs(q.x - 0.15) < 0.019 && abs(q.z - 0.36) < 0.019)
    c = select(c, rubber, sb < 0.0015)
    let alb = c
    let rough = select(0.9, 0.55, abs(cov) < 0.0015)
    let mid = select(select(13.0, 14.0, c.x > 0.3), 11.0, abs(cov) < 0.0015 && n.y < 0.5)
    # FINAL
    ggx(alb, rough, 0.0) + sheen(alb * 0.3, 0.6)
  }
}

# The pier: iced planks across the width, black water beyond, small floes.
pub kind Pier @World () {
  trace(p) = box_sdf(p - [0.0, -0.05, 0.25]@World, [0.95, 0.05, 0.90])
  material(p, n) {
    let pl = floor((p.z + 0.65) / 0.075)
    let fz = fract((p.z + 0.65) / 0.075)
    let hp = fract(sin(pl * 12.9898) * 43758.5453)
    let g = vnoise([p.x * 14.0, pl * 3.0, p.z * 14.0])
    let seam = smoothstep(0.0, 0.06, fz) * (1.0 - smoothstep(0.94, 1.0, fz))
    let wood = [0.060, 0.052, 0.046] * (0.7 + 0.6 * hp) * (0.6 + 0.8 * g)
    let ice = smoothstep(0.55, 0.75, vnoise([p.x * 4.0 + 3.0, pl * 5.0, p.z * 30.0]) + 0.20 * (hp - 0.5) + 0.25 * (1.0 - seam))
    let alb = mix(wood, [0.42, 0.50, 0.58], ice * seam) * (0.35 + 0.65 * seam)
    let rough = mix(0.85, 0.55, ice * seam)
    let mid = select(16.0, 17.0, ice * seam > 0.5)
    # FINAL
    ggx(alb, rough, 0.0) + sheen(alb * 0.3, 0.6)
  }
}

pub kind Water @World () {
  visible(ro, rd) = ray_ground(ro, rd, 40m)
  trace(p) = box_sdf(p - [0, -0.62, 0]@World, [40, 0.5, 40])
  material(p, n) {
    let w = vnoise([p.x * 7.0, 0.0, p.z * 7.0]) + 0.5 * vnoise([p.x * 19.0, 3.0, p.z * 17.0])
    let alb = [0.012, 0.022, 0.030] * (0.7 + 0.6 * w)
    let rough = 0.6
    let mid = 18.0
    # FINAL
    ggx(alb, rough, 0.0)
  }
}

pub kind Floe @World (c: p3@World, half: rgb) {
  trace(p) = round_box(p - c, half, 0.012)
  material(p, n) {
    let alb = [0.50, 0.58, 0.64]
    let rough = 0.65
    let mid = 17.0
    # FINAL
    ggx(alb, rough, 0.0)
  }
}


fn hash(x: f) -> f {
  fract(sin(x * 12.9898) * 43758.5453)
}

# The figure: Hide plus the rods and beads that depend on the head's pose.
pub build fn odd(at: p3@World, yaw: f, tip: f, roll: f, stamp: f, whistle: f) {
  emit Hide(at: at, yaw: yaw, tip: tip, roll: roll, stamp: stamp, whistle: whistle)
  emit Cap(at: at, yaw: yaw, tip: tip, roll: roll)
  emit Coat(at: at, yaw: yaw, tip: tip, roll: roll, stamp: stamp, whistle: whistle)
  emit Rod(a: wld(at, yaw, [0.0966, 0.0756, 0.1746]), b: wld(at, yaw, [0.0988, 0.0740, 0.1794]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [0.1005, 0.1146, 0.1748]), b: wld(at, yaw, [0.1028, 0.1157, 0.1796]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [0.1010, 0.1539, 0.1549]), b: wld(at, yaw, [0.1032, 0.1569, 0.1590]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [0.0908, 0.2342, 0.0976]), b: wld(at, yaw, [0.0935, 0.2364, 0.1019]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.0966, 0.0756, 0.1746]), b: wld(at, yaw, [-0.0988, 0.0740, 0.1794]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.1010, 0.1539, 0.1549]), b: wld(at, yaw, [-0.1032, 0.1569, 0.1590]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.0979, 0.1938, 0.1232]), b: wld(at, yaw, [-0.1002, 0.1971, 0.1269]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.0908, 0.2342, 0.0976]), b: wld(at, yaw, [-0.0935, 0.2364, 0.1019]), r: 0.0062, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.0950, 0.2150, 0.0960]), b: wld(at, yaw, [-0.0713, 0.1884, 0.1316]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [-0.0713, 0.1884, 0.1316]), b: wld(at, yaw, [-0.0475, 0.1644, 0.1598]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [-0.0475, 0.1644, 0.1598]), b: wld(at, yaw, [-0.0237, 0.1453, 0.1775]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [-0.0237, 0.1453, 0.1775]), b: wld(at, yaw, [0.0000, 0.1325, 0.1861]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0000, 0.1325, 0.1861]), b: wld(at, yaw, [0.0237, 0.1266, 0.1875]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0237, 0.1266, 0.1875]), b: wld(at, yaw, [0.0475, 0.1269, 0.1836]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0475, 0.1269, 0.1836]), b: wld(at, yaw, [0.0713, 0.1322, 0.1746]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0713, 0.1322, 0.1746]), b: wld(at, yaw, [0.0950, 0.1400, 0.1601]), r: 0.0017, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0595, 0.1089, 0.1866]), b: wld(at, yaw, [0.0572, 0.1160, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0572, 0.1160, 0.1866]), b: wld(at, yaw, [0.0512, 0.1203, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0512, 0.1203, 0.1866]), b: wld(at, yaw, [0.0438, 0.1203, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0438, 0.1203, 0.1866]), b: wld(at, yaw, [0.0378, 0.1160, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0378, 0.1160, 0.1866]), b: wld(at, yaw, [0.0355, 0.1089, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0355, 0.1089, 0.1866]), b: wld(at, yaw, [0.0378, 0.1019, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0378, 0.1019, 0.1866]), b: wld(at, yaw, [0.0438, 0.0975, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0438, 0.0975, 0.1866]), b: wld(at, yaw, [0.0512, 0.0975, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0512, 0.0975, 0.1866]), b: wld(at, yaw, [0.0572, 0.1019, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0572, 0.1019, 0.1866]), b: wld(at, yaw, [0.0595, 0.1089, 0.1866]), r: 0.0015, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0375, 0.0989, 0.1876]), b: wld(at, yaw, [0.0375, 0.0649, 0.1886]), r: 0.0022, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0335, 0.0649, 0.1886]), b: wld(at, yaw, [0.0415, 0.0689, 0.1886]), r: 0.0035, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0475, 0.0989, 0.1876]), b: wld(at, yaw, [0.0475, 0.0589, 0.1886]), r: 0.0022, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0435, 0.0589, 0.1886]), b: wld(at, yaw, [0.0515, 0.0629, 0.1886]), r: 0.0035, mat: 4.0)
  emit Rod(a: wld(at, yaw, [0.0585, 0.0989, 0.1876]), b: wld(at, yaw, [0.0585, 0.0689, 0.1886]), r: 0.0022, mat: 1.0)
  emit Rod(a: wld(at, yaw, [0.0545, 0.0689, 0.1886]), b: wld(at, yaw, [0.0625, 0.0729, 0.1886]), r: 0.0035, mat: 1.0)
  let wl = [0.0 - 0.17 + 0.07 * whistle, 0.05 + 0.14 * whistle, 0.28 - 0.07 * whistle]
  emit Rod(a: wld(at, yaw, wl + [0.0, 0.026, 0.008]), b: wld(at, yaw, wl + [0.0, 0.026, 0.034]), r: 0.0052, mat: 1.0)
  emit Rod(a: wld(at, yaw, wl + [0.0, 0.026, 0.034]), b: wld(at, yaw, wl + [0.0, 0.026, 0.040]), r: 0.0034, mat: 1.0)
  emit Rod(a: wld(at, yaw, wl + [0.0, 0.026, 0.008]), b: wld(at, yaw, [0.0 - 0.05, 0.27, 0.06]), r: 0.0008, mat: 5.0)
  # anchor badge on the band: shank, stock, flukes
  emit Rod(a: wld(at, yaw, hq([0.0000, 0.1613, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0000, 0.1122, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0097, 0.1490, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0097, 0.1490, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0000, 0.1122, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0088, 0.1043, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0088, 0.1043, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0193, 0.1060, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0193, 0.1060, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0272, 0.1157, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0272, 0.1157, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0290, 0.1262, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0000, 0.1122, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0088, 0.1043, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0088, 0.1043, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0193, 0.1060, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0193, 0.1060, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0272, 0.1157, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0272, 0.1157, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0290, 0.1262, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0056, 0.1669, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0028, 0.1718, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0028, 0.1718, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0028, 0.1718, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0028, 0.1718, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0056, 0.1669, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0056, 0.1669, 0.0540], tip, roll)), b: wld(at, yaw, hq([-0.0028, 0.1621, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([-0.0028, 0.1621, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0028, 0.1621, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  emit Rod(a: wld(at, yaw, hq([0.0028, 0.1621, 0.0540], tip, roll)), b: wld(at, yaw, hq([0.0056, 0.1669, 0.0540], tip, roll)), r: 0.0017, mat: 1.0000)
  # eyes
  build for s in 0..2 {
    let sx = select(-1.0, 1.0, s == 1)
    let e = hq([sx * 0.0273, 0.0533, 0.0936], tip, roll)
    emit Bead(c: wld(at, yaw, e), r: 0.0111)
  }
  # tusks: a curved capsule chain each, hanging down from the head's pose. Right: ivory with a brass ferrule on the tip.
  # Left: chipped short, a mismatched tarnished cap partway down.
  build for s in 0..2 {
    let sx = select(-1.0, 1.0, s == 1)
    let b = hq([sx * 0.0572, -0.0494, 0.1404], tip, roll)
    let len = 0.1800 * select(1.0, 0.92, s == 0)
    let m1 = b + [sx * 0.010, 0.0 - 0.28 * len, 0.40 * 0.0200]
    let m2 = b + [sx * 0.016, 0.0 - 0.56 * len, 0.76 * 0.0200]
    let m3 = b + [sx * 0.020, 0.0 - 0.80 * len, 0.96 * 0.0200]
    let t = b + [sx * 0.020, 0.0 - len, 0.0200]
    emit Rod(a: wld(at, yaw, b), b: wld(at, yaw, m1), r: 0.0150, mat: 0.0)
    emit Rod(a: wld(at, yaw, m1), b: wld(at, yaw, m2), r: 0.0125, mat: 0.0)
    emit Rod(a: wld(at, yaw, m2), b: wld(at, yaw, m3), r: select(0.0108, 0.0120, s == 0), mat: select(0.0, 2.0, s == 0))
    emit Rod(a: wld(at, yaw, m3), b: wld(at, yaw, t), r: select(0.0100, 0.0082, s == 0), mat: select(0.0, 1.0, s == 1))
  }
  # claws: dark horn rods on each toe
  build for s in 0..2 {
    let pw = select(0.0 - 1.0, 1.0, s == 1)
    let pr = select([0.0 - 0.17 + 0.07 * whistle, 0.05 + 0.14 * whistle, 0.28 - 0.07 * whistle], [0.15, 0.135 + 0.13 * stamp, 0.30 - 0.05 * stamp], s == 1)
    build for j in 0..4 {
      let dx = (f32(j) - 1.5) * 0.0225
      let tz = 0.064 + 0.008 * select(1.0, 0.0, j == 0 || j == 3)
      let b0 = pr + [dx, 0.0 - 0.012, tz + 0.012]
      let b1 = pr + [dx * 1.15, 0.0 - 0.016, tz + 0.034]
      emit Rod(a: wld(at, yaw, b0), b: wld(at, yaw, b1), r: 0.0042, mat: 10.0)
    }
  }
  # moustache bristles: short stiff rods on the pad ellipsoid of each side
  build for s in 0..2 {
    let sx = select(-1.0, 1.0, s == 1)
    build for i in 0..520 {
      let z = f32(i) + 7.0 * f32(s)
      let a = hash(z * 1.7) - 0.5
      let b = hash(z * 3.1 + 5.0) - 0.5
      # roots on the moustache slab (a rounded box: inner half-sizes hi, corner radius rr), spread over its whole front
      let u = normalize([sx * (0.12 + 1.5 * abs(a)), 1.5 * b + 0.15, 0.9])
      let hi = [0.0806, 0.0052, 0.0052]
      let surf = [0.0, -0.0390, 0.1196] + max(min(u * 0.08, hi), 0.0 - hi) + u * 0.0390
      let nrm = u
      let dir = normalize(nrm * 0.95 + [sx * (0.20 + 0.3 * a), 0.0 - 0.75, 0.10 * b])
      let ln = 0.030 + 0.022 * hash(z * 9.3)
      let r0 = hq(surf - nrm * 0.004, tip, roll)
      let r1 = hq(surf + dir * ln, tip, roll)
      emit Rod(a: wld(at, yaw, r0), b: wld(at, yaw, r1), r: 0.0013, mat: 3.0)
    }
  }
}

# The desk: crate, ledger, ink pad, stamp, lantern.
pub build fn desk(at: p3@World, yaw: f, stamp: f) {
  emit Rod(a: wld(at, yaw, [-0.2350, 0.0040, 0.4300]), b: wld(at, yaw, [-0.2350, 0.0140, 0.4300]), r: 0.0190, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.2350, 0.0300, 0.4300]), b: wld(at, yaw, [-0.2350, 0.0620, 0.4300]), r: 0.0160, mat: 6.0)
  emit Rod(a: wld(at, yaw, [-0.2350, 0.0800, 0.4300]), b: wld(at, yaw, [-0.2350, 0.0880, 0.4300]), r: 0.0170, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.2350, 0.0970, 0.4300]), b: wld(at, yaw, [-0.2350, 0.1000, 0.4300]), r: 0.0080, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.2510, 0.0300, 0.4300]), b: wld(at, yaw, [-0.2510, 0.0800, 0.4300]), r: 0.0014, mat: 1.0)
  emit Rod(a: wld(at, yaw, [-0.2190, 0.0300, 0.4300]), b: wld(at, yaw, [-0.2190, 0.0800, 0.4300]), r: 0.0014, mat: 1.0)
  emit Props(at: at, yaw: yaw, stamp: stamp)
}

pub build fn ground() {
  emit Pier()
  emit Water()
  emit Floe(c: [-1.3, -0.11, 0.6]@World, half: [0.170, 0.025, 0.136])
  emit Floe(c: [1.25, -0.11, 0.2]@World, half: [0.200, 0.025, 0.160])
  emit Floe(c: [-1.0, -0.11, -0.3]@World, half: [0.130, 0.025, 0.104])
  emit Floe(c: [1.5, -0.11, 1.2]@World, half: [0.260, 0.025, 0.208])
  emit Floe(c: [0.2, -0.11, 1.7]@World, half: [0.220, 0.025, 0.176])
  emit Floe(c: [-0.4, -0.11, 2.1]@World, half: [0.300, 0.025, 0.240])
  emit Sun(dir: dir([-0.6000, 0.3000, -0.7000]@World), color: [1.6000, 0.8500, 0.4000])
  emit Sky(zenith: [0.0200, 0.0400, 0.0950], horizon: [0.0750, 0.1150, 0.1650])
}

# Light: the sun (low, warm, behind to his right), the sky by the stock twelve-patch quadrature, and the lantern as a
# second unshadowed directional light from low in front on his left. Lobes stay broad, so the patches never show.
pub fn night(b: Bsdf, n: rgb, v: rgb, sun: rgb, shadow: f, ao: f) -> rgb {
  var c = rgb(0.0)
  for i in 0..15 {
    var l = rgb(0.0)
    var e = rgb(1.0)
    if i == 1 {
      l = sun
      e = sun_color() * shadow
    }
    if i == 14 {
      l = normalize([-0.5500, -0.1500, 0.8000])
      e = [1.0000, 0.5500, 0.2200]
    }
    if i >= 2 && i < 14 {
      l = sky_patch(u32(i - 2))
      e = sky_dome(l) * (0.85 * 1.0471976 * ao)
    }
    c = c + eval_bsdf(b, n, v, l) * e
  }
  c
}

# A scene lists these kinds in its own schedule (the engine cannot export a kind group, see LOG Engine gaps).
