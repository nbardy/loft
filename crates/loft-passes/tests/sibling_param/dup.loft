# F9a: worker A's workaround: the entry declares a second param with the sibling's name.
use stdlib::materials::bsdf::{lambert}
use self::shot::{radius}
param size: f = 1.0 in 0.1..3.0
kind K @World () {
  trace(p) = (length(coords(p)) - 1.0) * radius() * size
  material(p, n) = lambert(rgb(0.5))
}
build { emit K() }
