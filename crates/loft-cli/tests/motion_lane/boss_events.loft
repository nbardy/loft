space World
kind Impact @World (phase: f = 0, toe: f = 0, anchor: f = 0) {}

law impulse(h: Impact, dt) writes h.{phase} {
  h.phase = fma(2.0, dt, h.phase)
  if time == 3.0 * dt && h.phase < 1.0 {
    emit_event(ClawHit, 0, 1, [0.5, 1.0, 0.25, 2.0])
  }
}

law slip(h: Impact, dt) writes h.{toe} {
  h.toe = fma(sin(time), dt, h.phase * 0.25)
  if time == 4.0 * dt && h.phase < 1.0 {
    emit_event(FootSlip, 0, 3, [0.25, 0.0, 0.5, 0.02])
  }
}

build { emit Impact(); emit Impact(phase: 1) }
schedule Main { run_laws(impulse); run_laws(slip) }
