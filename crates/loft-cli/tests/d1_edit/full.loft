kind EditSphere @World (shift: p3@World) {
  trace(p) {
    let x = p.x
    let shape = sphere(p - shift, 0.64)
    let d0 = abs(x - 0.000)
    let d1 = abs(x - 0.001)
    let d2 = abs(x - 0.002)
    let d3 = abs(x - 0.003)
    let d4 = abs(x - 0.004)
    let d5 = abs(x - 0.005)
    let d6 = abs(x - 0.006)
    let d7 = abs(x - 0.007)
    let d8 = abs(x - 0.008)
    let d9 = abs(x - 0.009)
    let d10 = abs(x - 0.010)
    let d11 = abs(x - 0.011)
    let d12 = abs(x - 0.012)
    let d13 = abs(x - 0.013)
    shape + min(min(min(min(min(min(min(min(min(min(min(min(min(d0, d1), d2), d3), d4), d5), d6), d7), d8), d9), d10), d11), d12), d13)
  }
  material(p, n) = ggx([0.38, 0.62, 0.8], 0.48, 0.12)
}
build { emit EditSphere(shift: [0.0, 0.0, 0.0]@World) }
camera Main { at: [0, 0, 0]@World, radius: 3.6, height: 0.0, period: 24, fov: 1deg }
