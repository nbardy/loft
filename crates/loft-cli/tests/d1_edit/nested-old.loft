kind EditSphere @World (shift: p3@World) {
  trace(p) = sphere(p - shift, 0.59)
  material(p, n) = ggx([0.38, 0.62, 0.8], 0.48, 0.12)
}
kind Clean @World (shift: p3@World) {
  trace(p) = sphere(p - shift, 0.19)
  material(p, n) = ggx([0.72, 0.35, 0.25], 0.52, 0.0)
}
build {
  emit EditSphere(shift: [0.0, 0.0, 0.0]@World)
  emit EditSphere(shift: [0.33, -0.42, 0.08]@World)
  emit Clean(shift: [0.92, 0.31, 0.0]@World)
}
camera Main { at: [0, 0, 0]@World, radius: 3.6, height: 0.8, period: 24, fov: 40deg }
