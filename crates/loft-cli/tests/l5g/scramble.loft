# L23c crab scramble with a timed host velocity parameter.
space World

param scramble_speed: f = -0.6 in -0.6..0.6

fn replay_capture_point_ff[S](pos: p3@S, vel: v3@S, h: m, a_cmd: v3@S,
                           v_s: v3@S, a_s: v3@S, g_eff: v3@S) -> p3@S {
  let up = normalize(g_eff)
  let tc2 = h / length(g_eff)
  let lead = (vel - v_s) * sqrt(tc2) + (a_cmd - a_s) * (0.5 * tc2)
  pos + (lead - up * dot(lead, up))
}

fn replay_quintic_plan(d: m, v1: f, dur: s, t: s) -> v3 {
  let u = clamp(t / dur, 0.0, 1.0)
  let v = v1 * dur
  let a = 10.0 * d - 4.0 * v
  let b = -15.0 * d + 7.0 * v
  let c = 6.0 * d - 3.0 * v
  [u * u * u * (a + u * (b + u * c)),
   u * u * (3.0 * a + u * (4.0 * b + u * 5.0 * c)) / dur,
   u * (6.0 * a + u * (12.0 * b + u * 20.0 * c)) / (dur * dur)]
}

fn replay_ik_reachable_end[S](root: p3@S, tgt: p3@S, l1: m, l2: m, pole: d3@S) -> p3@S {
  let delta = tgt - root
  let n = length(delta)
  let axis = if n > 0.0 { delta / n } else { pole * 1.0 }
  root + axis * clamp(n, abs(l1 - l2), l1 + l2)
}

fn replay_solve_2bone_ik[S](root: p3@S, end: p3@S, l1: m, l2: m, pole: d3@S) -> p3@S {
  let d = dist(root, end)
  if d <= 0.0 { return root + pole * l1 }
  let along = (end - root) / d
  let projected = pole * 1.0 - along * dot(pole, along)
  let xyz = along.xyz
  let seed = if abs(xyz.x) < abs(xyz.y) {
    [1.0, 0.0, 0.0]@S
  } else {
    [0.0, 1.0, 0.0]@S
  }
  let side = if length(projected) > 1e-6 { dir(projected) } else { dir(cross(along, seed - [0.0, 0.0, 0.0]@S)) }
  let span = (d * d + l1 * l1 - l2 * l2) / (2.0 * d)
  root + along * span + side * sqrt(max(0.0, l1 * l1 - span * span))
}

fn replay_roam_accel(x: m, v: f, go: f, h: m, lo: m, hi: m, limit: f) -> f {
  let want = clamp((go - v) / 0.12s, -limit, limit)
  let scale = h / 9.81
  (x - clamp(x - want * scale, lo, hi)) / scale
}

fn replay_roam_swing(a_pin: m, b_pin: m, phase: f, group: f, aim: m,
                  capture: m, strain: m, dt: s, duration: s) -> v3 {
  let advance = dt / duration
  if phase > 0.0 { return [min(1.0, phase + advance), group, aim] }
  let a = abs(a_pin - capture)
  let b = abs(b_pin - capture)
  if max(a, b) <= strain { return [0.0, group, aim] }
  let next = if a == b { 1.0 - group } else { select(1.0, 0.0, a > b) }
  [advance, next, capture]
}

fn replay_roam_toe(anchor: m, aim: m, phase: f, active: bool, lift: m) -> v2 {
  if !active || phase == 0.0 { return [anchor, 0.0] }
  let bell = 4.0 * phase * (1.0 - phase)
  [anchor + replay_quintic_plan(aim - anchor, 0.0, 1s, phase).x, lift * bell * bell]
}

const CRAB_HEIGHT = 0.49m
const CRAB_WIDTH = 0.82m
const CRAB_TOE_R = 0.025m
const CRAB_LONG = 0.68m
const CRAB_SHORT = 0.48m

# The eight sockets alternate groups on each side. Either group spans the
# centre line on both sides, so its x interval at z = 0 is [pin-width, pin+width].
fn crab_group(i: u) -> f = f32((i + i / 4) % 2)
fn crab_side(i: u) -> f = select(-1.0, 1.0, i >= 4)
fn crab_depth(i: u) -> f = (f32(i % 4) - 1.5) * 0.22m

kind Scramble @World (
  x: f = 0.0, vx: f = 0.6, a_pin: f = 0.0, b_pin: f = 0.0,
  phase: f = 0.0, swing: f = 0.0, aim: f = 0.0,
  toe_bias: f = 0.0
) {
  trace(p) {
    let trunk = [x, CRAB_HEIGHT, 0.0]@World
    var d = round_box(p - trunk, [0.38, 0.19, 0.46], 0.12)
    for i in 0..8 {
      let hip = crab_hip(self, i)
      let toe = crab_end(self, i)
      let knee = replay_solve_2bone_ik(hip, toe, CRAB_SHORT, CRAB_LONG, crab_pole(i))
      d = min(d, min(capsule(p, hip, knee, 0.055), capsule(p, knee, toe, CRAB_TOE_R)))
    }
    for i in 0..2 {
      let s = select(-1.0, 1.0, i == 1)
      let palm = trunk + [s * 0.41, -0.065, 0.42]
      d = min(d, capsule(p, trunk + [s * 0.27, 0, 0.2], palm, 0.085))
      d = min(d, capsule(p, palm, palm + [s * 0.05, -0.03, 0.22], 0.11))
      let eye = trunk + [s * 0.14, 0.19, 0.32]
      d = min(d, capsule(p, trunk + [s * 0.14, 0.08, 0.30], eye, 0.027))
      d = min(d, sphere(p - eye, 0.045))
    }
    d
  }
  material(p, n) {
    let light = smoothstep(0.10, CRAB_HEIGHT + 0.16, p.y)
    let freckles = 0.85 + 0.25 * fbm2([p.x, 0.0, p.z] * 18.0)
    ggx(mix([0.20, 0.048, 0.025], [0.75, 0.21, 0.086], light) * freckles, 0.34, 0) +
      coat(0.45, 0.12)
  }
}

fn crab_hip(h: Scramble, i: u) -> p3@World =
  [h.x + crab_side(i) * 0.24, CRAB_HEIGHT, 0.82 * crab_depth(i)]@World
fn crab_pole(i: u) -> d3@World = dir([crab_side(i) * 0.4, 1.0, 0.0]@World)

fn crab_anchor(h: Scramble, i: u) -> m = select(h.a_pin, h.b_pin, crab_group(i) == 1.0)

fn crab_end(h: Scramble, i: u) -> p3@World {
  let swing = replay_roam_toe(crab_anchor(h, i), h.aim, h.phase, crab_group(i) == h.swing, 0.095m)
  let toe = [swing.x + crab_side(i) * CRAB_WIDTH + h.toe_bias, CRAB_TOE_R + swing.y, crab_depth(i)]@World
  replay_ik_reachable_end(crab_hip(h, i), toe, CRAB_SHORT, CRAB_LONG, crab_pole(i))
}

law scramble_step(h: Scramble, dt) writes h.{x, vx, a_pin, b_pin, phase, swing, aim} {
  let lo = if h.phase > 0.0 { select(h.a_pin, h.b_pin, h.swing == 0.0) } else { min(h.a_pin, h.b_pin) }
  let hi = if h.phase > 0.0 { select(h.a_pin, h.b_pin, h.swing == 0.0) } else { max(h.a_pin, h.b_pin) }
  let accel = replay_roam_accel(h.x, h.vx, scramble_speed, CRAB_HEIGHT, lo - CRAB_WIDTH, hi + CRAB_WIDTH, 6.0)
  let cp = replay_capture_point_ff([h.x, CRAB_HEIGHT, 0.0]@World,
    [h.vx, 0.0, 0.0]@World - [0.0, 0.0, 0.0]@World, CRAB_HEIGHT,
    [accel, 0.0, 0.0]@World - [0.0, 0.0, 0.0]@World,
    [0.0, 0.0, 0.0]@World - [0.0, 0.0, 0.0]@World,
    [0.0, 0.0, 0.0]@World - [0.0, 0.0, 0.0]@World,
    [0.0, -9.81, 0.0]@World - [0.0, 0.0, 0.0]@World)
  let step = replay_roam_swing(h.a_pin, h.b_pin, h.phase, h.swing, h.aim, cp.x, 0.087m, dt, 0.10s)
  let landed = step.x == 1.0
  h.x = h.x + dt * (h.vx + 0.5 * dt * accel)
  h.vx = h.vx + dt * accel
  h.a_pin = select(h.a_pin, step.z, landed && step.y == 0.0)
  h.b_pin = select(h.b_pin, step.z, landed && step.y == 1.0)
  h.phase = select(step.x, 0.0, landed)
  h.swing = step.y
  h.aim = step.z
}

check crab_planted(h: Scramble) -> m {
  var drift = 0.0
  for i in 0..8 {
    let anchor = [crab_anchor(h, i) + crab_side(i) * CRAB_WIDTH, CRAB_TOE_R, crab_depth(i)]@World
    let error = dist(crab_end(h, i), anchor)
    drift = max(drift, select(error, 0.0, h.phase > 0.0 && crab_group(i) == h.swing))
  }
  return if drift > 0.05mm { missed(drift) } else { held(0.05mm - drift) }
}

check crab_clearance(h: Scramble) -> m {
  var clearance = CRAB_HEIGHT
  for i in 0..8 { clearance = min(clearance, crab_end(h, i).y - CRAB_TOE_R) }
  return if clearance < -2mm { missed(-clearance) } else { held(clearance + 2mm) }
}

kind ScrambleBed @World () {
  trace(p) = box_sdf(p - [-0.8, -0.06, 0.0]@World, [4.8, 0.06, 3.0])
  material(p, n) = ggx([0.29, 0.23, 0.17] * (0.84 + 0.29 * fbm2([p.x, 0.0, p.z] * 5.0)), 0.84, 0)
}

camera Main { at: [-0.25, 0.45, 0.0]@World, radius: 3.5m, height: 1.25m, period: 24s, fov: 40deg }
build { emit Scramble(); emit ScrambleBed() }
schedule Main {
  run_laws(scramble_step)
  check(crab_planted, crab_clearance)
}
