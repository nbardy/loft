space World
param drive: f = 1.0 in 0.0..4.0
kind Accum @World (x: f = 0.0) {
  trace(p) = sphere(p - [0.0, 0.0, 0.0]@World, 0.25)
  material(p,n) = ggx([0.5,0.5,0.5], 0.4, 0.0)
}
law add_drive(h: Accum, dt) writes h.{x} { h.x = h.x + drive }
check never_two(h: Accum) -> f {
  if h.x == 2.0 { missed(1.0) } else { held(1.0) }
}
check tick_zero_input(h: Accum) -> f {
  if time == 0s && drive == 0.0 { missed(1.0) } else { held(1.0) }
}
build { emit Accum() }
schedule Main {
  run_laws(add_drive)
  check(never_two, tick_zero_input)
}
