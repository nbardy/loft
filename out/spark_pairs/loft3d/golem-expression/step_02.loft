use stdlib::geometry::analytic::{ray_capsule}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

# golem-expression chain: fixed round body, face goes stern -> beaming.
# Mouth corners rise with f, pupils widen and warm. Mirrors the
# golem-expression/step_XX.png renders (same t index).

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

param step: u = 2 in 0..8

build fn axis_f(step: u) -> f {
  f32(step) / 8.0
}

build {
  let f = axis_f(step)
  let c = [0.0, 0.0, 0.0]@World
  let skin = [0.58, 0.54, 0.48]
  # compact body below a huge head: the face is the subject here
  emit Capsule(a: c + [-0.20, 0.55, 0], b: c + [-0.20, 0.05, 0], r: 0.13m, albedo: skin * 0.8)
  emit Capsule(a: c + [0.20, 0.55, 0], b: c + [0.20, 0.05, 0], r: 0.13m, albedo: skin * 0.8)
  emit Capsule(a: c + [0.0, 0.55, 0], b: c + [0.0, 1.45, 0], r: 0.42m, albedo: skin)
  # arms: slumped at hips -> thrown high in a cheer (the big motion)
  let hx = 0.68 + 0.17 * f
  let hy = 0.80 + 1.80 * f
  emit Capsule(a: c + [-0.50, 1.35, 0], b: c + [-hx, hy, 0.10], r: 0.11m, albedo: skin * 0.9)
  emit Capsule(a: c + [0.50, 1.35, 0], b: c + [hx, hy, 0.10], r: 0.11m, albedo: skin * 0.9)
  # massive head bar fills the frame
  emit Capsule(a: c + [-0.36, 2.00, 0], b: c + [0.36, 2.00, 0], r: 0.34m, albedo: skin * 1.08)
  # eyes pop: shutters narrow -> wide amber headlamps
  let pr = 0.05m + 0.06m * f
  emit Capsule(a: c + [-0.19, 2.02, 0.30], b: c + [-0.19, 2.02, 0.30], r: pr, albedo: [1.0, 0.62, 0.15])
  emit Capsule(a: c + [0.19, 2.02, 0.30], b: c + [0.19, 2.02, 0.30], r: pr, albedo: [1.0, 0.62, 0.15])
  # brow: slammed low over the eyes -> flung high in delight
  let brow = 2.06 + 0.30 * f
  emit Capsule(a: c + [-0.38, brow, 0.30], b: c + [0.38, brow, 0.30], r: 0.05m, albedo: skin * 0.65)
  # mouth: pressed flat line -> wide shallow grin, wider than the eyes
  let corner = 1.74 + 0.12 * f
  let mid = 1.74 - 0.08 * f
  emit Capsule(a: c + [0.0, mid, 0.32], b: c + [-0.34, corner, 0.32], r: 0.045m, albedo: [0.24, 0.19, 0.15])
  emit Capsule(a: c + [0.0, mid, 0.32], b: c + [0.34, corner, 0.32], r: 0.045m, albedo: [0.24, 0.19, 0.15])
}

schedule Main {
  orbit(at: [0, 1.7, 0]@World, radius: 3.6m, height: 2.0m, period: 24.0s, fov: 40deg)
  cull_indirect(Capsule)
  render_bundle(Vis64) { draw_indirect(Capsule) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
