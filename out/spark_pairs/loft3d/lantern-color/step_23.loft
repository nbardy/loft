use stdlib::geometry::analytic::{ray_capsule}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::math::sampling::{sample_key}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

# lantern-color chain: paper lantern whose glow cools amber -> moonlight.
# Warm core always on; cool shell panels take over with f via seeded keep
# rolls, and the paper albedo lerps per channel. Mirrors the
# lantern-color/step_XX.png renders (same t index).

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

param step: u = 23 in 0..40

build fn axis_f(step: u) -> f {
  f32(step) / 40.0
}

build fn shell_roll(slot: u) -> u {
  u32(sample_key(7, slot, 1, 0, 7) * 100.0)
}

build {
  let f = axis_f(step)
  let c = [0.0, 1.6, 0.0]@World
  # paper body: warm cream -> cool moon-paper, per-channel lerp (mid-tones
  # so the sun does not wash it white)
  let paper = [0.88 - 0.26 * f, 0.74 - 0.04 * f, 0.55 + 0.27 * f]
  emit Capsule(a: c + [0.0, -0.30, 0], b: c + [0.0, 0.30, 0], r: 0.30m, albedo: paper)
  # warm core glow sits proud of the paper front, always on (identity anchor)
  emit Capsule(a: c + [0.0, -0.05, 0.26], b: c + [0.0, -0.05, 0.26], r: 0.12m, albedo: [1.0, 0.62, 0.20])
  # cool shell ribs ring the paper and take over with f
  let keep = u32(100.0 * f)
  build for slot in 0..8 {
    if shell_roll(slot) < keep {
      let a = f32(slot) * 0.785
      let x = 0.52 * cos(a)
      let z = 0.52 * sin(a)
      emit Capsule(a: c + [x, -0.24, z], b: c + [x, 0.24, z], r: 0.045m, albedo: [0.55, 0.70, 1.0])
    }
  }
  # cap + tassel cord, fixed
  emit Capsule(a: c + [-0.18, 0.66, 0], b: c + [0.18, 0.66, 0], r: 0.07m, albedo: [0.35, 0.27, 0.21])
  emit Capsule(a: c + [0.0, -0.62, 0], b: c + [0.0, -1.05, 0], r: 0.03m, albedo: [0.47, 0.35, 0.27])
}

schedule Main {
  orbit(at: [0, 1.2, 0]@World, radius: 4.0m, height: 1.8m, period: 24.0s, fov: 40deg)
  cull_indirect(Capsule)
  render_bundle(Vis64) { draw_indirect(Capsule) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
