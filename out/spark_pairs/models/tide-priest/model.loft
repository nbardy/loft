use stdlib::geometry::analytic::{ray_capsule}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

# tide-priest: robed oracle of the shallows, shell staff raised. Base model.

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

kind GlossBead @World (c: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, c, c, r)
  }
  trace(p) {
    capsule(p, c, c, r)
  }
  material(p, n) {
    ggx(albedo, 0.12, 0)
  }
}

build {
  let c = [0.0, 0.0, 0.0]@World
  let robe = [0.25, 0.42, 0.45]
  # sea-green robe to the ground, wide sleeves lifted in blessing
  emit Capsule(a: c + [0.0, 0.70, 0], b: c + [0.0, 0.05, 0], r: 0.36m, albedo: robe * 0.85)
  emit Capsule(a: c + [0.0, 0.65, 0], b: c + [0.0, 1.55, 0], r: 0.34m, albedo: robe)
  emit Capsule(a: c + [-0.32, 1.50, 0.05], b: c + [-0.62, 1.95, 0.10], r: 0.10m, albedo: robe * 0.9)
  emit Capsule(a: c + [0.32, 1.50, 0.05], b: c + [0.44, 1.10, 0.30], r: 0.10m, albedo: robe * 0.9)
  # cowled head, serene closed-eye calm: two lowered lash bars
  emit GlossBead(c: c + [0.0, 1.95, 0], r: 0.26m, albedo: robe * 1.1)
  emit Capsule(a: c + [-0.16, 1.93, 0.24], b: c + [-0.04, 1.91, 0.24], r: 0.025m, albedo: [0.12, 0.18, 0.20])
  emit Capsule(a: c + [0.04, 1.91, 0.24], b: c + [0.16, 1.93, 0.24], r: 0.025m, albedo: [0.12, 0.18, 0.20])
  # pearl circlet across the brow
  emit GlossBead(c: c + [-0.12, 2.08, 0.20], r: 0.04m, albedo: [0.92, 0.90, 0.84])
  emit GlossBead(c: c + [0.0, 2.10, 0.22], r: 0.045m, albedo: [0.92, 0.90, 0.84])
  emit GlossBead(c: c + [0.12, 2.08, 0.20], r: 0.04m, albedo: [0.92, 0.90, 0.84])
  # shell staff in the raised hand: pole + spiral of shrinking shells + orb
  emit Capsule(a: c + [-0.62, 0.80, 0.10], b: c + [-0.62, 2.30, 0.10], r: 0.035m, albedo: [0.55, 0.42, 0.28])
  emit GlossBead(c: c + [-0.62, 2.38, 0.10], r: 0.10m, albedo: [0.88, 0.80, 0.68])
  emit GlossBead(c: c + [-0.62, 2.52, 0.10], r: 0.07m, albedo: [0.88, 0.80, 0.68])
  emit GlossBead(c: c + [-0.62, 2.62, 0.10], r: 0.045m, albedo: [0.88, 0.80, 0.68])
  emit GlossBead(c: c + [-0.62, 2.74, 0.10], r: 0.07m, albedo: [0.45, 0.85, 0.88])
  # trailing blessing beads from the lowered hand
  emit GlossBead(c: c + [0.44, 0.98, 0.32], r: 0.045m, albedo: [0.92, 0.90, 0.84])
  emit GlossBead(c: c + [0.44, 0.86, 0.32], r: 0.045m, albedo: [0.92, 0.90, 0.84])
  emit GlossBead(c: c + [0.44, 0.74, 0.32], r: 0.045m, albedo: [0.92, 0.90, 0.84])
  # ground cross
  emit Capsule(a: [-2.5, -0.02, -0.5]@World, b: [2.5, -0.02, -0.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
  emit Capsule(a: [0.0, -0.02, -2.5]@World, b: [0.0, -0.02, 2.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
}

schedule Main {
  orbit(at: [0, 1.3, 0]@World, radius: 4.8m, height: 2.2m, period: 24.0s, fov: 40deg)
  cull_indirect(Capsule, GlossBead)
  render_bundle(Vis64) { draw_indirect(Capsule); draw_indirect(GlossBead) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
