use stdlib::geometry::analytic::{ray_capsule}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

# moss-archer: lean woodland hunter at full draw. Base model (no steps).

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

kind GlossBead @World (c: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, c, c, r)
  }
  trace(p) {
    capsule(p, c, c, r)
  }
  material(p, n) {
    ggx(albedo, 0.12, 0)
  }
}

build {
  let c = [0.0, 0.0, 0.0]@World
  let skin = [0.50, 0.55, 0.38]
  let leather = [0.45, 0.33, 0.22]
  # sprinter legs, slim torso
  emit Capsule(a: c + [-0.18, 0.60, 0], b: c + [-0.22, 0.05, 0.05], r: 0.11m, albedo: skin * 0.85)
  emit Capsule(a: c + [0.18, 0.60, 0], b: c + [0.22, 0.05, -0.05], r: 0.11m, albedo: skin * 0.85)
  emit Capsule(a: c + [0.0, 0.60, 0], b: c + [0.0, 1.50, 0], r: 0.32m, albedo: skin)
  # quiver on the back with three arrow tips peeking out
  emit Capsule(a: c + [0.10, 1.00, -0.40], b: c + [0.10, 1.70, -0.40], r: 0.10m, albedo: leather)
  emit GlossBead(c: c + [0.10, 1.78, -0.40], r: 0.04m, albedo: [0.80, 0.78, 0.70])
  emit GlossBead(c: c + [0.02, 1.76, -0.38], r: 0.04m, albedo: [0.80, 0.78, 0.70])
  emit GlossBead(c: c + [0.18, 1.76, -0.38], r: 0.04m, albedo: [0.80, 0.78, 0.70])
  # hood dome + keen amber eyes
  emit GlossBead(c: c + [0.0, 1.95, -0.05], r: 0.28m, albedo: skin * 1.05)
  emit GlossBead(c: c + [-0.12, 1.93, 0.24], r: 0.05m, albedo: [1.0, 0.65, 0.15])
  emit GlossBead(c: c + [0.12, 1.93, 0.24], r: 0.05m, albedo: [1.0, 0.65, 0.15])
  # bow arm extended to the side so the full longbow profile shows,
  # string arm drawn back across to the cheek
  emit Capsule(a: c + [-0.30, 1.40, 0.05], b: c + [-0.62, 1.45, 0.20], r: 0.09m, albedo: skin * 0.9)
  emit Capsule(a: c + [0.30, 1.40, 0.05], b: c + [-0.05, 1.58, 0.18], r: 0.09m, albedo: skin * 0.9)
  # longbow: two tall limbs meeting at the grip + taut string + nocked arrow
  emit Capsule(a: c + [-0.62, 1.00, 0.20], b: c + [-0.62, 1.45, 0.20], r: 0.035m, albedo: [0.40, 0.28, 0.16])
  emit Capsule(a: c + [-0.62, 1.45, 0.20], b: c + [-0.62, 1.90, 0.20], r: 0.035m, albedo: [0.40, 0.28, 0.16])
  emit Capsule(a: c + [-0.62, 1.00, 0.20], b: c + [-0.62, 1.90, 0.20], r: 0.012m, albedo: [0.85, 0.82, 0.72])
  emit Capsule(a: c + [-0.62, 1.45, 0.20], b: c + [-0.05, 1.55, 0.18], r: 0.015m, albedo: [0.70, 0.60, 0.42])
  emit GlossBead(c: c + [-0.62, 1.45, 0.20], r: 0.035m, albedo: [0.85, 0.83, 0.75])
  # ground cross
  emit Capsule(a: [-2.5, -0.02, -0.5]@World, b: [2.5, -0.02, -0.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
  emit Capsule(a: [0.0, -0.02, -2.5]@World, b: [0.0, -0.02, 2.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
}

schedule Main {
  orbit(at: [0, 1.1, 0]@World, radius: 4.6m, height: 2.0m, period: 24.0s, fov: 40deg)
  cull_indirect(Capsule, GlossBead)
  render_bundle(Vis64) { draw_indirect(Capsule); draw_indirect(GlossBead) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
