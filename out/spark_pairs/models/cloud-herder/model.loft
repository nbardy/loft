use stdlib::geometry::analytic::{ray_capsule}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

# cloud-herder: sky shepherd with a lantern pole, arm round a cloud-sheep.

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

kind GlossBead @World (c: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, c, c, r)
  }
  trace(p) {
    capsule(p, c, c, r)
  }
  material(p, n) {
    ggx(albedo, 0.12, 0)
  }
}

build {
  let c = [0.0, 0.0, 0.0]@World
  let wool = [0.80, 0.78, 0.74]
  let coat = [0.45, 0.55, 0.65]
  # striding legs, weather coat torso
  emit Capsule(a: c + [-0.20, 0.60, 0], b: c + [-0.26, 0.05, 0.10], r: 0.12m, albedo: coat * 0.8)
  emit Capsule(a: c + [0.20, 0.60, 0], b: c + [0.24, 0.05, -0.10], r: 0.12m, albedo: coat * 0.8)
  emit Capsule(a: c + [0.0, 0.60, 0], b: c + [0.0, 1.50, 0], r: 0.34m, albedo: coat)
  # tall pointed rain hat
  emit Capsule(a: c + [-0.30, 1.98, 0], b: c + [0.30, 1.98, 0], r: 0.08m, albedo: [0.35, 0.42, 0.50])
  emit Capsule(a: c + [0.0, 2.02, 0], b: c + [0.06, 2.52, 0], r: 0.13m, albedo: [0.35, 0.42, 0.50])
  emit GlossBead(c: c + [0.0, 1.88, 0], r: 0.24m, albedo: [0.72, 0.62, 0.50])
  # cheerful crescent eyes + open smile
  emit Capsule(a: c + [-0.14, 1.90, 0.22], b: c + [-0.04, 1.88, 0.22], r: 0.028m, albedo: [0.15, 0.12, 0.10])
  emit Capsule(a: c + [0.04, 1.88, 0.22], b: c + [0.14, 1.90, 0.22], r: 0.028m, albedo: [0.15, 0.12, 0.10])
  emit Capsule(a: c + [-0.08, 1.72, 0.24], b: c + [0.08, 1.72, 0.24], r: 0.03m, albedo: [0.25, 0.15, 0.12])
  # left arm around the cloud-sheep; right hand grips the lantern pole
  emit Capsule(a: c + [-0.32, 1.40, 0.05], b: c + [-0.72, 1.05, 0.25], r: 0.10m, albedo: coat * 0.9)
  emit Capsule(a: c + [0.32, 1.40, 0.05], b: c + [0.55, 1.30, 0.35], r: 0.10m, albedo: coat * 0.9)
  emit Capsule(a: c + [0.55, 0.05, 0.35], b: c + [0.55, 2.20, 0.35], r: 0.035m, albedo: [0.45, 0.34, 0.22])
  # the lantern: cage + warm heart hanging off the pole
  emit Capsule(a: c + [0.45, 2.02, 0.35], b: c + [0.65, 2.02, 0.35], r: 0.04m, albedo: [0.40, 0.32, 0.22])
  emit Capsule(a: c + [0.45, 1.78, 0.35], b: c + [0.65, 1.78, 0.35], r: 0.04m, albedo: [0.40, 0.32, 0.22])
  emit Capsule(a: c + [0.45, 1.78, 0.35], b: c + [0.45, 2.02, 0.35], r: 0.04m, albedo: [0.40, 0.32, 0.22])
  emit Capsule(a: c + [0.65, 1.78, 0.35], b: c + [0.65, 2.02, 0.35], r: 0.04m, albedo: [0.40, 0.32, 0.22])
  emit GlossBead(c: c + [0.55, 1.90, 0.35], r: 0.09m, albedo: [1.0, 0.72, 0.30])
  # the cloud-sheep: five puffs, tiny legs, one sleepy head
  emit GlossBead(c: c + [-1.05, 0.75, 0.25], r: 0.20m, albedo: wool)
  emit GlossBead(c: c + [-0.85, 0.90, 0.25], r: 0.17m, albedo: wool)
  emit GlossBead(c: c + [-1.20, 0.90, 0.25], r: 0.15m, albedo: wool)
  emit GlossBead(c: c + [-1.02, 1.02, 0.25], r: 0.15m, albedo: wool)
  emit Capsule(a: c + [-1.05, 0.60, 0.25], b: c + [-1.05, 0.30, 0.25], r: 0.05m, albedo: [0.55, 0.50, 0.45])
  emit GlossBead(c: c + [-1.05, 0.72, 0.42], r: 0.09m, albedo: [0.60, 0.55, 0.50])
  emit Capsule(a: c + [-1.09, 0.74, 0.50], b: c + [-1.01, 0.74, 0.50], r: 0.015m, albedo: [0.15, 0.12, 0.10])
  # ground cross
  emit Capsule(a: [-2.5, -0.02, -0.5]@World, b: [2.5, -0.02, -0.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
  emit Capsule(a: [0.0, -0.02, -2.5]@World, b: [0.0, -0.02, 2.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
}

schedule Main {
  orbit(at: [0, 1.1, 0]@World, radius: 4.8m, height: 2.0m, period: 24.0s, fov: 40deg)
  cull_indirect(Capsule)
  cull_indirect(GlossBead)
  render_bundle(Vis64) { draw_indirect(Capsule) }
  render_bundle(Vis64) { draw_indirect(GlossBead) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
