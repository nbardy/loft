use stdlib::geometry::analytic::{ray_capsule}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

# kelp-diver: round-helmeted harvester, kelp-draped, trident at rest. Base model.

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

kind GlossBead @World (c: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, c, c, r)
  }
  trace(p) {
    capsule(p, c, c, r)
  }
  material(p, n) {
    ggx(albedo, 0.12, 0)
  }
}

build {
  let c = [0.0, 0.0, 0.0]@World
  let suit = [0.30, 0.42, 0.40]
  let kelp = [0.25, 0.45, 0.25]
  # heavy boots + barrel suit
  emit Capsule(a: c + [-0.22, 0.55, 0], b: c + [-0.22, 0.05, 0], r: 0.14m, albedo: suit * 0.75)
  emit Capsule(a: c + [0.22, 0.55, 0], b: c + [0.22, 0.05, 0], r: 0.14m, albedo: suit * 0.75)
  emit Capsule(a: c + [0.0, 0.55, 0], b: c + [0.0, 1.45, 0], r: 0.40m, albedo: suit)
  # round brass helmet + big green porthole
  emit GlossBead(c: c + [0.0, 1.85, 0], r: 0.32m, albedo: [0.55, 0.42, 0.26])
  emit GlossBead(c: c + [0.0, 1.85, 0.28], r: 0.15m, albedo: [0.35, 0.65, 0.55])
  emit GlossBead(c: c + [0.0, 1.85, 0.33], r: 0.06m, albedo: [0.75, 0.95, 0.85])
  # kelp strands draped from both shoulders
  emit Capsule(a: c + [-0.38, 1.55, 0.05], b: c + [-0.50, 0.70, 0.15], r: 0.045m, albedo: kelp)
  emit Capsule(a: c + [-0.30, 1.58, -0.10], b: c + [-0.34, 0.95, -0.25], r: 0.04m, albedo: kelp * 0.85)
  emit Capsule(a: c + [0.38, 1.55, 0.05], b: c + [0.50, 0.70, 0.15], r: 0.045m, albedo: kelp)
  emit Capsule(a: c + [0.30, 1.58, -0.10], b: c + [0.34, 0.95, -0.25], r: 0.04m, albedo: kelp * 0.85)
  emit GlossBead(c: c + [-0.50, 0.62, 0.15], r: 0.06m, albedo: kelp * 1.1)
  emit GlossBead(c: c + [0.50, 0.62, 0.15], r: 0.06m, albedo: kelp * 1.1)
  # trident planted beside the right boot: pole + three prongs
  emit Capsule(a: c + [0.62, 0.05, 0.25], b: c + [0.62, 1.90, 0.25], r: 0.035m, albedo: [0.50, 0.38, 0.24])
  emit Capsule(a: c + [0.62, 1.90, 0.25], b: c + [0.62, 2.20, 0.25], r: 0.03m, albedo: [0.65, 0.68, 0.70])
  emit Capsule(a: c + [0.54, 1.88, 0.25], b: c + [0.54, 2.12, 0.25], r: 0.025m, albedo: [0.65, 0.68, 0.70])
  emit Capsule(a: c + [0.70, 1.88, 0.25], b: c + [0.70, 2.12, 0.25], r: 0.025m, albedo: [0.65, 0.68, 0.70])
  # left hand rests on the hip
  emit Capsule(a: c + [-0.38, 1.35, 0.05], b: c + [-0.30, 0.95, 0.20], r: 0.10m, albedo: suit * 0.9)
  # ground cross
  emit Capsule(a: [-2.5, -0.02, -0.5]@World, b: [2.5, -0.02, -0.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
  emit Capsule(a: [0.0, -0.02, -2.5]@World, b: [0.0, -0.02, 2.5]@World, r: 0.12m, albedo: [0.34, 0.31, 0.27])
}

schedule Main {
  orbit(at: [0, 1.1, 0]@World, radius: 4.6m, height: 2.0m, period: 24.0s, fov: 40deg)
  cull_indirect(Capsule)
  cull_indirect(GlossBead)
  render_bundle(Vis64) { draw_indirect(Capsule) }
  render_bundle(Vis64) { draw_indirect(GlossBead) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
