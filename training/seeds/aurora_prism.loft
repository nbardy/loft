use stdlib::sdf::solid::{box_sdf}
use stdlib::materials::bsdf::{ggx, emit_lobe, coat}

kind Prism @World () {
  trace(p) {
    let q = p - [0, 0.10, 0]@World
    let cross_section = max(abs(q.x) * 0.866 + q.y * 0.5 - 0.35, -q.y)
    max(cross_section, abs(q.z) - 0.22)
  }
  material(p, n) {
    let split = 0.5 + 0.5 * sin(24.0 * (p.y + 0.6 * p.x))
    ggx(mix([0.15, 0.71, 0.61], [0.52, 0.15, 0.76], split), 0.14, 0.21) + coat(0.40, 0.10)
  }
}

kind Ribbon @World () {
  trace(p) {
    let y = 0.96 + 0.24 * sin(4.0 * p.x)
    let wave = abs(p.y - y) - 0.10
    max(max(wave * 0.65, abs(p.z + 0.63) - 0.027), abs(p.x) - 0.98)
  }
  material(p, n) = emit_lobe(mix([0.07, 0.89, 0.48], [0.48, 0.13, 0.83], 0.5 + 0.5 * sin(7.0 * p.x)))
}

kind Ground @World () {
  trace(p) = box_sdf(p - [0, -0.09, 0]@World, [4, 0.08, 4])
  material(p, n) = ggx([0.08, 0.10, 0.16], 0.43, 0.24)
}

camera Main { at: [0, 0.56, -0.12]@World, radius: 3.3m, height: 0.64m, period: 32s, fov: 40deg }

build {
  emit Prism()
  emit Ribbon()
  emit Ground()
}
