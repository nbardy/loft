use stdlib::sdf::solid::{box_sdf, capsule, sphere}
use stdlib::materials::bsdf::{ggx, lambert}
use stdlib::motion::solve::{solve_s_neck_ik}

kind Heron @World () {
  trace(p) {
    let shoulder = [0, 0.83, 0]@World
    let head = [0.31, 1.40, 0]@World
    let bend = dir([1, 0, 0]@World)
    let a = solve_s_neck_ik(shoulder, head, 0.75m, bend, 1)
    let b = solve_s_neck_ik(shoulder, head, 0.75m, bend, 2)
    let body = sphere(p - [-0.17, 0.79, 0]@World, 0.24)
    let bill = capsule(p, head, head + [0.24, -0.04, 0], 0.032)
    var field = min(body, min(bill, sphere(p - head, 0.089)))
    field = min(field, min(capsule(p, shoulder, a, 0.069), min(capsule(p, a, b, 0.058), capsule(p, b, head, 0.047))))
    for i in 0..2 {
      let z = (f32(i) - 0.5) * 0.22
      field = min(field, capsule(p, [-0.17, 0.65, z]@World, [-0.08, 0.03, z]@World, 0.026))
    }
    max(field, box_sdf(p - [0, 0.75, 0]@World, [0.68, 0.80, 0.42]))
  }
  material(p, n) = lambert(mix([0.28, 0.37, 0.48], [0.88, 0.54, 0.15], smoothstep(0.34, 0.56, p.x)))
}

kind Ground @World () {
  trace(p) = box_sdf(p - [0, -0.09, 0]@World, [4, 0.08, 4])
  material(p, n) = ggx([0.065, 0.18, 0.17], 0.37, 0.0)
}

camera Main { at: [0, 0.78, 0]@World, radius: 3.4m, height: 0.52m, period: 32s, fov: 40deg }

build {
  emit Heron()
  emit Ground()
}
