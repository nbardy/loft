# In the old RGBA8 target every sample is quantized before the resolve.
pub fn rgba8_rgb(c: rgb) -> rgb = wgsl(c: rgb) -> rgb {
  return round(clamp(c, vec3f(0.0), vec3f(1.0)) * 255.0) / 255.0;
}

pub fn flat_label(label: u) -> rgb = wgsl(label: u) -> rgb {
  return vec3f((vec3u(label >> 16u, label >> 8u, label)) & vec3u(255u)) / 255.0;
}

pub fn distance_code(t: f) -> f = wgsl(t: f) -> f {
  return min(log2(1.0 + t) / 10.0, 1.0);
}
