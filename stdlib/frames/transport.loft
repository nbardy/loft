# Frames along a curve, for scans: a first frame from a tangent and an up hint, then rotation-minimising transport by
# double reflection (Wang, Juttler, Zheng, Liu 2008): no twist accumulates, unlike a Frenet frame.

# A parallel hint has no preferred roll. Choose an axis away from the tangent.
pub fn frame[S](o: p3@S, t: d3@S, up: d3@S) -> frame@S {
  var projected = up - t * dot(up, t)
  if dot(projected, projected) < 1e-12 {
    let other = [0, select(0.0, 1.0, abs(t.z) > 0.9), select(1.0, 0.0, abs(t.z) > 0.9)]@S - [0]@S
    projected = other - t * dot(other, t)
  }
  let n = normalize(projected)
  frame_axes(o, t, n, cross(t, n))
}

pub fn transport[S](prev: frame@S, o: p3@S, t1: d3@S) -> frame@S {
  let v1 = o - prev.origin
  let c1 = max(dot(v1, v1), 1e-20)
  let rl = prev.normal - v1 * (2.0 * dot(v1, prev.normal) / c1)
  let tl = prev.tangent - v1 * (2.0 * dot(v1, prev.tangent) / c1)
  let v2 = t1 - tl
  let c2 = max(dot(v2, v2), 1e-20)
  let n = normalize(rl - v2 * (2.0 * dot(v2, rl) / c2))
  frame_axes(o, t1, n, cross(t1, n))
}
