use stdlib::motion::body::{Walker, Deck, lane, put, nibble}
use stdlib::motion::solve::{ik_reachable_end, quintic_plan, step_spring_exact}
use stdlib::engines::roam::{default_turn}

const swing_height = 0.115m

# The row boundary uses a binary grid. Metal's native dot, divide and fused
# arithmetic can differ by an ulp from the expression twin (first at CoP).
# Persisting at this resolution avoids feeding those ulps into the next tick.
const row_scale = 8192.0

# Cached support hull: `links` holds one four-bit link per site, the destination ID plus one
# (zero means the site starts no edge). Area edges leave every eligible pin on their left.
# Collinear interiors cannot start an edge, and the lowest ID owns each coincident vertex.
# Sites are the pairs (xa, xb) and (za, zb); `count` of them are live.
fn live(i: u, count: u, skip: f, remove: f) -> bool = i < count && f32(i) != skip && f32(i) != remove

fn link(links: u, i: u) -> u = (links / nibble(i)) % 16

# Sites 0..3 of a hull live in one f32 column and 4..7 in another, so each half stays exact.
fn join(halves: v2) -> u = u32(halves.x) + u32(halves.y) * 65536

fn split(links: u) -> v2 = [f32(links % 65536), f32(links / 65536)]

fn hull(xa: v4, xb: v4, za: v4, zb: v4, count: u, skip: f, remove: f) -> u {
  var links: u = 0
  var point: u = 0
  var segment: u = 0
  var longest = 1e-12
  var edges = 0
  for i in 0..8 {
    if live(i, count, skip, remove) {
      let a = [lane(xa, xb, i), lane(za, zb, i)]
      var first = true
      var edge: u = 0
      point = (i + 1) * nibble(i)
      for j in 0..8 {
        if live(j, count, skip, remove) {
          let e = [lane(xa, xb, j), lane(za, zb, j)] - a
          let l2 = dot(e, e)
          first = first && !(j < i && l2 <= 1e-12)
          if l2 > 1e-12 {
            if l2 > longest {
              longest = l2
              segment = (j + 1) * nibble(i)
            }
            var left = true
            var area = false
            for k in 0..8 {
              if live(k, count, skip, remove) {
                let b = [lane(xa, xb, k), lane(za, zb, k)] - a
                let side = e.x * b.y - e.y * b.x
                let along = dot(b, e)
                area = area || side > 1e-7
                left = left && side >= -1e-7 &&
                  (side > 1e-7 || (along >= -1e-7 && along <= l2 + 1e-7))
              }
            }
            if left && area && edge == 0 { edge = j + 1 }
          }
        }
      }
      if first && edge > 0 {
        edges = edges + 1
        links = links + edge * nibble(i)
      }
    }
  }
  if edges >= 3 { return links }
  if longest > 1e-12 { return segment }
  point
}

# Closest deck X/Z, signed distance, and affine case (flight/point/line/area).
fn contact(xa: v4, xb: v4, za: v4, zb: v4, links: u, q: v2) -> v4 {
  var kind = 0.0
  var margin = 1e10
  var nearest = q
  var best = 1e10
  for i in 0..8 {
    let to = link(links, i)
    if to > 0 {
      let j = to - 1
      let a = [lane(xa, xb, i), lane(za, zb, i)]
      let e = [lane(xa, xb, j), lane(za, zb, j)] - a
      let d = q - a
      if i == j { return v4(a, -length(d), 1.0) }
      kind = kind + 1.0
      let l2 = dot(e, e)
      let site = a + e * clamp(dot(d, e) / l2, 0.0, 1.0)
      let r = q - site
      let d2 = dot(r, r)
      margin = min(margin, (e.x * d.y - e.y * d.x) / sqrt(l2))
      if d2 < best {
        best = d2
        nearest = site
      }
    }
  }
  if kind == 0.0 { return v4(q, -1e10, 0.0) }
  if kind == 1.0 { return v4(nearest, -sqrt(best), 2.0) }
  if margin < 0.0 { return v4(nearest, -sqrt(best), 3.0) }
  v4(q, margin, 3.0)
}

# Share of the load at site i when the sites in `keep` (one digit each) fit the pressure point q:
# an affine fit around their mean. The rank-one branch uses the covariance pseudoinverse along
# the supporting segment. The share can be negative; `kept` drops such sites.
fn share(xa: v4, xb: v4, za: v4, zb: v4, keep: u, q: v2, i: u) -> f {
  if link(keep, i) == 0 { return 0.0 }
  var n = 0.0
  var sx = 0.0
  var sz = 0.0
  for k in 0..8 {
    if link(keep, k) != 0 {
      n = n + 1.0
      sx = sx + lane(xa, xb, k)
      sz = sz + lane(za, zb, k)
    }
  }
  let mean = [sx, sz] / n
  var xx = 0.0
  var zz = 0.0
  var xz = 0.0
  for k in 0..8 {
    if link(keep, k) != 0 {
      let dx = lane(xa, xb, k) - mean.x
      let dz = lane(za, zb, k) - mean.y
      xx = xx + dx * dx
      zz = zz + dz * dz
      xz = xz + dx * dz
    }
  }
  let trace = xx + zz
  let det = xx * zz - xz * xz
  let d = q - mean
  var scale = [0.0, 0.0]
  if det > 1e-6 * trace * trace {
    scale = [zz * d.x - xz * d.y, xx * d.y - xz * d.x] / det
  } else if trace > 1e-8 {
    scale = [xx * d.x + xz * d.y, xz * d.x + zz * d.y] / (trace * trace)
  }
  1.0 / n + (lane(xa, xb, i) - mean.x) * scale.x + (lane(za, zb, i) - mean.y) * scale.y
}

# Drop the most negative share, lowest ID first, until every kept share is nonnegative.
fn kept(xa: v4, xb: v4, za: v4, zb: v4, count: u, skip: f, q: v2) -> u {
  var keep: u = 0
  for i in 0..8 {
    if i < count && f32(i) != skip { keep = keep + nibble(i) }
  }
  var settled = false
  for round in 0..8 {
    if !settled {
      var worst = -1
      var least = -1e-6
      for i in 0..8 {
        let s = share(xa, xb, za, zb, keep, q, i)
        if i < count && s < least {
          least = s
          worst = i32(i)
        }
      }
      if worst < 0 { settled = true } else { keep = keep - nibble(u32(worst)) }
    }
  }
  keep
}

# Compare displacement from each rest site before ranking. Equal strains keep
# the lower site ID. Test the remaining hull at the existing pressure point.
fn choose_foot(w: Walker, xa: v4, xb: v4, za: v4, zb: v4, aa: v4, ab: v4, cop: v2, capture: v2) -> f {
  let keep = kept(xa, xb, za, zb, w.sites, w.foot, cop)
  var winner = -1.0
  var strongest = 0.14m
  for i in 0..8 {
    let site = f32(i)
    let shift = [lane(xa, xb, i) - lane(w.home_xa, w.home_xb, i),
                 lane(za, zb, i) - lane(w.home_za, w.home_zb, i)]
    # Equal rest-relative strains must keep the lower ID even if the
    # adapter reassociates subtraction at the two mirrored homes.
    let strain = length(shift - capture)
    let stride = floor(strain * row_scale + 0.5) / row_scale
    let clear = w.foot != lane(w.previous_a, w.previous_b, i) && w.foot != lane(w.next_a, w.next_b, i)
    if i < w.sites && stride > strongest && clear && lane(aa, ab, i) >= 0.12 {
      if max(share(xa, xb, za, zb, keep, cop, i), 0.0) <= 0.30 {
        let remaining = contact(xa, xb, za, zb, hull(xa, xb, za, zb, w.sites, w.foot, site), cop)
        if remaining.w == 3.0 && remaining.z >= -0.5mm {
          strongest = stride
          winner = site
        }
      }
    }
  }
  winner
}

# Head state preserves continuous bearing across the wrap. Turn hysteresis is
# editable here and the neck absorbs only as much yaw as its joint allows.
fn gaze(w: Walker, bearing: rad, dt: s, supported: bool) -> v3 {
  let delta = bearing - w.last_bearing
  let continuous = w.unwrapped + atan2(sin(delta), cos(delta))
  let limit = 0.72rad
  let turn = default_turn(continuous - w.yaw, limit, w.turn > 0.0)
  let yaw = w.yaw + select(0.0, turn.x * dt, supported)
  [continuous, yaw, turn.y]
}

fn bearing_at(t: s, scale: f) -> rad {
  let elapsed = t - 0.65s
  if elapsed < 0.0 { return 0.0rad }
  if elapsed < 0.35s { return scale * 2.3 * (elapsed / 0.35s) }
  if elapsed < 1.35s { return scale * 2.3 }
  if elapsed < 1.7s { return scale * 2.3 * (1.0 - (elapsed - 1.35s) / 0.35s) }
  0.0rad
}

fn commanded(t: s, scale: f) -> v2 {
  if t <= 0.2s { return [0.0, 0.0] }
  if t <= 1.7s { return [0.82, 0.11] * scale }
  if t <= 3.2s { return [-0.88, -0.12] * scale }
  [0.0, 0.0]
}

fn root_at(w: Walker, i: u, centre: v2, turn: v2, lean: rad) -> p3@Deck {
  let x = lane(w.socket_xa, w.socket_xb, i)
  let z = lane(w.socket_za, w.socket_zb, i)
  [centre.x + (turn.x * x + turn.y * z), w.rest_h + lean * x,
   centre.y + (-turn.y * x + turn.x * z)]@Deck
}

fn leash(w: Walker, start: v2, turn: v2, lean: rad, xa: v4, xb: v4, za: v4, zb: v4, active: f) -> v2 {
  var centre = start
  let cap = 0.96 * w.reach_hi
  for sweep in 0..2 {
    for i in 0..8 {
      if i < w.sites && f32(i) != active {
        let root = root_at(w, i, centre, turn, lean)
        let delta = [lane(xa, xb, i), lane(za, zb, i)] - [root.x, root.z]
        let horizontal = length(delta)
        let limit = sqrt(max(0.0, cap * cap - root.y * root.y))
        if horizontal > limit { centre = centre + delta * ((horizontal - limit) / horizontal) }
      }
    }
  }
  centre
}

# The leash iterates a soft bound. Check the hard annulus after rounding the
# proposed centre, since the last projection can move an earlier pin out of range.
fn fits_stance(w: Walker, centre: v2, turn: v2, lean: rad, xa: v4, xb: v4, za: v4, zb: v4) -> bool {
  for i in 0..8 {
    if i < w.sites && f32(i) != w.foot {
      let reach = dist(root_at(w, i, centre, turn, lean), [lane(xa, xb, i), 0.0, lane(za, zb, i)]@Deck)
      if reach < w.reach_lo || reach > w.reach_hi { return false }
    }
  }
  true
}

# A landing is a new pin, so admit it inside the reach annulus of the same
# sampled trunk that the pose law will read. Leave room for grid rounding.
fn touchdown(w: Walker, root: p3@Deck, target: v2) -> v2 {
  let delta = target - [root.x, root.z]
  let hi = 0.98 * w.reach_hi
  let lo = w.reach_lo + 1mm
  let cap = sqrt(max(0.0, hi * hi - root.y * root.y))
  let floor_radius = sqrt(max(0.0, lo * lo - root.y * root.y))
  let span = length(delta)
  let axis = if span > 1e-6 { delta / span } else { [1.0, 0.0] }
  let offset = if span >= floor_radius && span <= cap { delta } else { axis * clamp(span, floor_radius, cap) }
  [root.x, root.z] + offset
}

# Reach projection is a solver step, so the stored endpoint is the end of the
# actual two-bone triangle. The planted check reads these same solved columns.
fn pose(w: Walker, root: p3@Deck, anchor: v2, goal: v2, u: f, lift: m) -> p3@Deck {
  let blend = quintic_plan(1m, 0.0, 1s, u).x
  let at = anchor + (goal - anchor) * blend
  let arch = 16.0 * u * u * (1.0 - u) * (1.0 - u)
  let wanted = [at.x, lift * arch, at.y]@Deck
  let span = dist(root, wanted)
  if span >= w.reach_lo && span <= w.reach_hi { return if u == 0.0 { wanted } else {
      let p = floor(wanted.xyz * row_scale + v3(0.5)) / row_scale
      [p.x, p.y, p.z]@Deck
    }
  }
  let end = ik_reachable_end(root, wanted, w.upper, w.lower, dir([0.0, 1.0, 0.0]@Deck))
  let p = floor(end.xyz * row_scale + v3(0.5)) / row_scale
  [p.x, p.y, p.z]@Deck
}

pub law step(w: Walker, dt: s) writes w.{x, z, vx, vz, lean, lean_rate, last_bearing, unwrapped, yaw, neck, turn, ax0, ax1, ax2, ax3, ax4, ax5, ax6, ax7, az0, az1, az2, az3, az4, az5, az6, az7, foot, age0, age1, age2, age3, age4, age5, age6, age7, swing, span, aim_x, aim_z, lift, rest_time, steps, boundary_a, boundary_b, support_kind, cop_margin} {
  let xa = [w.ax0, w.ax1, w.ax2, w.ax3]
  let xb = [w.ax4, w.ax5, w.ax6, w.ax7]
  let za = [w.az0, w.az1, w.az2, w.az3]
  let zb = [w.az4, w.az5, w.az6, w.az7]
  let aa = [w.age0, w.age1, w.age2, w.age3]
  let ab = [w.age4, w.age5, w.age6, w.age7]
  let c = [w.x, w.z]
  let v = [w.vx, w.vz]
  let tc2 = w.rest_h / 9.81
  let tc = sqrt(tc2)
  let want = (commanded(time, w.stick_scale) - v) / (0.5 * tc)
  let limited = want * min(1.0, 5.4 / max(length(want), 1e-6))
  let links = join([w.boundary_a, w.boundary_b])
  let current = contact(xa, xb, za, zb, links, c - limited * tc2)
  let cop = current.xy
  let acceleration = if current.w == 0.0 { [0.0, 0.0] } else { (c - cop) / tc2 }
  let bearing = floor(bearing_at(time, w.look_scale) * row_scale + 0.5) / row_scale
  let head = floor(gaze(w, bearing, dt, current.w >= 2.0) * row_scale + v3(0.5)) / row_scale
  let wanted_turn = [cos(head.y), sin(head.y)]
  let spring = step_spring_exact(w.lean, w.lean_rate, 19.0 * acceleration.x, 2.0, 1.0, dt)
  let wanted_lean = floor(spring * row_scale + v2(0.5)) / row_scale
  let capture = c + v * tc
  let candidate = if w.foot < 0.0 && w.rest_time >= 0.035s {
    choose_foot(w, xa, xb, za, zb, aa, ab, cop, capture)
  } else { -1.0 }
  let starting = candidate >= 0.0
  let flight_site = u32(max(0, i32(max(candidate, w.foot))))
  let rest = [lane(w.home_xa, w.home_xb, flight_site), lane(w.home_za, w.home_zb, flight_site)]
  let anchor = [lane(xa, xb, flight_site), lane(za, zb, flight_site)]
  let stride = length(rest + capture - anchor)
  let urgency = clamp((length(capture - cop) - 0.14) * 2.0, 0.0, 1.0)
  let duration = if starting { floor(clamp(0.25 + 0.04 * stride - 0.11 * urgency, 0.14, 0.28) * row_scale + 0.5) / row_scale } else { w.span }
  let height = if starting { swing_height * clamp(1.0 + 0.30 * stride - 0.45 * urgency, 0.5, 1.5) } else { w.lift }
  let elapsed = if starting { 0.0 } else { min(w.swing + dt, duration) }
  let u = min(1.0, elapsed / duration)
  let in_air = starting || w.foot >= 0.0
  let previous_goal = [w.aim_x, w.aim_z]
  let retarget = if starting { rest + c + v * (0.25 + duration) } else {
    let next = rest + c + v * (0.25 + (1.0 - u) * duration)
    previous_goal + (next - previous_goal) * (1.0 - smoothstep(0.5, 0.85, u))
  }
  let free = c + dt * (v + 0.5 * dt * acceleration)
  let leashed = leash(w, free, wanted_turn, wanted_lean.x, xa, xb, za, zb, w.foot)
  let proposed = floor(leashed * row_scale + v2(0.5)) / row_scale
  let fits = fits_stance(w, proposed, wanted_turn, wanted_lean.x, xa, xb, za, zb)
  let centre = if fits { proposed } else { c }
  let yaw = select(w.yaw, head.y, fits)
  let tilt = select(w.lean, wanted_lean.x, fits)
  let heading = [cos(yaw), sin(yaw)]
  # Metal can implement division with an approximate reciprocal. Compare
  # the clock directly so a completed span always lands on the same tick.
  let landing = in_air && elapsed >= duration
  let limited_goal = if in_air {
    touchdown(w, root_at(w, flight_site, centre, heading, tilt), retarget)
  } else { retarget }
  let aim = floor(limited_goal * row_scale + v2(0.5)) / row_scale
  let active = if in_air && !landing { f32(flight_site) } else { -1.0 }
  # Only a landing changes an anchor or an age; 8 names no site, so `put` leaves its lane alone.
  let nowhere: u = 8
  let landed = if landing { flight_site } else { nowhere }
  let nxa = put(xa, 0, landed, aim.x)
  let nxb = put(xb, 4, landed, aim.x)
  let nza = put(za, 0, landed, aim.y)
  let nzb = put(zb, 4, landed, aim.y)
  let tick = dt / 1s
  let naa = put(min(v4(0.12), aa + v4(tick)), 0, landed, 0.0)
  let nab = put(min(v4(0.12), ab + v4(tick)), 4, landed, 0.0)
  # Derive constrained velocity from the accepted, grid-aligned displacement.
  # Dividing the unrounded projection magnifies an ulp into a state change.
  let accepted_velocity = if !fits { [0.0, 0.0] } else if length(leashed - free) > 1e-6 {
    (centre - c) / dt
  } else { v + dt * acceleration }
  let next_velocity = floor(accepted_velocity * row_scale + v2(0.5)) / row_scale
  # The hull changes only when a foot lifts or lands; otherwise the cached links stand.
  let boundary = if active == w.foot { links } else { hull(nxa, nxb, nza, nzb, w.sites, active, -1.0) }
  let final_support = if active == w.foot { current } else { contact(nxa, nxb, nza, nzb, boundary, cop) }
  w.x = centre.x
  w.z = centre.y
  w.vx = next_velocity.x
  w.vz = next_velocity.y
  w.lean = tilt
  w.lean_rate = select(0.0, wanted_lean.y, fits)
  w.last_bearing = bearing
  w.unwrapped = head.x
  w.yaw = yaw
  w.neck = clamp(head.x - yaw, -0.72rad, 0.72rad)
  w.turn = head.z
  w.ax0 = nxa.x
  w.ax1 = nxa.y
  w.ax2 = nxa.z
  w.ax3 = nxa.w
  w.ax4 = nxb.x
  w.ax5 = nxb.y
  w.ax6 = nxb.z
  w.ax7 = nxb.w
  w.az0 = nza.x
  w.az1 = nza.y
  w.az2 = nza.z
  w.az3 = nza.w
  w.az4 = nzb.x
  w.az5 = nzb.y
  w.az6 = nzb.z
  w.az7 = nzb.w
  w.foot = active
  w.age0 = naa.x
  w.age1 = naa.y
  w.age2 = naa.z
  w.age3 = naa.w
  w.age4 = nab.x
  w.age5 = nab.y
  w.age6 = nab.z
  w.age7 = nab.w
  w.swing = select(0.0, elapsed, active >= 0.0)
  w.span = duration
  w.aim_x = select(0.0, aim.x, in_air && !landing)
  w.aim_z = select(0.0, aim.y, in_air && !landing)
  w.lift = select(0.0, floor(height * row_scale + 0.5) / row_scale, active >= 0.0)
  w.rest_time = select(min(0.12s, w.rest_time + dt), 0.0, in_air)
  w.steps = w.steps + select(0.0, 1.0, landing)
  w.boundary_a = split(boundary).x
  w.boundary_b = split(boundary).y
  w.support_kind = final_support.w
  w.cop_margin = floor(final_support.z * row_scale + 0.5) / row_scale
}

pub law present(w: Walker, dt: s) writes w.{toe_x0, toe_x1, toe_x2, toe_x3, toe_x4, toe_x5, toe_x6, toe_x7, toe_y0, toe_y1, toe_y2, toe_y3, toe_y4, toe_y5, toe_y6, toe_y7, toe_z0, toe_z1, toe_z2, toe_z3, toe_z4, toe_z5, toe_z6, toe_z7} {
  let centre = [w.x, w.z]
  let turn = [cos(w.yaw), sin(w.yaw)]
  let aim = [w.aim_x, w.aim_z]
  let phase = w.swing / w.span
  let xa = [w.ax0, w.ax1, w.ax2, w.ax3]
  let xb = [w.ax4, w.ax5, w.ax6, w.ax7]
  let za = [w.az0, w.az1, w.az2, w.az3]
  let zb = [w.az4, w.az5, w.az6, w.az7]
  var pxa = v4(0.0)
  var pxb = v4(0.0)
  var pya = v4(0.0)
  var pyb = v4(0.0)
  var pza = v4(0.0)
  var pzb = v4(0.0)
  for i in 0..8 {
    if i < w.sites {
      let end = pose(w, root_at(w, i, centre, turn, w.lean), [lane(xa, xb, i), lane(za, zb, i)], aim,
        select(0.0, phase, w.foot == f32(i)), w.lift)
      pxa = put(pxa, 0, i, end.x)
      pxb = put(pxb, 4, i, end.x)
      pya = put(pya, 0, i, end.y)
      pyb = put(pyb, 4, i, end.y)
      pza = put(pza, 0, i, end.z)
      pzb = put(pzb, 4, i, end.z)
    }
  }
  w.toe_x0 = pxa.x
  w.toe_x1 = pxa.y
  w.toe_x2 = pxa.z
  w.toe_x3 = pxa.w
  w.toe_x4 = pxb.x
  w.toe_x5 = pxb.y
  w.toe_x6 = pxb.z
  w.toe_x7 = pxb.w
  w.toe_y0 = pya.x
  w.toe_y1 = pya.y
  w.toe_y2 = pya.z
  w.toe_y3 = pya.w
  w.toe_y4 = pyb.x
  w.toe_y5 = pyb.y
  w.toe_y6 = pyb.z
  w.toe_y7 = pyb.w
  w.toe_z0 = pza.x
  w.toe_z1 = pza.y
  w.toe_z2 = pza.z
  w.toe_z3 = pza.w
  w.toe_z4 = pzb.x
  w.toe_z5 = pzb.y
  w.toe_z6 = pzb.z
  w.toe_z7 = pzb.w
}

# Analytical controls for the same hull query used during support exchange. The last pair
# puts a collinear midpoint on each edge of the square in lane b.
pub check support_cases(w: Walker) -> m {
  let xs = [0.0, 1.0, 1.0, 0.0]
  let zs = [0.0, 0.0, 1.0, 1.0]
  let nil = v4(0.0)
  let mid_x = [0.5, 1.0, 0.5, 0.0]
  let mid_z = [0.0, 0.5, 1.0, 0.5]
  let q = [2.0, 0.5]
  let flight = contact(xs, nil, zs, nil, hull(xs, nil, zs, nil, 0, -1.0, -1.0), q)
  let point = contact(xs, nil, zs, nil, hull(xs, nil, zs, nil, 1, -1.0, -1.0), q)
  let line = contact(xs, nil, zs, nil, hull(xs, nil, zs, nil, 2, -1.0, -1.0), q)
  let area = contact(xs, nil, zs, nil, hull(xs, nil, zs, nil, 4, -1.0, -1.0), q)
  let centre = contact(xs, nil, zs, nil, hull(xs, nil, zs, nil, 4, -1.0, -1.0), [0.5, 0.5])
  let eight = contact(xs, mid_x, zs, mid_z, hull(xs, mid_x, zs, mid_z, 8, -1.0, -1.0), q)
  let line_x = [0.0, 1.0, 1.0, 0.0]
  let line_z = v4(0.0)
  let line_at = [0.25, 0.0]
  let line_keep = kept(line_x, nil, line_z, nil, 4, -1.0, line_at)
  let line_weights = [share(line_x, nil, line_z, nil, line_keep, line_at, 0),
                      share(line_x, nil, line_z, nil, line_keep, line_at, 1),
                      share(line_x, nil, line_z, nil, line_keep, line_at, 2),
                      share(line_x, nil, line_z, nil, line_keep, line_at, 3)]
  let area_at = [0.5, 0.5]
  let area_keep = kept(xs, nil, zs, nil, 4, -1.0, area_at)
  let area_weights = [share(xs, nil, zs, nil, area_keep, area_at, 0), share(xs, nil, zs, nil, area_keep, area_at, 1),
                      share(xs, nil, zs, nil, area_keep, area_at, 2), share(xs, nil, zs, nil, area_keep, area_at, 3)]
  var error = length(flight - v4(q, -1e10, 0.0))
  error = max(error, length(point - [0.0, 0.0, -sqrt(4.25), 1.0]))
  error = max(error, length(line - [1.0, 0.0, -sqrt(1.25), 2.0]))
  error = max(error, length(area - [1.0, 0.5, -1.0, 3.0]))
  error = max(error, length(centre - [0.5, 0.5, 0.5, 3.0]))
  error = max(error, length(eight - [1.0, 0.5, -1.0, 3.0]))
  error = max(error, length(line_weights - [0.375, 0.125, 0.125, 0.375]))
  error = max(error, length(area_weights - [0.25, 0.25, 0.25, 0.25]))
  return if error > 1e-6m { missed(error) } else { held(1e-6m - error) }
}
