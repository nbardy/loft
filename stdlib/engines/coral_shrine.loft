use stdlib::geometry::analytic::{hit_min}
use stdlib::materials::bsdf::{lambert, ggx, emit_lobe}
use stdlib::sdf::solid::{box_sdf, round_box}
use stdlib::engines::woodblock

# Three depth-ten colonies around a carved lantern. The shadow world
# contains a separate solid lantern proxy.
space World Branch Shrine

param shrine_distance: f = 6.4 in 4..18
param shrine_solid: u = 0

# The branch's local axis is the same at a given depth. Yaw and position
# go in the pose, so 3,069 rows share thirty local shapes.
fn branch_axis() -> v3@Branch = [0, 0.8660254, 0.5]@Branch - [0, 0, 0]@Branch

fn cap_hit(o: p3@Branch, d: d3@Branch, c: p3@Branch, r: f, end: f, sign: f) -> f {
  let shift = dot(c - o, d)
  let v = o + d * shift - c
  let b = dot(v, d)
  let h = b * b - dot(v, v) + r * r
  if h < 0 {
    return -1
  }
  let axis = branch_axis()
  let s = sqrt(h)
  let t = shift - b - s
  if t >= 0 && sign * (dot(v + d * (t - shift), axis) - end) >= 0 {
    return t
  }
  let u = shift - b + s
  if u >= 0 && sign * (dot(v + d * (u - shift), axis) - end) >= 0 {
    return u
  }
  -1
}

fn cone_side(t: f, lo: f, hi: f, y: f, dy: f) -> f {
  let h = y + t * dy
  if t >= 0 && h >= lo && h <= hi {
    return t
  }
  -1
}

const branch_taper = 0.034375

fn branch_hit(ro: p3@Branch, rd: d3@Branch, len: f) -> f {
  let ra = 0.171875 * len
  let rb = ra - branch_taper * len
  let a = [0, 0, 0]@Branch
  let axis = branch_axis()
  let b = a + axis * len
  let shift = dot(a + axis * (len * 0.5) - ro, rd)
  # Rebase near the cone for the quadratic, then compare forward roots.
  let o = ro + rd * shift
  let v = o - a
  let y = dot(v, axis)
  let dy = dot(rd, axis)
  let radial = v - axis * y
  let dr = rd - axis * dy
  let s = branch_taper
  let c2 = 1 - s * s
  let r = ra - s * y
  let qa = c2 * dot(dr, dr) - s * s * dy * dy
  let qb = c2 * dot(radial, dr) + s * dy * r
  let qc = c2 * dot(radial, radial) - r * r
  let lo = ra * s
  let hi = len + rb * s
  let h = qb * qb - qa * qc
  # The endpoint balls are inside the cone tangent to both. A separated
  # positive quadratic rules out the sides and both caps. Keep the original
  # tests near tangency, where the three rebased quadratics can round differently.
  let margin = 0.0001 * (dot(v, v) + len * len)
  if qa > 0.0001 && h < -margin {
    return -1
  }
  var side = -1.0
  let oy = dot(ro - a, axis)
  if qa == 0 {
    if qb != 0 {
      side = cone_side(shift - qc / (2 * qb), lo, hi, oy, dy)
    }
  } else {
    if h >= 0 {
      let g = sqrt(h)
      let enter = cone_side(shift + (-qb - g) / qa, lo, hi, oy, dy)
      # This root has negative slope on the cone implicit. On its finite
      # side it enters the convex solid, so no spherical cap can hit earlier.
      if enter >= 0 {
        return enter
      }
      side = cone_side(shift + (-qb + g) / qa, lo, hi, oy, dy)
    }
  }
  # The spherical ends are rebased independently so far views keep the small radii.
  let c0 = cap_hit(ro, rd, a, ra, lo, -1)
  let c1 = cap_hit(ro, rd, b, rb, rb * s, 1)
  hit_min(side, hit_min(c0, c1))
}

kind CoralBranch @Branch (pose: xf@Branch>World, len: f > 0, level: f) {
  trace(p) = {
    let axis = branch_axis()
    let v = p - [0, 0, 0]@Branch
    let y = dot(v, axis)
    let s = branch_taper
    let radial = length(v - axis * y)
    let h = clamp(y - radial * s / sqrt(1 - s * s), 0, len)
    length(v - axis * h) - (0.171875 * len - s * h)
  }
  visible(ro, rd) = branch_hit(ro, rd, len)
  material(p, n) = emit_lobe(mix([0.14, 0.26, 0.44], [0.88, 0.32, 0.22], level))
}

fn lantern_fold(p: p3@Shrine) -> p3@Shrine {
  let x = abs(p.x) * 1.45 - 0.42
  let y = abs(p.y) * 1.45 - 0.28
  let z = abs(p.z) * 1.45 - 0.35
  [0.8525245 * x + 0.5226872 * z, y, 0.8525245 * z - 0.5226872 * x]@Shrine
}

fn lantern_shell(p: p3@Shrine) -> f {
  let q = lantern_fold(lantern_fold(lantern_fold(lantern_fold(p))))
  let c = [0, 0, 0]@Shrine
  max(round_box(q - c, [0.32, 0.45, 0.32], 0.04) / 4.420506,
      box_sdf(p - c, [0.82, 0.90, 0.82]))
}

kind FoldedLantern @Shrine (pose: xf@Shrine>World, solid: bool) {
  trace(p) = {
    if solid {
      return box_sdf(p - [0, 0, 0]@Shrine, [0.82, 0.90, 0.82])
    }
    let radial = length([p.x, 0, p.z]@Shrine - [0, 0, 0]@Shrine)
    max(lantern_shell(p), 0.28 - radial)
  }
  material(p, n) = emit_lobe(mix([0.86, 0.24, 0.14], [0.95, 0.88, 0.72], clamp(0.5 + p.y * 0.55, 0, 1)))
}

fn shrine_box_hit[S](o: v3@S, d: d3@S, half: rgb) -> f =
  wgsl(o: v3@S, d: d3@S, half: rgb) -> f {
    var entry = -1e30;
    var exit = 1e30;
    for (var axis = 0u; axis < 3u; axis++) {
      if d[axis] == 0.0 {
        if abs(o[axis]) > half[axis] { return -1.0; }
      } else {
        let x = (-half[axis] - o[axis]) / d[axis];
        let y = (half[axis] - o[axis]) / d[axis];
        entry = max(entry, min(x, y));
        exit = min(exit, max(x, y));
      }
    }
    if entry > exit || exit < 0.0 { return -1.0; }
    return select(exit, entry, entry >= 0.0);
  }

kind SolidLanternProxy @Shrine (pose: xf@Shrine>World) {
  visible(ro, rd) = shrine_box_hit(ro - [0, 0, 0]@Shrine, rd, [0.82, 0.90, 0.82])
  trace(p) = box_sdf(p - [0, 0, 0]@Shrine, [0.82, 0.90, 0.82])
  material(p, n) = lambert([0, 0, 0])
}

kind ShrineFloor @World () {
  visible(ro, rd) = shrine_box_hit(ro - [0, -0.15, 0]@World, rd, [5.8, 0.15, 5.8])
  trace(p) = box_sdf(p - [0, -0.15, 0]@World, [5.8, 0.15, 5.8])
  material(p, n) = ggx([0.32, 0.41, 0.43], 0.72, 0)
}

build {
  emit ShrineFloor()
  emit FoldedLantern(pose: place([0, 1.12, 0]@World), solid: shrine_solid != 0)
  emit SolidLanternProxy(pose: place([0, 1.12, 0]@World))
  build for tree in 0..3 {
    let angle = f32(tree) * 2.0943951
    let size = 1 - f32(tree) * 0.12
    let root = [1.9 * sin(angle), 0, 1.9 * cos(angle)]@World
    var count = u32(1)
    var scale = size
    build for level in 0..10 {
      build for path in 0..count {
        var p = root
        var yaw = angle
        var len = 1.28 * size
        var bits = path
        build for step in 0..level {
          p = p + [0.5 * len * sin(yaw), 0.8660254 * len, 0.5 * len * cos(yaw)]
          yaw = yaw + 0.73 + select(-1.05, 1.05, bits % 2 == 1)
          bits = bits / 2
          len = len * 0.76
        }
        emit CoralBranch(pose: place(p, yaw), len: 1.28 * scale, level: f32(level) / 9)
      }
      count = count * 2
      scale = scale * 0.76
    }
  }
  emit Sun(dir: dir([-0.5, 0.75, 0.35]@World), color: [2, 1.8, 1.6])
  emit Sky(zenith: [0.07, 0.16, 0.26], horizon: [0.38, 0.54, 0.59])
}

camera MainCam {
  at: [0, 2.2, 0]@World,
  radius: shrine_distance,
  height: 1.3,
  fov: 40deg
}

world PrimaryWorld { things: [ShrineFloor, FoldedLantern, CoralBranch] }
world SolidShadow { things: [ShrineFloor, SolidLanternProxy, CoralBranch] }

schedule Main { woodblock(PrimaryWorld, SolidShadow, MainCam) }
