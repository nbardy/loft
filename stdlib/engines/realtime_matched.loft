use stdlib::lighting::world::*

# Realtime transport for a sun, matte surfaces and the legacy sky.
# Raster visibility supplies the primary hit. Secondary rays use SceneWorld.

# Legacy's secondary queries can start inside overlapping capsules. Find
# the first positive cylinder or cap root, including exits from inside a row.
fn matched_capsule(ro: p3@World, rd: d3@World, a: p3@World, b: p3@World, r: m) -> f =
  wgsl(ro: p3@World, rd: d3@World, a: p3@World, b: p3@World, r: m) -> f {
    let axis_length = distance(a, b);
    let axis = select(vec3f(0, 1, 0), (b - a) / max(axis_length, 1e-20), axis_length > 0.0);
    let half_length = axis_length * 0.5;
    let center = (a + b) * 0.5;
    // Recenter the quadratic near the row so small, distant caps retain precision.
    let shift = dot(center - ro, rd);
    let o = ro - center + shift * rd;
    let y = dot(o, axis);
    let v = dot(rd, axis);
    let perpendicular_o = o - y * axis;
    let perpendicular_d = rd - v * axis;
    let qa = dot(perpendicular_d, perpendicular_d);
    let qb = dot(perpendicular_o, perpendicular_d);
    let disc = qb * qb - qa * (dot(perpendicular_o, perpendicular_o) - r * r);
    var nearest = 1e30;
    if qa > 0.0 && disc >= 0.0 {
      let roots = (vec2f(-sqrt(disc), sqrt(disc)) - qb) / qa;
      for (var i = 0u; i < 2u; i++) {
        let t = roots[i] + shift;
        if t >= 0.0 && t < nearest && abs(y + roots[i] * v) <= half_length {
          nearest = t;
        }
      }
    }
    for (var j = 0u; j < 2u; j++) {
      let side = 2.0 * f32(j) - 1.0;
      let p = o - side * half_length * axis;
      let e = dot(p, rd);
      let discriminant = e * e - dot(p, p) + r * r;
      if discriminant < 0.0 { continue; }
      let roots = vec2f(-sqrt(discriminant), sqrt(discriminant)) - e;
      for (var i = 0u; i < 2u; i++) {
        let q = roots[i];
        let t = q + shift;
        if t >= 0.0 && t < nearest && side * dot(p + q * rd, axis) >= 0.0 {
          nearest = t;
        }
      }
    }
    return select(nearest, -1.0, nearest == 1e30);
  }

fn matched_sky(direction: rgb, sun: rgb) -> rgb {
  mix([0.62, 0.72, 0.85], [0.13, 0.32, 0.62], pow(clamp(direction.y, 0.0, 1.0), 0.45))
}

fn matched_film(color: rgb) -> rgb { color / ([1.0, 1.0, 1.0] + color) }

fn matched_bounce(n: n3@World, px: v2) -> v4 =
  wgsl(n: n3@World, px: v2) -> v4 {
    let dims = array(3u, 4u);
    var xi: vec2f;
    for (var i = 0u; i < 2u; i++) {
      let keys = array(dims[i], 0u, 0u, u32(px.y), u32(px.x));
      var word = 0u;
      for (var j = 0u; j < 5u; j++) {
        let state = (word ^ keys[j]) * 747796405u + 2891336453u;
        word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
        word = (word >> 22u) ^ word;
      }
      xi[i] = f32(word >> 8u) / 16777216.0;
    }
    let phi = 6.283185307179586 * xi.y;
    let axis = select(vec3f(0, 0, 1), vec3f(0, 1, 0), abs(n.z) > 0.9);
    let u = normalize(cross(axis, n));
    let sample = vec3f(sqrt(xi.x) * vec2f(cos(phi), sin(phi)), sqrt(1.0 - xi.x));
    return vec4f(mat3x3f(u, cross(n, u), n) * sample, sample.z);
  }

fn matched_transport(w: World, hit: Hit, wo: d3@World, bounce: v4, sky: rgb) -> rgb =
  wgsl(w: World, hit: Hit, wo: d3@World, bounce: v4, sky: rgb) -> rgb {
    let sun = normalize(frame.sun.xyz);
    let n = hit.n;
    var color = vec3f(0.0);
    if dot(n, sun) > 0.0 {
      let vis = world_visibility(w, LoftRay(hit.p, sun, 0.0001, 1e5));
      color = loft_eval_hit(hit, wo, sun) * loft_params[0u].xyz * vis;
    }
    let wi = bounce.xyz;
    // A secondary hit contributes emission. A miss contributes the sky.
    let next = world_trace_ray(w, LoftRay(hit.p, wi, 0.0001, 1e30));
    var incident = vec3f(0.0);
    if next.t >= 0.0 {
      incident = world_eval(next, -wi, vec3f(0.0));
    } else if next.t == -1.0 {
      incident = sky;
    }
    return color + loft_eval_hit(hit, wo, wi) * (3.141592653589793 / bounce.w) * incident;
  }

fn matched_shade(w: World, hit: Hit, wo: d3@World, ink: bool, px: v2) -> rgb {
  let bounce = matched_bounce(hit.n, px)
  matched_transport(w, hit, wo, bounce, matched_sky(bounce.xyz, [0, 0, 0]))
}

pub schedule RealtimeMatched {
  orbit(at: [0, 0, 0], radius: 4, height: 0.5, period: 24, fov: 40deg)
  cull_indirect(Drawables)
  render_bundle(Vis64) { draw_indirect(Drawables) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, shade: matched_shade, edges: taps, sun: [0.45, 0.8, 0.35])
  tonemap(ColorHdr, sky: matched_sky, film: matched_film)
}
