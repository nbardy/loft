# Compatibility imports for existing scenes. New scenes can use stdlib::motion::act.
use stdlib::motion::act

pub fn act_crouch(rest: m, bottom: m, reach: s, release: s, t: s) -> m =
  act::act_crouch(rest, bottom, reach, release, t)

pub fn act_ballistic(y0: m, y1: m, duration: s, elapsed: s) -> m =
  act::act_ballistic(y0, y1, duration, elapsed)

pub fn act_hit_due(beat: s, t: s, dt: s) -> bool = act::act_hit_due(beat, t, dt)

pub fn act_slip(velocity: v2, mu: f, dt: s) -> v4 = act::act_slip(velocity, mu, dt)
