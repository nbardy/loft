use stdlib::geometry::analytic::{ray_capsule}
use stdlib::geometry::layout::{grid_spot, palette}
use stdlib::integrators::direct::{sun_sky}
use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{capsule}
use stdlib::sky::environment::{sky_color}

space World

kind Capsule @World (a: p3@World, b: p3@World, r: m, albedo: rgb) {

  visible(ro, rd) {
    ray_capsule(ro, rd, a, b, r)
  }
  trace(p) {
    capsule(p, a, b, r)
  }
  material(p, n) {
    ggx(albedo, 0.55, 0)
  }
}

param count: u = 20

build {
  build for i in 0..count {
    let c = [grid_spot(i, count, 2.4)]@World
    let f = select(-1.0, 1.0, i % 2 == 0)
    let skin = palette(i)
    emit Capsule( a: c + [-0.35 * f, 0.8, 0], b: c + [0.35 * f, 0.8, 0], r: 0.38m, albedo: skin)
    emit Capsule( a: c + [0.78 * f, 1.12, 0], b: c + [0.78 * f, 1.12, 0], r: 0.27m, albedo: skin * 1.15)
    emit Capsule( a: c + [-0.68 * f, 0.9, 0], b: c + [-1.05 * f, 1.32, 0], r: 0.07m, albedo: skin * 0.7)
    build for leg in 0..4 {
      let sx = select(-0.3, 0.3, leg % 2 == 0)
      let sz = select(-0.22, 0.22, leg < 2)
      emit Capsule(
        a: c + [sx, 0.62, sz],
        b: c + [sx * 1.3, 0.06, sz * 1.6],
        r: 0.09m,
        albedo: skin * 0.55,
     )
    }
  }
}

schedule Main {
  orbit(at: [0, 0.6, 0]@World, radius: 3.6m + 1.9m * sqrt(f32(count)), height: 1.2m + 0.6m * sqrt(f32(count)), period: 24.0s, fov: 40deg)
  cull_indirect(Capsule)
  render_bundle(Vis64) { draw_indirect(Capsule) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
