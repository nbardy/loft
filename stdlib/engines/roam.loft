# Compatibility imports for existing scenes. New scenes can use stdlib::motion::roam.
use stdlib::motion::roam

pub fn roam_accel(x: m, v: f, go: f, h: m, lo: m, hi: m, limit: f) -> f =
  roam::roam_accel(x, v, go, h, lo, hi, limit)

pub fn roam_swing(a_pin: m, b_pin: m, phase: f, group: f, aim: m,
                  capture: m, strain: m, dt: s, duration: s) -> v3 =
  roam::roam_swing(a_pin, b_pin, phase, group, aim, capture, strain, dt, duration)

pub fn roam_toe(anchor: m, aim: m, phase: f, active: bool, lift: m) -> v2 =
  roam::roam_toe(anchor, aim, phase, active, lift)

pub fn default_turn(yaw: rad, limit: rad, latched: bool) -> v2 = roam::default_turn(yaw, limit, latched)
