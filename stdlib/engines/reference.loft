use stdlib::integrators::restir::{reservoir_add, reservoir_scale, reservoir_reuse}
use stdlib::lighting::world

use stdlib::integrators::direct::{sun_sky}

use stdlib::sky::environment::*

# Finite-depth RGB transport. Continuous emitters and the environment are
# sampled by the BSDF proposal. Delta lights use a separate direct estimator.
pub fn reference_sample(origin: v3, direction: v3, seed: u, bounces: u) -> rgb =
  wgsl(origin: v3, direction: v3, seed: u, bounces: u) -> rgb {
    var ray_o = origin;
    var ray_d = direction;
    var energy = vec3<f32>(1.0);
    var radiance = vec3<f32>(0.0);
    for (var bounce = 0u; bounce <= bounces; bounce++) {
      let hit = world_trace(ray_o, ray_d, 1e6);
      if hit.t < -1.0 { break; }
      let volume = world_volume(0u, LoftRay(ray_o, ray_d, 0.0001, select(1e6, hit.t, hit.t >= 0.0)), 24u, true);
      radiance += energy * volume.l;
      energy *= volume.t;
      if hit.t == -1.0 {
        radiance += energy * loft_user_sky_dome(ray_d);
        break;
      }
      let wo = -ray_d;
      radiance += energy * (world_eval(hit, wo, vec3<f32>(0.0)) + world_direct(hit, wo, seed, bounce));
      if bounce == bounces { break; }
      let xi = vec2<f32>(path_random(seed, bounce * 16u), path_random(seed, bounce * 16u + 1u));
      ray_d = path_cosine(hit.n, xi);
      let pdf = max(dot(hit.n, ray_d), 0.0) * 0.318309886;
      if pdf <= 0.0 { break; }
      // The staged material's eval returns f*cos. The proposal needs support
      // over the whole upper hemisphere, including rough specular lobes.
      energy *= world_eval(hit, wo, ray_d) / pdf;
      if max(energy.x, max(energy.y, energy.z)) <= 0.0 { break; }
      ray_o = hit.p + hit.n * 0.0002;
    }
    return radiance;
  }

pub schedule Reference {
  orbit(at: [0, 0, 0], radius: 4, height: 0.5, period: 24, fov: 40deg)
  cull_indirect(Drawables)
  render_bundle(Vis64) { draw_indirect(Drawables) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.5, 0.75, 0.35])
  screen_pass(reference_sample, bounces: 16)
  tonemap_aces(ColorHdr, sky: sky_color)
}
