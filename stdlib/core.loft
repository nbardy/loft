# The shared Loft prelude.

pub const TAU = 6.2831853
pub kind Sky @World (zenith: rgb, horizon: rgb) {}
pub kind Sun @World (dir: d3@World, color: rgb) {}

# The renderer's environment defaults (DEFAULT_SUN_COLOR, DEFAULT_ZENITH, DEFAULT_HORIZON) live with their
# modules. The prelude loads them so a scene that shades without `sun_sky` (e.g. with woodblock_pigment) still
# has them; before this, such scenes failed with "missing environment default" and no source span.
use stdlib::lighting::emitters
use stdlib::sky::environment
# outline_and_paper reads paper_grain; a scene schedule that names the pass gets it from here.
use stdlib::post::display::{paper_grain}

# The stock helper modules, so a scene can call a catalog name without importing it (scope.rs resolves a
# public stock name by its unique bare key). Modules with kinds, builds or schedules stay opt-in.
use stdlib::sdf::solid
use stdlib::noise::value
use stdlib::materials::bsdf
use stdlib::geometry::analytic
use stdlib::geometry::layout
use stdlib::frames::transport
use stdlib::motion::solve
use stdlib::integrators::direct
use stdlib::styles::woodblock
