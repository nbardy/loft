use stdlib::styles::woodblock as ink
use stdlib::sky::environment::{sky_color}
use stdlib::post::display::{paper_grain}

pub schedule woodblock_passes(world, shadow) {
  cull_indirect(world)
  render_bundle(Vis64) { draw_indirect(world) }
  find_shadow_map(shadow, size: 1024)
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: ink::woodblock_pigment, sun: [0.5, 0.75, 0.35])
  outline_and_paper(ColorHdr)
  tonemap_aces(ColorHdr, sky: sky_color)
}
