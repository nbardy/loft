# Lobes return (BRDF times incident cosine, directional transmittance to the stack below).
# The stack is evaluated bottom-to-top. A zero light direction asks for emitted radiance.

fn pow5(x: f) -> f {
  let x2 = x * x
  x2 * x2 * x
}

# Isotropic GGX with height-correlated Smith masking and shadowing.
fn ggx_dv(nh: f, nv: f, nl: f, rough: f) -> f {
  let a = max(rough * rough, 0.002)
  let a2 = a * a
  let q = (1.0 - nh * nh) + nh * nh * a2
  let gv = nl * sqrt(a2 + (1.0 - a2) * nv * nv)
  let gl = nv * sqrt(a2 + (1.0 - a2) * nl * nl)
  a2 / (6.283185307 * q * q * max(gv + gl, 1e-8))
}

fn fresnel(f0: rgb, mu: f) -> rgb {
  f0 + (rgb(1.0) - f0) * pow5(1.0 - clamp(mu, 0.0, 1.0))
}

# Kulla-Conty. E and Eavg are the directional and cosine-weighted single-scattering
# albedos for unit Fresnel. The returned multiple-scattering BRDF is reciprocal.
fn ggx_ms(eo: v2, ei: f, favg: rgb) -> rgb {
  let ea = eo.y
  let lost = 1.0 - ea
  let tint = favg * favg * ea / max(rgb(1.0) - favg * lost, rgb(1e-6))
  tint * ((1.0 - eo.x) * (1.0 - ei) * 0.318309886 / max(lost, 1e-6))
}

fn ggx_reflect(nh: f, nv: f, nl: f, rough: f, f_half: rgb, favg: rgb, eo: v2) -> rgb {
  let ei = ggx_energy(rough, nl).x
  (f_half * ggx_dv(nh, nv, nl, rough) + ggx_ms(eo, ei, favg)) * nl
}

pub lobe lambert(albedo: rgb, n: rgb, v: rgb, l: rgb) {
  v4(albedo * (max(dot(n, l), 0.0) * 0.318309886), 1.0)
}

# Base dielectric/metal. The Schlick cosine-weighted average is (1 + 20 F0) / 21.
pub lobe ggx(albedo: rgb, rough: f, metal: f, n: rgb, v: rgb, l: rgb) {
  let nl = max(dot(n, l), 0.0)
  let nv = max(dot(n, v), 0.0)
  let f0 = mix(rgb(0.04), albedo, metal)
  let fv = fresnel(f0, nv)
  let eo = ggx_energy(rough, nv)
  var spec = rgb(0.0)
  if nl > 0.0 && nv > 0.0 {
    let h = normalize(v + l)
    let f = fresnel(f0, dot(v, h))
    spec = ggx_reflect(clamp(dot(n, h), 0.0, 1.0), nv, nl, rough, f, (rgb(1.0) + 20.0 * f0) / 21.0, eo)
  }
  let diffuse = albedo * (1.0 - metal) * (rgb(1.0) - fv) * (0.318309886 * nl)
  v4(diffuse + spec, 1.0 - eo.x * dot(fv, [0.2126, 0.7152, 0.0722]))
}

pub lobe coat(weight: f, rough: f, n: rgb, v: rgb, l: rgb) {
  let nv = max(dot(n, v), 0.0)
  let eo = ggx_energy(rough, nv)
  let fv = fresnel(rgb(0.04), nv).x
  var spec = rgb(0.0)
  let nl = dot(n, l)
  if nl > 0.0 && nv > 0.0 {
    let h = normalize(v + l)
    let f = fresnel(rgb(0.04), dot(v, h))
    spec = ggx_reflect(clamp(dot(n, h), 0.0, 1.0), nv, nl, rough, f, rgb(1.8 / 21.0), eo)
  }
  v4(weight * spec, 1.0 - weight * eo.x * fv)
}

# Airy reflectance at 650, 532 and 450 nm (air, film, air).
fn airy(ior: f, thickness_nm: f, mu: f) -> rgb {
  let cos_t = sqrt(max(1.0 - (1.0 - mu * mu) / (ior * ior), 0.0))
  let f = (ior - 1.0) / (ior + 1.0)
  let r0 = f * f
  let phase = 12.566371 * ior * thickness_nm * cos_t
  let c = [cos(phase / 650.0), cos(phase / 532.0), cos(phase / 450.0)]
  2.0 * r0 * (rgb(1.0) - c) / (rgb(1.0 + r0 * r0) - 2.0 * r0 * c)
}

pub lobe film(weight: f, ior: f, thickness_nm: f, n: rgb, v: rgb, l: rgb) {
  let nv = max(dot(n, v), 0.0)
  let eo = ggx_energy(0.3, nv)
  let fv = airy(ior, thickness_nm, nv)
  # Three-point Gauss integration in mu^2 for the cosine-weighted Fresnel.
  let favg = (5.0 * airy(ior, thickness_nm, 0.335711) + 8.0 * airy(ior, thickness_nm, 0.707107) + 5.0 * airy(ior, thickness_nm, 0.941965)) / 18.0
  var spec = rgb(0.0)
  let nl = dot(n, l)
  if nl > 0.0 && nv > 0.0 {
    let h = normalize(v + l)
    let f = airy(ior, thickness_nm, clamp(dot(v, h), 0.0, 1.0))
    spec = ggx_reflect(clamp(dot(n, h), 0.0, 1.0), nv, nl, 0.3, f, favg, eo)
  }
  v4(weight * spec, 1.0 - weight * eo.x * dot(fv, [0.2126, 0.7152, 0.0722]))
}

# Realtime subsurface approximation using wrapped diffuse.
pub lobe sss(color: rgb, radius: f, n: rgb, v: rgb, l: rgb) {
  let w = clamp(radius * 4.0, 0.0, 1.0)
  let lit = min(dot(l, l), 1.0)
  let wrap = max(dot(n, l) + w, 0.0) / ((1.0 + w) * (1.0 + w))
  v4(color * (0.31830988 * wrap * lit * w), 1.0)
}

pub lobe emit_lobe(color: rgb, n: rgb, v: rgb, l: rgb) {
  v4(color * (1.0 - min(dot(l, l), 1.0)), 1.0)
}

# Charlie distribution with the bounded Neubelt visibility term.
pub lobe sheen(color: rgb, rough: f, n: rgb, v: rgb, l: rgb) {
  let nl = clamp(dot(n, l), 0.0, 1.0)
  let nv = clamp(dot(n, v), 0.0, 1.0)
  if nl <= 0.0 || nv <= 0.0 {
    return v4(rgb(0.0), 1.0)
  }
  let nh = clamp(dot(n, normalize(v + l)), 0.0, 1.0)
  let inv_r = 1.0 / clamp(rough, 0.02, 1.0)
  let d = (2.0 + inv_r) * pow(max(1.0 - nh * nh, 0.0), 0.5 * inv_r) * 0.159154943
  let vis = 0.25 / max(nl + nv - nl * nv, 1e-6)
  v4(color * (d * vis * nl), 1.0)
}
