pub fn sphere[S](v: v3@S, r: f) -> f {
  length(v) - r
}

pub fn capsule[S](p: p3@S, a: p3@S, b: p3@S, r: f) -> f {
  let pa = p - a
  let ba = b - a
  let h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-12), 0.0, 1.0)
  length(pa - ba * h) - r
}

pub fn box_sdf[S](v: v3@S, half: rgb) -> f {
  let q = abs(v.xyz) - half
  length(max(q, rgb(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

# Polynomial smooth minimum (iq). Its gradient is a convex combination of the inputs' gradients.
pub fn smin(a: f, b: f, k: f) -> f {
  let h = max(k - abs(a - b), 0.0) / k
  min(a, b) - h * h * k * 0.25
}

pub fn round_box[S](v: v3@S, half: rgb, r: f) -> f {
  box_sdf(v, half - rgb(r)) - r
}

# Polynomial smooth subtraction: `a` with `b` carved out, blended over `k`.
pub fn ssub(a: f, b: f, k: f) -> f {
  -smin(-a, b, k)
}

# Exact distance in S to the convex hull of two endpoint balls. Radii are
# nonnegative. Nested or coincident balls reduce to the containing ball.
pub fn round_cone[S](p: p3@S, a: p3@S, b: p3@S, ra: m, rb: m) -> m {
  let ba = b - a
  let len = length(ba)
  let delta = ra - rb
  let pa = p - a
  if len <= abs(delta) {
    if delta >= 0 {
      return length(pa) - ra
    }
    return length(p - b) - rb
  }
  # Here len > |delta| >= 0. The clamp changes nothing on this path; it lets the range proof see a
  # nonzero divisor when the endpoints are kind columns (E211 in a crab Generate session).
  let span = max(len, 0.000001)
  let axis = ba / span
  let y = dot(pa, axis)
  let rho = length(pa - axis * y)
  let s = delta / span
  let c = sqrt((1 - s) * (1 + s))
  # Clamping the minimizing ball center selects either cap or the side.
  # After the containment test, c for a nonzero f32 slope gap exceeds
  # 1e-6. The floor supplies the current interval checker a positive bound.
  let station = clamp(y - rho * s / max(c, 1e-6), 0, len)
  length(pa - axis * station) - (ra - s * station)
}
