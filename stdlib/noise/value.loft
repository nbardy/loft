# Value noise on an integer hash: the same bits on the CPU twin and the GPU (no sine hash).

pub fn hash3(x: i, y: i, z: i) -> f {
  var h = xor(xor(u32(x) * 73856093, u32(y) * 19349663), u32(z) * 83492791)
  h = xor(h, shr(h, 13)) * 1274126177
  h = xor(h, shr(h, 16))
  f32(bit_and(h, 16777215)) / 16777216.0
}

# Smooth (C1) value noise in [0, 1].
pub fn vnoise(p: rgb) -> f {
  let i = floor(p)
  let f = p - i
  let u = f * f * (rgb(3.0) - 2.0 * f)
  let x = i32(i.x)
  let y = i32(i.y)
  let z = i32(i.z)
  let a = mix(mix(hash3(x, y, z), hash3(x + 1, y, z), u.x), mix(hash3(x, y + 1, z), hash3(x + 1, y + 1, z), u.x), u.y)
  let b = mix(mix(hash3(x, y, z + 1), hash3(x + 1, y, z + 1), u.x), mix(hash3(x, y + 1, z + 1), hash3(x + 1, y + 1, z + 1), u.x), u.y)
  mix(a, b, u.z)
}

# Two octaves.
pub fn fbm2(p: rgb) -> f {
  0.667 * vnoise(p) + 0.333 * vnoise(p * 2.03 + [1.7, 9.2, 3.1])
}

fn planar_corner(x: i, y: i, offset: v2) -> f {
  let angle = TAU * hash3(x, y, 0)
  dot([cos(angle), sin(angle)], offset)
}

# Four gradients, quintic interpolation and sqrt(2) scaling from the legacy
# planar lattice. Floor before converting to signed cells, including below zero.
pub fn noise2(p: v2) -> f {
  let cell = floor(p)
  let q = p - cell
  let w = q * q * q * (q * (q * 6.0 - [15.0, 15.0]) + [10.0, 10.0])
  let x = i32(cell.x)
  let y = i32(cell.y)
  let a = planar_corner(x, y, q)
  let b = planar_corner(x + 1, y, q - [1, 0])
  let c = planar_corner(x, y + 1, q - [0, 1])
  let d = planar_corner(x + 1, y + 1, q - [1, 1])
  1.41421356237 * mix(mix(a, b, w.x), mix(c, d, w.x), w.y)
}

# Normalized planar gradient fBM. The caller supplies 1..8 octaves, an
# in-range lattice at every octave, positive lacunarity and gain in [0, 1].
pub fn fractal2(p: v2, octaves: u, lacunarity: f, gain: f) -> f {
  var q = p
  var amp = 1.0
  var weight = 0.0
  var sum = 0.0
  for octave in 0..octaves {
    sum = sum + amp * noise2(q)
    weight = weight + amp
    q = q * lacunarity + [37.5, 19.25]
    amp = amp * gain
  }
  # An empty sum is zero, including at call sites without a positive row bound.
  sum / max(1.0, weight)
}

# Normalized volume value fBM, using the same domain as fractal2. The two-octave
# stock fbm2 above keeps its existing frequencies, weights and bit sequence.
pub fn fractal3(p: v3, octaves: u, lacunarity: f, gain: f) -> f {
  var q = p
  var amp = 1.0
  var weight = 0.0
  var sum = 0.0
  for octave in 0..octaves {
    sum = sum + amp * vnoise(q)
    weight = weight + amp
    q = q * lacunarity + [37.5, 19.25, 11.125]
    amp = amp * gain
  }
  sum / max(1.0, weight)
}
