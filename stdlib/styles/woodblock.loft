pub fn woodblock_pigment(b: Bsdf, n: rgb, v: rgb, sun: rgb, shadow: f, ao: f) -> rgb {
  let nl = max(dot(n, sun), 0) * shadow
  let bands = 0.25 + 0.27 * smoothstep(0.08, 0.11, nl) +
    0.29 * smoothstep(0.41, 0.44, nl) + 0.24 * smoothstep(0.77, 0.80, nl)
  let pigment = eval_bsdf(b, n, v, n) * 3.14159265
  let wash = (1.0 - smoothstep(0.1, 0.65, n.y)) * 0.32
  mix(pigment * bands * (0.7 + 0.3 * ao), [0.08, 0.12, 0.22], wash) + eval_bsdf(b, n, v, rgb(0.0))
}

use stdlib::styles::surface::{Surface, Lighting}
use stdlib::styles::print::paint::{print_paint}

pub fn shade(h: Surface, l: Lighting) -> rgb {
  let key = max(dot(h.n, l.key), 0.0) * l.key_visibility
  let fill = dot(l.indirect_diffuse, [0.2126, 0.7152, 0.0722])
  let value = key * 0.79 + fill * 0.85 * l.ao
  let bands = 0.24 + 0.25 * smoothstep(0.10, 0.14, value) +
    0.28 * smoothstep(0.42, 0.46, value) + 0.23 * smoothstep(0.75, 0.80, value)
  let anchor = coords(h.anchor)
  let phase = dot(anchor, [1.0, 0.60, 0.35]) / 0.075
  let pixel = max(h.footprint.x, h.footprint.y)
  let fw = clamp(pixel / 0.075, 0.005, 0.5)
  let stroke = abs(fract(phase + 0.5) - 0.5)
  let pressure = 1.0 - smoothstep(0.18, 0.54, value)
  let hatch = (1.0 - smoothstep(0.095 - fw, 0.095 + fw, stroke)) *
    (1.0 - smoothstep(0.16, 0.5, fw)) * pressure
  let wash = (1.0 - smoothstep(0.1, 0.65, h.n.y)) * 0.32
  let pigment = print_paint(h, 0.85, 0.26)
  let block = mix(pigment * bands + l.indirect_diffuse * 0.14, [0.08, 0.12, 0.22], wash)
  let facing = max(dot(h.n, h.view), 0.0)
  let rim = (1.0 - smoothstep(0.09, 0.19, facing)) * pressure
  let overprint = mix(block, [0.021, 0.031, 0.053], max(0.58 * hatch, 0.62 * rim))
  overprint + l.indirect_gloss * 0.11 + l.emitted
}
