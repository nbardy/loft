use stdlib::styles::surface::{Surface, Lighting}

pub fn shade(h: Surface, l: Lighting) -> rgb {
  let key = clamp((dot(h.n, l.key) + 0.12) / 1.12, 0.0, 1.0) * l.key_visibility
  let fill = dot(l.indirect_diffuse, [0.2126, 0.7152, 0.0722]) * l.ao
  let value = 0.86 * key + fill * 0.65
  let bands = 0.20 + 0.32 * smoothstep(0.17, 0.20, value) +
    0.33 * smoothstep(0.47, 0.50, value) + 0.26 * smoothstep(0.74, 0.78, value)
  let facing = clamp(dot(h.n, h.view), 0.0, 1.0)
  # n·h avoids normalizing a zero half-vector when key and view oppose.
  let half_len = sqrt(max(2.0 + 2.0 * dot(l.key, h.view), 0.00001))
  let half_up = (dot(h.n, l.key) + facing) / half_len
  let cut = mix(0.965, 0.995, h.rough)
  let glint = smoothstep(cut - 0.012, cut + 0.003, half_up) *
    (1.0 - h.rough) * l.key_visibility * smoothstep(0.0, 0.16, key)
  let rim = smoothstep(0.65, 0.98, 1.0 - facing) * smoothstep(0.12, 0.50, value)
  let shadow = [0.72, 0.79, 1.10]
  let body = h.pigment * mix(shadow, [1.12, 1.02, 0.90], smoothstep(0.22, 0.72, value)) * bands
  body + l.indirect_gloss * 0.60 + glint * [1.0, 0.88, 0.68] + rim * [0.19, 0.26, 0.40] + l.emitted
}
