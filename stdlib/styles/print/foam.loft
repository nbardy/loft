use stdlib::noise::value::{noise2}

# band is a caller-supplied contact mass. toward points out of the contact.
# The two channels are disjoint fill and key line, in that order.
pub fn contact_foam(xz: v2, band: f, toward: v2, crest: f, pixel: m) -> v2 {
  if band <= 0.0 { return [0.0, 0.0] }
  let grain = noise2(xz * 9.0)
  let tangent = [-toward.y, toward.x] / max(length(toward), 0.001)
  let cut = band - 0.46 - 0.21 * abs(grain) + 0.07 * crest
  let strand = sin(34.0 * dot(xz, tangent) + 4.0 * grain)
  let fw = clamp(pixel * 2.0, 0.012, 0.19)
  let collar = smoothstep(-fw, fw, cut)
  let filaments = smoothstep(0.46, 0.89, strand) * smoothstep(-0.17, 0.0, cut) *
    (1.0 - smoothstep(0.025, 0.09, pixel))
  let fill = max(collar, filaments * 0.82)
  let edge = smoothstep(-0.105 - fw, -0.105 + fw, cut) * (1.0 - fill)
  [fill, 0.78 * edge]
}
