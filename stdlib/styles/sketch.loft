use stdlib::styles::surface::{Surface, Lighting}
use stdlib::noise::value::{fbm2}

const PAPER = [0.95, 0.93, 0.88]
const GRAPHITE = [0.065, 0.064, 0.078]

pub fn shade(h: Surface, l: Lighting) -> rgb {
  let anchor = coords(h.anchor)
  let wander = fbm2(anchor / 0.32) - 0.5
  let key = max(dot(h.n, l.key), 0.0) * l.key_visibility
  let fill = dot(l.indirect_diffuse, [0.2126, 0.7152, 0.0722]) * l.ao
  let tone = dot(h.pigment, [0.2126, 0.7152, 0.0722])
  let key_depth = 1.0 - smoothstep(0.11, 0.89, key + fill * 0.68)
  let shade_depth = max(key_depth, 0.32 * (1.0 - smoothstep(0.16, 0.39, tone)))
  let pixel = max(h.footprint.x, h.footprint.y)
  let fw = clamp(pixel / 0.115, 0.006, 0.5)
  let slash = dot(anchor, [0.84, 0.54, 0.63]) / 0.115 + 0.34 * wander
  let crossbar = dot(anchor, [-0.59, 0.86, 0.39]) / 0.152 - 0.32 * wander
  let gap_a = abs(fract(slash + 0.5) - 0.5)
  let gap_b = abs(fract(crossbar + 0.5) - 0.5)
  let width = mix(0.042, 0.21, shade_depth)
  let fine = 1.0 - smoothstep(width - fw, width + fw, gap_a)
  let cross_ink = 1.0 - smoothstep(0.12 - fw, 0.12 + fw, gap_b)
  let overlap = max(fine * shade_depth, cross_ink * smoothstep(0.36, 0.85, shade_depth))
  # Above Nyquist, keep the stroke's mean darkness instead of dropping the line.
  let hatch = mix(overlap, 2.0 * width * shade_depth, smoothstep(0.18, 0.49, fw))
  let facing = max(dot(h.n, h.view), 0.0)
  let edge = mix(0.08, 0.31, clamp(shade_depth + 0.54 * wander, 0.0, 1.0))
  let contour = 1.0 - smoothstep(edge - 0.035, edge + 0.045, facing)
  let black = 1.0 - smoothstep(0.065, 0.12, tone)
  mix(PAPER, GRAPHITE, max(black, max(0.89 * hatch, 0.68 * contour))) + l.emitted
}
