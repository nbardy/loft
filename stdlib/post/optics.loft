# All coordinates are clamped by post_color and post_depth.
fn bloom(px: v2) -> rgb =
  wgsl(px: v2) -> rgb {
    let at = vec2i(px);
    var bright = vec3f(0.0);
    var weight = 0.0;
    for (var i = 0u; i < 16u; i++) {
      let radius = 12.0 * sqrt((f32(i) + 0.5) / 16.0);
      let angle = 2.39996323 * f32(i);
      let tap = post_color(at + vec2i(round(radius * vec2f(cos(angle), sin(angle)))));
      let w = 1.0 - 0.5 * radius / 12.0;
      bright += max(tap - vec3f(1.1), vec3f(0.0)) * w;
      weight += w;
    }
    return post_color(at) + bright * (0.68 / weight);
  }

fn reflection(px: v2) -> rgb =
  wgsl(px: v2) -> rgb {
    let at = vec2i(px);
    let base = post_color(at);
    let z = post_depth(at);
    if z > 30.0 { return base; }
    let axis = loft_ray(vec2f(frame.size.xy) * 0.5);
    let ray = loft_ray(px);
    let dx = loft_ray(px + vec2f(1.0, 0.0));
    let dy = loft_ray(px + vec2f(0.0, 1.0));
    let zx = post_depth(at + vec2i(1, 0));
    let zy = post_depth(at + vec2i(0, 1));
    if abs(zx - z) > 0.08 * z || abs(zy - z) > 0.08 * z { return base; }
    let p = ray * (z / dot(ray, axis));
    let x = dx * (zx / dot(dx, axis));
    let y = dy * (zy / dot(dy, axis));
    let normal = normalize(cross(y - p, x - p));
    if normal.y < 0.65 { return base; }
    let reflected = reflect(ray, normal);
    let size = vec2f(frame.size.xy);
    for (var i = 1u; i <= 24u; i++) {
      let travel = 0.024 * f32(i * i);
      let offset = p + normal * 0.045 + reflected * travel;
      let screen = frame.view_proj * vec4f(frame.eye.xyz + offset, 1.0);
      if screen.w <= 0.0 { break; }
      let uv = screen.xy / screen.w * vec2f(0.5, -0.5) + 0.5;
      if any(uv < vec2f(0.0)) || any(uv >= vec2f(1.0)) { break; }
      let q = vec2i(uv * size);
      let gap = dot(offset, axis) - post_depth(q);
      if gap > 0.0 && gap < 0.035 + 0.025 * travel {
        let fresnel = 0.05 + 0.35 * pow(1.0 - clamp(-dot(ray, normal), 0.0, 1.0), 5.0);
        return mix(base, post_color(q), fresnel * exp(-0.12 * travel));
      }
    }
    return base;
  }

fn studio_ao(px: v2) -> rgb =
  wgsl(px: v2) -> rgb {
    let at = vec2i(px);
    let z = post_depth(at);
    let c = post_color(at);
    if z > 30.0 { return c; }
    var occlusion = 0.0;
    for (var i = 0u; i < 12u; i++) {
      let angle = 2.39996323 * f32(i);
      let radius = 2.0 + 0.8 * f32(i);
      let offset = vec2i(round(radius * vec2f(cos(angle), sin(angle))));
      let delta = z - post_depth(at + offset);
      occlusion += smoothstep(0.02, 0.08, delta) * (1.0 - smoothstep(0.25, 0.70, delta));
    }
    return c * (1.0 - 0.35 * occlusion / 12.0);
  }

fn dof(px: v2) -> rgb =
  wgsl(px: v2) -> rgb {
    let p = vec2i(px);
    let z = post_depth(p);
    let radius = clamp(14.0 * abs(z - 5.4) / max(z, 0.1), 0.0, 12.0);
    var c = post_color(p);
    if radius < 0.5 { return c; }
    var weight = 1.0;
    for (var i = 0u; i < 16u; i++) {
      let angle = 2.39996323 * f32(i);
      let distance = radius * sqrt((f32(i) + 0.5) / 16.0);
      let tap = p + vec2i(round(distance * vec2f(cos(angle), sin(angle))));
      let separation = abs(post_depth(tap) - z);
      let w = 1.0 - smoothstep(0.4, 1.5, separation);
      c += post_color(tap) * w;
      weight += w;
    }
    return c / weight;
  }

pub schedule LuminousPost() {
  post_process(effect: reflection)
  post_process(effect: bloom)
}

pub schedule StudioAO() {
  post_process(effect: studio_ao)
}

pub schedule DepthOfField() {
  post_process(effect: dof)
}
