use stdlib::materials::bsdf::{ggx}
use stdlib::sdf::solid::{sphere}

space World

kind ProbeSphere @World () {
  trace(p) = sphere(p - [0, 0, 0]@World, 0.75m)
  material(p, n) = ggx([0.52, 0.31, 0.12], 0.8, 0.0)
}
build { emit ProbeSphere() }

schedule Main {
  orbit(at: [0, 0, 0], radius: 3, height: 0.4, period: 24, fov: 40deg)
  cull_indirect(ProbeSphere)
  render_bundle(Vis64) { draw_indirect(ProbeSphere) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.5, 0.75, 0.35])
  screen_pass(reference_sample, bounces: 3)
  tonemap_aces(ColorHdr, sky: sky_color)
}
