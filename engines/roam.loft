# A row-local roam policy for alternating support groups on a horizontal
# surface. Its one-axis controller uses the actual X interval of the active
# support hull at the centre line. Body layouts and toe presentation are scene choices.

pub fn roam_accel(x: m, v: f, go: f, h: m, lo: m, hi: m, limit: f) -> f {
  let want = clamp((go - v) / 0.12s, -limit, limit)
  let scale = h / 9.81
  (x - clamp(x - want * scale, lo, hi)) / scale
}

# Phase zero denotes two planted groups. While one group swings, the other
# remains planted. Only the landing branch changes an anchor.
pub fn roam_swing(a_pin: m, b_pin: m, phase: f, group: f, aim: m,
                  capture: m, strain: m, dt: s, duration: s) -> v3 {
  let advance = dt / duration
  if phase > 0.0 { return [min(1.0, phase + advance), group, aim] }
  let a = abs(a_pin - capture)
  let b = abs(b_pin - capture)
  if max(a, b) <= strain { return [0.0, group, aim] }
  let next = if a == b { 1.0 - group } else { select(1.0, 0.0, a > b) }
  [advance, next, capture]
}

pub fn roam_toe(anchor: m, aim: m, phase: f, active: bool, lift: m) -> v2 {
  if !active || phase == 0.0 { return [anchor, 0.0] }
  let bell = 4.0 * phase * (1.0 - phase)
  [anchor + quintic_plan(aim - anchor, 0.0, 1s, phase).x, lift * bell * bell]
}

# Hysteresis is evaluated on the unwrapped gaze yaw. A look near centre
# releases a latched trunk turn without chatter at the edge.
pub fn default_turn(yaw: rad, limit: rad, latched: bool) -> v2 {
  let r = abs(yaw) / max(limit, 0.1rad)
  let next = if latched { r > 0.25 } else { r >= 0.85 }
  let rate = select(0.0, sign(yaw) * 3.8 * clamp(r - 0.25, 0.0, 1.0), next)
  [rate, select(0.0, 1.0, next)]
}
