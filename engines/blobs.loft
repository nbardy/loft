space World Blob

kind Blob @World (pose: xf@Blob>World, size: m > 0m, wobble: m, tint: rgb) {

  trace(p) {
    let q = inv(pose) * p
    let s = size
    let body = sphere(q - [0, 0.62 * s, 0]@Blob, 0.55 * s)
    let foot = box_sdf(q - [0, 0.1 * s, 0]@Blob, [0.32 * s, 0.1 * s, 0.24 * s])
    map ear = q |> mirror_x |> move([-0.3 * s, -1 * s, 0])
    let horn = capsule(ear.p, ear.pt(0, 0, 0), ear.pt(0.14 * s, 0.36 * s, -0.06 * s), 0.1 * s)
    let ripple = wobble * sin(9 * q.y) * sin(9 * q.x + 1.3)
    smin(smin(body, horn, 0.14 * s), foot, 0.1 * s) + ripple
  }

  material(p, n) {
    let q = inv(pose) * p
    let s = size
    map side = q |> mirror_x |> move([-0.2 * s, -0.78 * s, -0.45 * s])

    let eye = side.out(side.pt(0, 0, 0))
    let d = distance(q, eye)
    let white = 1 - smoothstep(0.075 * s, 0.09 * s, d)
    let pupil = 1 - smoothstep(0.035 * s, 0.045 * s, d)
    let cheek = select(rgb(1), [1, 0.9, 0.94], side.cell < 0)
    ggx(mix(mix(tint * cheek, rgb(0.95), white), rgb(0.03), pupil), 0.5, 0)
  }
}

param count: u = 20

build {
  build for i in 0..count {
    emit Blob(
      pose: place([grid_spot(i, count, 2.2)]@World, 0.6 * sin(f32(i) * 2.7)),
      size: 0.85m + 0.2m * sin(f32(i) * 2.3),
      wobble: 0.02m,
      tint: palette(i + 3),
   )
  }
}

schedule Main {
  orbit(at: [0, 0.55, 0]@World, radius: 3.4m + 1.8m * sqrt(f32(count)), height: 1.0m + 0.6m * sqrt(f32(count)), period: 24.0s, fov: 40deg)
  cull_indirect(Blob)
  render_bundle(Vis64) { draw_indirect(Blob) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.45, 0.8, 0.35])
  tonemap_aces(ColorHdr, sky: sky_color)
}
