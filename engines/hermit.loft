space World Body Shell Face Claw Leg

fn whorl_axis() -> rgb {
  [0, 0.9578, -0.2873]
}

fn spine(u: f) -> p3@Shell {
  let r = 0.42 * exp(2.6 * (u - 1))
  let a = 22 * u
  let e2 = [0, -0.2873, -0.9578]
  let x = [r * cos(a), 0, 0] + e2 * (r * sin(a)) + whorl_axis() * (1.5 * (0.42 - r))
  [x.x, x.y, x.z]@Shell
}

scan whorl u in 0..1 by 256 on bake_lut {
  init = frame_from_tangent(spine(u), normalize(spine'(u)), dir([0, 0.9578, -0.2873]@Shell))
  step prev = transport_frame(prev, spine(u), normalize(spine'(u)))
}

fn rib(u: f, a: f) -> f {
  let c = 0.5 + 0.5 * cos(28 * u)
  0.06 * c * c * c * c * (0.6 + 0.4 * cos(5 * a))
}

fn shell_at(u: f, v: f) -> p3@Shell {
  let f = sample_c2(whorl, u)
  let a = 6.2831853 * v

  let r = 0.26 * exp(2.6 * (u - 1))
  let k = rib(u, a)
  f.origin + f.normal * (r * (1 + k) * cos(a)) + f.binormal * (r * (0.9 + k) * sin(a))
}

kind Ground @World (radius: f) {

  visible(ro, rd) {
    if rd.y >= 0 {
      return -1
    }
    let t = -ro.y / rd.y
    let p = ro + rd * t
    if max(abs(p.x), abs(p.z)) > radius {
      return -1
    }
    t
  }
  trace(p) {
    box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  }
  material(p, n) {
    let grain = fbm2(p.xyz * 6)
    let ripple = 0.5 + 0.5 * sin(5 * p.x + 4 * fbm2(p.xyz * 0.4))
    let sand = mix([0.36, 0.31, 0.23], [0.52, 0.45, 0.34], 0.75 * grain + 0.25 * ripple)
    ggx(sand, 0.9, 0)
  }
}

kind HermitShell @Shell (pose: xf@Shell>World, tint: rgb) {

  surface(u, v) grid 192x32 {
    shell_at(u, v)
  }

  material(p, n, uv) {
    let band = 0.5 + 0.5 * sin(12 * uv.x + 3 * sin(6.2831853 * uv.y))
    let mottle = fbm2(p.xyz * 7)
    let ridge = rib(uv.x, 6.2831853 * uv.y) * 20
    let base = mix([0.80, 0.62, 0.42], [0.42, 0.20, 0.09], band * 0.7 + 0.3 * mottle) * tint
    let grime = saturate(1 - ridge) * smoothstep(0.35, 0.75, mottle)
    let lip = smoothstep(0.93, 1, uv.x)
    ggx(mix(base, [0.12, 0.16, 0.10], grime * 0.6), 0.45 + 0.3 * grime, 0) +
      film(0.08 + 0.6 * lip, 1.42, 380) +
      coat(0.5 * (1 - grime), 0.12)
  }
}

kind CrabFace @Face (pose: xf@Face>World, aggro: f, gaze: p3@World, tint: rgb) {

  map sym(q) = q |> mirror_x |> move([-0.15, -0.72, -0.42])

  trace(q) {
    let shell = round_box(q - [0, 0.58, 0.12]@Face, [0.40, 0.18, 0.34], 0.15)
    let lip = capsule(q, [-0.22, 0.52, 0.44]@Face, [0.22, 0.52, 0.44]@Face, 0.09)

    let eye_c = sym.pt(0.03, 0.30, 0.07)
    let stalk = capsule(sym.p, sym.pt(0, 0, 0), eye_c, 0.045)
    let globe = sphere(sym.p - eye_c, 0.085)
    map brow = sym.p |> move(-[0, 0.40, 0.02]) |> rot_z(-0.35 * aggro)
    let plate = round_box(brow.p - brow.pt(0, 0, 0), [0.11, 0.025, 0.07], 0.02)
    let feeler = capsule(sym.p, sym.pt(-0.05, 0.02, 0.06), sym.pt(0.32, 0.55, 0.95), 0.016)
    let head = smin(shell, lip, 0.08)
    let eyes = smin(smin(stalk, globe, 0.03), plate, 0.02)
    min(smin(head, eyes, 0.05), feeler)
  }

  material(q, n) {

    let eye_c = sym.pt(0.03, 0.30, 0.07)

    let eye_w = pose * sym.out(eye_c)
    let look = sym.in(inv(pose) * normalize(gaze - eye_w))
    let r = distance(sym.p, eye_c)
    let in_eye = 1 - smoothstep(0.088, 0.095, r)
    let pupil = smoothstep(0.80, 0.90, dot(normalize(sym.p - eye_c), look)) * in_eye
    let shell = mix([0.55, 0.12, 0.05], [0.85, 0.42, 0.18], smoothstep(0.45, 0.8, q.y)) * tint
    let speck = fbm2(q.xyz * 11)
    let skin = shell * (0.75 + 0.5 * speck)
    let iris = mix([0.85, 0.62, 0.15], [0.01, 0.01, 0.012], pupil)
    ggx(mix(skin, iris, in_eye), mix(0.5, 0.2, in_eye), 0) +
      sss([0.9, 0.35, 0.15], 0.12 * (1 - in_eye)) +
      coat(0.35 + 0.65 * in_eye, 0.05)
  }
}

kind CrusherClaw @Claw (pose: xf@Claw>World, jaw_open: f, scale: f in 0.3..1.5, aggro: f, tint: rgb) {

  trace(p) {
    let o = [0, 0, 0]@Claw
    let s = scale
    let q = o + (p - o) / s
    let arm = capsule(q, [0, 0, -0.75]@Claw, [0, 0.02, -0.05]@Claw, 0.13)
    let palm = ssub(round_box(q - [0, 0, 0.32]@Claw, [0.30, 0.24, 0.42], 0.16),
                         box_sdf(q - [0, -0.34, 0.80]@Claw, [0.42, 0.16, 0.30]), 0.05)
    let fixed = capsule(q, [0, -0.10, 0.60]@Claw, [0, -0.06, 1.45]@Claw, 0.11)
    map jaw = q |> move(-[0, 0.10, 0.60]) |> rot_x(-jaw_open)
    let teeth = 0.025 * sin(14 * jaw.p.z) * smootherstep(0.1, 0.9, jaw.p.z)
    let dactyl = capsule(jaw.p, jaw.pt(0, 0, 0), jaw.pt(0, -0.05, 0.95), 0.1) - teeth
    s * smin(smin(smin(arm, palm, 0.08), fixed, 0.06), dactyl, 0.05)
  }

  material(p, n) {
    let q = (p - [0, 0, 0]@Claw) / scale
    let pit = fbm2(q.xyz * 9)
    let tip = smoothstep(1, 1.45, q.z)
    let base = mix([0.62, 0.11, 0.05], [0.08, 0.03, 0.02], tip) * tint * (0.8 + 0.4 * pit)
    let vein = smoothstep(0.70, 0.78, fbm2(q.xyz * 4)) * aggro * (1 - tip)
    ggx(base, 0.22 + 0.25 * pit, 0) +
      sss([0.9, 0.25, 0.08], 0.1) +
      emit_lobe([1, 0.32, 0.04] * vein * 0.8) +
      coat(0.85, 0.06)
  }
}

kind CrabLeg @Leg (pose: xf@Leg>World, j0: p3@Leg, j1: p3@Leg, j2: p3@Leg, j3: p3@Leg, tint: rgb) {

  visible(ro, rd) {
    let a = ray_capsule(ro, rd, j0, j1, 0.075)
    let b = ray_capsule(ro, rd, j1, j2, 0.065)
    let c = ray_capsule(ro, rd, j2, j3, 0.045)
    hit_min(hit_min(a, b), c)
  }
  trace(p) {
    let a = capsule(p, j0, j1, 0.075)
    let b = capsule(p, j1, j2, 0.065)
    let c = capsule(p, j2, j3, 0.045)
    min(min(a, b), c)
  }
  material(p, n) {
    let along = length(p - j0)
    let band = smoothstep(0.35, 0.65, 0.5 + 0.5 * sin(9 * along))
    let base = mix([0.62, 0.14, 0.05], [0.88, 0.55, 0.30], band * 0.5) * tint
    ggx(base, 0.35, 0) + sss([0.9, 0.3, 0.1], 0.08) + coat(0.7, 0.07)
  }
}

param count: u = 20

build fn leg(crab: xf@Body>World, j: u, side: f, tint: rgb) {
  let fj = f32(j)
  let femur = 0.40 + 0.07 * fj - 0.012 * fj * fj
  let tibia = 1.7 * femur
  let h = 0.42
  let spread = 0.85 - 0.34 * fj
  let yaw = select(-spread, 3.1415927 + spread, side < 0)
  let socket = place([0.30 * side, h, 0.30 - 0.12 * fj]@Body, yaw)
  let kx = 0.18 + femur * cos(0.6)
  let ky = 0.04 + femur * sin(0.6)
  let drop = ky + h
  let reach = sqrt(max(tibia * tibia - drop * drop, 0.01))
  emit CrabLeg(
    pose: crab * socket,
    j0: [0, 0, 0]@Leg,
    j1: [0.18, 0.04, 0]@Leg,
    j2: [kx, ky, 0]@Leg,
    j3: [kx + reach, -h, 0]@Leg,
    tint: tint,
 )
}

build fn crab(i: u) {
  let at = [grid_spot(i, count, 3.6)]@World
  let fi = f32(i)
  let body = place(at, 0.6 * sin(fi * 2.3))
  let tint = rgb(1) + 0.12 * (palette(i) - rgb(0.6))
  let aggro = 0.5 + 0.5 * sin(fi * 1.7)

  emit HermitShell(pose: body * place([0.36, 0.55, -0.55]@Body, 0), tint: tint)
  emit CrabFace(pose: body * place([0, 0, 0]@Body, 0), aggro: 0.6, gaze: [0, 2.2, 9]@World, tint: tint)
  emit CrusherClaw(pose: body * place([0.40, 0.36, 0.72]@Body, -0.2), jaw_open: 0.35, scale: 0.72, aggro: aggro, tint: tint)
  emit CrusherClaw(pose: body * place([-0.38, 0.40, 0.66]@Body, 0.3), jaw_open: 0.5, scale: 0.48, aggro: aggro, tint: tint)
  build for j in 0..6 {
    leg(body, j, 1, tint)
    leg(body, j, -1, tint)
  }
}

build {
  emit Ground(radius: 60)
  build for i in 0..count {
    crab(i)
  }
}

camera Main { at: [0, 0.45, 0]@World, radius: 2.6m + 2.4m * sqrt(f32(count)),
  height: 1.1m + 1m * sqrt(f32(count)), period: 24s, fov: 40deg }
