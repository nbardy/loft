space World Body Shell Face Claw Leg

const LEG_RADII = [0.075, 0.065, 0.045]
const SHELL_AXIS = [0, 0.9578, -0.2873]

fn wave(a: f) = 0.5 + 0.5 * sin(a)

fn spine(u: f) -> p3@Shell {
  let r = 0.42 * exp(2.6 * (u - 1))
  let a = 22 * u
  [[r * cos(a), 0, 0] + [0, -0.2873, -0.9578] * (r * sin(a)) + SHELL_AXIS * (1.5 * (0.42 - r))]@Shell
}

scan whorl u in 0..1 by 256 on bake_lut {
  init = frame(spine(u), dir(spine'(u)), dir([SHELL_AXIS]@Shell))
  step prev = transport(prev, spine(u), dir(spine'(u)))
}

fn rib(u: f, a: f) {
  let c = 0.5 + 0.5 * cos(28 * u)
  0.06 * c * c * c * c * (0.6 + 0.4 * cos(5 * a))
}

kind Ground @World (radius: f) {
  visible(ro, rd) = ray_ground(ro, rd, radius)
  trace(p) = box_sdf(p - [0, -0.05, 0]@World, [radius, 0.05, radius])
  material(p, n) {
    let ripple = wave(5 * p.x + 4 * fbm2(p.xyz * 0.4))
    ggx(mix([0.36, 0.31, 0.23], [0.52, 0.45, 0.34], 0.75 * fbm2(p.xyz * 6) + 0.25 * ripple), 0.9, 0)
  }
}

kind HermitShell @Shell (pose: xf@Shell>World, tint: rgb) {
  surface(u, v) grid 192x32 {
    let f = whorl(u)
    let a = TAU * v

    let r = 0.26 * exp(2.6 * (u - 1))
    let k = rib(u, a)
    f.o + f.n * (r * (1 + k) * cos(a)) + f.b * (r * (0.9 + k) * sin(a))
  }

  material(p, n, uv) {
    let band = wave(12 * uv.x + 3 * sin(TAU * uv.y))
    let mottle = fbm2(p.xyz * 7)
    let ridge = rib(uv.x, TAU * uv.y) * 20
    let base = mix([0.80, 0.62, 0.42], [0.42, 0.20, 0.09], band * 0.7 + 0.3 * mottle) * tint
    let grime = saturate(1 - ridge) * smoothstep(0.35, 0.75, mottle)
    let lip = smoothstep(0.93, 1, uv.x)
    ggx(mix(base, [0.12, 0.16, 0.10], grime * 0.6), 0.45 + 0.3 * grime, 0) +
      film(0.08 + 0.6 * lip, 1.42, 380) +
      coat(0.5 * (1 - grime), 0.12)
  }
}

kind CrabFace @Face (pose: xf@Face>World, aggro: f, gaze: p3@World, tint: rgb) {
  map sym(q) = q |> mirror_x |> move([-0.15, -0.72, -0.42])

  trace(q) {
    let shell = round_box(q - [0, 0.58, 0.12]@Face, [0.40, 0.18, 0.34], 0.15)
    let lip = capsule(q, [-0.22, 0.52, 0.44], [0.22, 0.52, 0.44], 0.09)

    let eye_c = sym.pt(0.03, 0.30, 0.07)
    let stalk = capsule(sym.p, sym.pt(0, 0, 0), eye_c, 0.045)
    let globe = sphere(sym.p - eye_c, 0.085)
    map brow = sym.p |> move(-[0, 0.40, 0.02]) |> rot_z(-0.35 * aggro)
    let plate = round_box(brow.p - brow.pt(0, 0, 0), [0.11, 0.025, 0.07], 0.02)
    let feeler = capsule(sym.p, sym.pt(-0.05, 0.02, 0.06), sym.pt(0.32, 0.55, 0.95), 0.016)
    let eyes = smin(smin(stalk, globe, 0.03), plate, 0.02)
    min(smin(smin(shell, lip, 0.08), eyes, 0.05), feeler)
  }

  material(q, n) {
    let eye_c = sym.pt(0.03, 0.30, 0.07)

    let look = sym.in(inv(pose) * dir(gaze - pose * sym.out(eye_c)))
    let in_eye = 1 - smoothstep(0.088, 0.095, dist(sym.p, eye_c))
    let pupil = smoothstep(0.80, 0.90, dot(normalize(sym.p - eye_c), look)) * in_eye
    let skin = mix([0.55, 0.12, 0.05], [0.85, 0.42, 0.18], smoothstep(0.45, 0.8, q.y)) * tint * (0.75 + 0.5 * fbm2(q.xyz * 11))
    let iris = mix([0.85, 0.62, 0.15], [0.01, 0.01, 0.012], pupil)
    ggx(mix(skin, iris, in_eye), mix(0.5, 0.2, in_eye), 0) +
      sss([0.9, 0.35, 0.15], 0.12 * (1 - in_eye)) +
      coat(0.35 + 0.65 * in_eye, 0.05)
  }
}

kind CrusherClaw @Claw (pose: xf@Claw>World, jaw_open: f, scale: f in 0.3..1.5, aggro: f, tint: rgb) {
  trace(p) {
    let q = [p.xyz / scale]@Claw
    let arm = capsule(q, [0, 0, -0.75], [0, 0.02, -0.05], 0.13)
    let palm = ssub(round_box(q - [0, 0, 0.32]@Claw, [0.30, 0.24, 0.42], 0.16),
                         box_sdf(q - [0, -0.34, 0.80]@Claw, [0.42, 0.16, 0.30]), 0.05)
    let fixed = capsule(q, [0, -0.10, 0.60], [0, -0.06, 1.45], 0.11)
    map jaw = q |> move(-[0, 0.10, 0.60]) |> rot_x(-jaw_open)
    let teeth = 0.025 * sin(14 * jaw.p.z) * smootherstep(0.1, 0.9, jaw.p.z)
    let dactyl = capsule(jaw.p, jaw.pt(0, 0, 0), jaw.pt(0, -0.05, 0.95), 0.1) - teeth
    scale * smin(smin(smin(arm, palm, 0.08), fixed, 0.06), dactyl, 0.05)
  }

  material(p, n) {
    let q = p.xyz / scale
    let pit = fbm2(q * 9)
    let tip = smoothstep(1, 1.45, q.z)
    let base = mix([0.62, 0.11, 0.05], [0.08, 0.03, 0.02], tip) * tint * (0.8 + 0.4 * pit)
    let vein = smoothstep(0.70, 0.78, fbm2(q * 4)) * aggro * (1 - tip)
    ggx(base, 0.22 + 0.25 * pit, 0) +
      sss([0.9, 0.25, 0.08], 0.1) +
      emit_lobe([1, 0.32, 0.04] * vein * 0.8) +
      coat(0.85, 0.06)
  }
}

kind CrabLeg @Leg (pose: xf@Leg>World, j0: p3@Leg = [0, 0, 0]@Leg, j1: p3@Leg = [0.18, 0.04, 0]@Leg, j2: p3@Leg, j3: p3@Leg, tint: rgb) {
  visible(ro, rd) = ray_capsule_chain(ro, rd, j0, j1, j2, j3, LEG_RADII)
  trace(p) = capsule_chain(p, j0, j1, j2, j3, LEG_RADII)
  material(p, n) {
    let band = smoothstep(0.35, 0.65, wave(9 * dist(p, j0)))
    let base = mix([0.62, 0.14, 0.05], [0.88, 0.55, 0.30], band * 0.5) * tint
    ggx(base, 0.35, 0) + sss([0.9, 0.3, 0.1], 0.08) + coat(0.7, 0.07)
  }
}

param count: u = 20

build fn leg(crab: xf@Body>World, j: f, side: f, tint: rgb) {
  let femur = 0.40 + 0.07 * j - 0.012 * j * j
  let tibia = 1.7 * femur
  let spread = 0.85 - 0.34 * j
  let socket = place([0.30 * side, 0.42, 0.30 - 0.12 * j]@Body, select(-spread, 3.1415927 + spread, side < 0))
  let kx = 0.18 + femur * cos(0.6)
  let ky = 0.04 + femur * sin(0.6)
  let drop = ky + 0.42
  let reach = sqrt(max(tibia * tibia - drop * drop, 0.01))
  emit CrabLeg(
    pose: crab * socket,
    j2: [kx, ky, 0],
    j3: [kx + reach, -0.42, 0],
    tint: tint,
 )
}

build fn crab(i: u) {
  let body = place([grid_spot(i, count, 3.6)]@World, 0.6 * sin(f32(i) * 2.3))
  let tint = rgb(1) + 0.12 * (palette(i) - rgb(0.6))
  let aggro = wave(f32(i) * 1.7)

  emit HermitShell(pose: body * place([0.36, 0.55, -0.55]@Body), tint: tint)
  emit CrabFace(pose: body * place([0]@Body), aggro: 0.6, gaze: [0, 2.2, 9]@World, tint: tint)
  emit CrusherClaw(pose: body * place([0.40, 0.36, 0.72]@Body, -0.2), jaw_open: 0.35, scale: 0.72, aggro: aggro, tint: tint)
  emit CrusherClaw(pose: body * place([-0.38, 0.40, 0.66]@Body, 0.3), jaw_open: 0.5, scale: 0.48, aggro: aggro, tint: tint)
  build for j in 0..6 {
    build for side in [1, -1] { leg(body, f32(j), side, tint) }
  }
}

build {
  emit Ground(radius: 60)
  build for i in 0..count { crab(i) }
}

camera Main { at: [0, 0.45, 0]@World, radius: 2.6m + 2.4m * sqrt(f32(count)),
  height: 1.1m + 1m * sqrt(f32(count)), period: 24s, fov: 40deg }
