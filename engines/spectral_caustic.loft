# Each sample traces four stratified heroes independently at dispersive
# interfaces. Sharing a refracted direction would bias the other wavelengths.
lobe spectral_dielectric(ior: f, dispersion: f, absorption: rgb, n: rgb, v: rgb, l: rgb) {
  v4(0.0, 0.0, 0.0, 1.0)
}

struct CausticBin { flux: u }
kernel deposit_caustic(bins: [CausticBin], bin: u, flux: u) allow(atomics) {
  atomic_add(bins[bin].flux, flux)
}

fn spectral_ior(base: f, dispersion: f, nm: f) -> f =
  base + dispersion / (nm * nm * 0.000001)

fn spectral_band(color: rgb, nm: f) -> f {
  let violet_green = mix(color.z, color.y, smoothstep(435.0, 545.0, nm))
  mix(violet_green, color.x, smoothstep(545.0, 620.0, nm))
}

fn spectral_xyz(nm: f) -> v3 =
  wgsl(nm: f) -> v3 {
    // Asymmetric Gaussian fits to the CIE 1931 2-degree matching functions.
    let tx = (nm-442.0)*select(0.0374,0.0624,nm<442.0);
    let ux = (nm-599.8)*select(0.0323,0.0264,nm<599.8);
    let vx = (nm-501.1)*select(0.0382,0.0490,nm<501.1);
    let ty = (nm-568.8)*select(0.0247,0.0213,nm<568.8);
    let uy = (nm-530.9)*select(0.0322,0.0613,nm<530.9);
    let tz = (nm-437.0)*select(0.0278,0.0845,nm<437.0);
    let uz = (nm-459.0)*select(0.0725,0.0385,nm<459.0);
    return vec3<f32>(
      0.362*exp(-0.5*tx*tx)+1.056*exp(-0.5*ux*ux)-0.065*exp(-0.5*vx*vx),
      0.821*exp(-0.5*ty*ty)+0.286*exp(-0.5*uy*uy),
      1.217*exp(-0.5*tz*tz)+0.681*exp(-0.5*uz*uz));
  }

fn spectral_transition(d: v3, n: v3, eta: f, xi: f) -> v4 =
  wgsl(d: v3, n: v3, eta: f, xi: f) -> v4 {
    let ci = clamp(-dot(d,n),0.0,1.0);
    let st2 = eta*eta*(1.0-ci*ci);
    if st2 >= 1.0 { return vec4<f32>(reflect(d,n),0.0); }
    let ct = sqrt(1.0-st2);
    let rs = (eta*ci-ct)/(eta*ci+ct);
    let rp = (ci-eta*ct)/(ci+eta*ct);
    if xi < 0.5*(rs*rs+rp*rp) { return vec4<f32>(reflect(d,n),0.0); }
    return vec4<f32>(refract(d,n,eta),1.0);
  }

fn spectral_path(origin: v3, direction: v3, seed: u, bounces: u, nm: f, lane: u) -> f =
  wgsl(origin: v3, direction: v3, seed: u, bounces: u, nm: f, lane: u) -> f {
    var stack = medium_air();
    var ray = PathRay(origin,direction);
    var throughput = 1.0;
    var radiance = 0.0;
    for (var bounce=0u; bounce<=bounces; bounce++) {
      let h = world_trace(ray.o,ray.d,1e6);
      if h.t<0.0 {
        radiance += throughput*loft_user_spectral_band(loft_user_sky_dome(ray.d),nm);
        break;
      }
      throughput *= exp(-h.t*stack.absorb[stack.top]);
      let optical = world_optics(h);
      if optical.base>0.0 {
        let bend = medium_interface(stack,h,ray.d,optical,nm,path_random(seed,bounce*16u));
        if !bend.valid { break; }
        if bend.through { throughput *= bend.eta*bend.eta; }
        ray = bend.ray;
        stack = bend.stack;
      } else {
        let wo = -ray.d;
        let direct = world_direct(h,wo,seed,bounce);
        let glow = world_eval(h,wo,vec3<f32>(0.0));
        radiance += throughput * (loft_user_spectral_band(direct+glow,nm) + caustic_gather(h,wo,nm,lane));
        if bounce==bounces { break; }
        let xi = vec2<f32>(path_random(seed,bounce*16u),path_random(seed,bounce*16u+1u));
        ray.d = path_cosine(h.n,xi);
        let pdf = max(dot(h.n,ray.d),0.0)*0.318309886;
        if pdf<=0.0 { break; }
        throughput *= loft_user_spectral_band(world_eval(h,wo,ray.d),nm)/pdf;
        ray.o = h.p+h.n*0.0002;
      }
      if throughput<=0.0 { break; }
    }
    return radiance;
  }

fn spectral_sample(origin: v3, direction: v3, seed: u, bounces: u) -> rgb =
  wgsl(origin: v3, direction: v3, seed: u, bounces: u) -> rgb {
    var lambda: vec4<f32>;
    var radiance: vec4<f32>;
    let hero = path_random(seed,0xff7f003du);
    for (var lane=0u; lane<4u; lane++) {
      lambda[lane] = 380.0+400.0*(hero+f32(lane))*0.25;
      radiance[lane] = loft_user_spectral_path(origin,direction,path_hash(seed+lane),bounces,lambda[lane],lane);
    }
    var xyz = vec3<f32>(0.0);
    for (var lane=0u; lane<4u; lane++) {
      xyz += radiance[lane]*loft_user_spectral_xyz(lambda[lane])*(100.0/106.8569);
    }
    return max(vec3<f32>(dot(xyz,vec3<f32>(3.2406,-1.5372,-0.4986)),
      dot(xyz,vec3<f32>(-0.9689,1.8758,0.0415)),
      dot(xyz,vec3<f32>(0.0557,-0.2040,1.0570))),vec3<f32>(0.0));
  }

schedule SpectralCaustic {
  type Radiance = v4
  orbit(at: [0, 0, 0], radius: 4, height: 0.5, period: 24, fov: 40deg)
  cull_indirect(Drawables)
  render_bundle(Vis64) { draw_indirect(Drawables) }
  tile_classify(Vis64, tile: 8)
  shade_tiles(Vis64, light: sun_sky, sun: [0.5, 0.75, 0.35])
  screen_pass(spectral_sample, bounces: 16)
  tonemap_aces(ColorHdr, sky: sky_color)
}
